      (cons 'position (list (cons 'index *EL:PanelIndex*) (cons 'page *EL:PanelPage*)
        (cons 'device *EL:PanelDevice*) (cons 'thumb *EL:ThumbPage*)))
      (cons 'generate (or (equal *EL:PanelAction* 'generate) (= status 2)))))))))

