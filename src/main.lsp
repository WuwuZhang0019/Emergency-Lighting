(defun EL:ClearGapPreview (/ id)
  (foreach id *EL:Highlight* (if (handent id) (redraw (handent id) 4)))
  (setq *EL:Highlight* nil) (redraw) (grtext -1 ""))
(defun EL:DrawTransient (a b color) (grdraw (trans a 0 1) (trans b 0 1) color 1))
(defun EL:MarkEnd (end label color / p tdir size x y)
  (setq p (EL:Get 'point end) size (/ (getvar "VIEWSIZE") 60.0) tdir (EL:Get 'direction end))
  (EL:DrawTransient (EL:V+ p (list (- size) 0.0 0.0)) (EL:V+ p (list size 0.0 0.0)) color)
  (EL:DrawTransient (EL:V+ p (list 0.0 (- size) 0.0)) (EL:V+ p (list 0.0 size 0.0)) color)
  ;; A/B vector glyphs; no TEXT entities are created.
  (if (= label "A")
    (progn
      (EL:DrawTransient (EL:V+ p (list size size 0.0)) (EL:V+ p (list (* 1.5 size) (* 2.0 size) 0.0)) color)
      (EL:DrawTransient (EL:V+ p (list (* 1.5 size) (* 2.0 size) 0.0)) (EL:V+ p (list (* 2.0 size) size 0.0)) color)
      (EL:DrawTransient (EL:V+ p (list (* 1.25 size) (* 1.5 size) 0.0)) (EL:V+ p (list (* 1.75 size) (* 1.5 size) 0.0)) color))
    (progn
      (EL:DrawTransient (EL:V+ p (list size size 0.0)) (EL:V+ p (list size (* 2.0 size) 0.0)) color)
      (EL:DrawTransient (EL:V+ p (list size (* 2.0 size) 0.0)) (EL:V+ p (list (* 2.0 size) (* 1.75 size) 0.0)) color)
      (EL:DrawTransient (EL:V+ p (list (* 2.0 size) (* 1.75 size) 0.0)) (EL:V+ p (list size (* 1.5 size) 0.0)) color)
      (EL:DrawTransient (EL:V+ p (list size (* 1.5 size) 0.0)) (EL:V+ p (list (* 2.0 size) (* 1.25 size) 0.0)) color)
      (EL:DrawTransient (EL:V+ p (list (* 2.0 size) (* 1.25 size) 0.0)) (EL:V+ p (list size size 0.0)) color)))
  (if tdir
    (progn
      (setq x (EL:V+ p (EL:V* (* 4.0 size) tdir)))
      (EL:DrawTransient p x color)
      (EL:DrawTransient x (EL:V+ p (EL:V* (* 3.0 size) (list (- (car tdir) (* 0.2 (cadr tdir)))
           (+ (cadr tdir) (* 0.2 (car tdir))) 0.0))) color))))
(defun EL:ShowGapPreview (a row rows snapshot / target other color candidate rec wire seg p q i)
  (EL:ClearGapPreview)
  (setq *EL:Highlight* (list (EL:Get 'wire a)) color 1)
  (if (handent (EL:Get 'wire a)) (redraw (handent (EL:Get 'wire a)) 3))
  (setq wire (EL:By 'id (EL:Get 'wire a) (EL:Get 'wires snapshot)))
  (foreach seg (EL:Get 'segments wire) (EL:DrawTransient (car seg) (cadr seg) 4))
  (if (= (length (EL:Get 'candidates row)) 1)
    (progn
      (setq target (EL:Get 'target (car (EL:Get 'candidates row))) other (EL:By 'key target rows))
      (if (and (= (length (EL:Get 'candidates other)) 1)
               (equal (EL:Get 'target (car (EL:Get 'candidates other))) (EL:Get 'key a))) (setq color 3) (setq color 2))))
  (if (> (length (EL:Get 'candidates row)) 1) (setq color 2))
  (EL:MarkEnd a "A" (if (or (EL:Get 'occupied a) (= color 1)) 1 4))
  (foreach rec (EL:Get 'candidates row)
    (setq candidate (EL:By 'key (EL:Get 'target rec) (EL:Get 'ends snapshot)))
    (if (handent (EL:Get 'wire candidate)) (redraw (handent (EL:Get 'wire candidate)) 3))
    (setq *EL:Highlight* (EL:Unique (cons (EL:Get 'wire candidate) *EL:Highlight*)))
    (foreach seg (EL:Get 'segments (EL:By 'id (EL:Get 'wire candidate) (EL:Get 'wires snapshot)))
      (EL:DrawTransient (car seg) (cadr seg) color))
    (EL:MarkEnd candidate "B" color)
    (setq p (EL:Get 'point a) q (EL:Get 'point candidate) i 0)
    (repeat 10
      (EL:DrawTransient (EL:V+ p (EL:V* (/ i 10.0) (EL:V- q p)))
        (EL:V+ p (EL:V* (/ (+ i 0.5) 10.0) (EL:V- q p))) color)
      (setq i (1+ i)))
    (if (= color 2)
      (foreach other (EL:Get 'candidates (EL:By 'key (EL:Get 'target rec) rows))
        (setq candidate (EL:By 'key (EL:Get 'target other) (EL:Get 'ends snapshot)))
        (if (handent (EL:Get 'wire candidate)) (redraw (handent (EL:Get 'wire candidate)) 3))
        (setq *EL:Highlight* (EL:Unique (cons (EL:Get 'wire candidate) *EL:Highlight*)))
        (EL:MarkEnd candidate "B" 2))))
  (cond ((EL:Get 'occupied a) (princ "\n该端已连接或存在接触疑义，不能作为自由断口。"))
        ((/= (EL:Get 'geometry a) 'straight) (princ (strcat "\n端部状态：" (vl-symbol-name (EL:Get 'geometry a)))))
        ((= color 3) (princ (strcat "\n找到一对双向几何匹配；断口长度 "
          (rtos (EL:Get 'distance (car (EL:Get 'candidates row))) 2 3) " 个绘图单位。")))
        ((= color 2) (princ "\n存在多候选或反向不唯一，黄色标记包括竞争端点。"))
        (T (princ "\n搜索上限内无合格候选；详情可查看拒绝原因。")))
  (princ "\n单断口预览；整箱回路归属未核对，不保存连接。"))
(defun EL:PickEndpoint (snapshot prompt / pick id choices a b point)
  (if (setq pick (entsel prompt))
    (progn
      (setq id (cdr (assoc 5 (entget (car pick))))
            choices (vl-remove-if-not '(lambda (x) (equal (EL:Get 'wire x) id)) (EL:Get 'ends snapshot)))
      (if (= (length choices) 2)
        (progn
          (setq point (trans (cadr pick) 1 0) a (car choices) b (cadr choices))
          (if (< (abs (- (EL:Norm (EL:V- point (EL:Get 'point a)))
                         (EL:Norm (EL:V- point (EL:Get 'point b))))) (EL:Get 'eps_touch *EL:PickParams*))
            (if (setq point (getpoint "\n两端距离相近，请明确点选端点: ")) (setq point (trans point 1 0))))
          (if point (if (< (EL:Norm (EL:V- point (EL:Get 'point a))) (EL:Norm (EL:V- point (EL:Get 'point b)))) a b)))
        (princ "\n所选对象没有两个可检查的开放端点。")))))
(defun c:ELGAPTEST (/ *error* cfg pick layer snapshot physical rows a action params ctr size zoomed app row globalpreview)
  (defun *error* (msg)
    (EL:ClearGapPreview)
    (if zoomed (vl-catch-all-apply 'vla-ZoomCenter (list app (vlax-3d-point ctr) size)))
    (if msg (princ (strcat "\n预览已清理：" msg))) (princ))
  (setq cfg (EL:LoadConfig) app (vlax-get-acad-object) size (getvar "VIEWSIZE")
        ctr (trans (EL:Point3 (getvar "VIEWCTR")) 2 0))
  (if (not cfg) (setq cfg (EL:DefaultConfig (EL:DrawingID))))
  (if (not (EL:Get 'wire-layers cfg))
    (if (setq pick (entsel "\n选择临时导线层样本（不保存）: "))
      (setq cfg (EL:Put 'wire-layers (list (cdr (assoc 8 (entget (car pick))))) cfg))))
  (if (not (EL:Get 'params cfg)) (setq cfg (EL:Put 'params (EL:InputParams) cfg)))
  (if (and (EL:Get 'wire-layers cfg) (EL:ParamsValid (EL:Get 'params cfg)))
    (progn
      (if (not (and (EL:Get 'device-layers cfg) (EL:Get 'panel-layers cfg)))
        (princ "\n仅几何试查，设备阻挡与角色排除未核对。"))
      (setq action "Next")
      (while action
        (if (member action '("Next" "Params"))
          (progn
            (EL:ClearGapPreview)
            (if (= action "Params")
              (if (setq params (EL:InputParams)) (setq cfg (EL:Put 'params params cfg))))
            (setq snapshot (EL:CollectEndpointSnapshot cfg) physical (EL:BuildPhysical snapshot cfg nil)
                  snapshot (EL:Get 'snapshot physical) rows (EL:FindGapCandidates snapshot cfg)
                  *EL:PickParams* (EL:Get 'params cfg)
                  a (EL:PickEndpoint snapshot "\n选择打断导线的一段，靠近断口点击: "))))
        (if a
          (progn
            (setq row (EL:By 'key (EL:Get 'key a) rows)) (EL:ShowGapPreview a row rows snapshot)
            (if (and *EL:Result* (EL:SourceCurrent *EL:Result* cfg snapshot))
              (progn
                (setq globalpreview (EL:AnalyzeSnapshot snapshot cfg (EL:Get 'panel *EL:Result*)
                  (mapcar '(lambda (c) (EL:Get 'seed c)) (EL:Get 'circuits *EL:Result*))))
                (princ (strcat "\n沿用现有箱体上下文的全局检查：" (if (EL:Get 'complete globalpreview) "识别完整" "存在未解决问题")
                  "；仍只显示预览，不提交本次结果。"))))
            (initget "Next Swap Params Locate Details Exit")
            (setq action (getkword "\n[Next下一处/Swap换端点/Params参数/Locate定位/Details详情/Exit退出] <Exit>: "))
            (cond ((= action "Swap")
                   (setq a (EL:By 'key (list (EL:Get 'wire a) (if (= (EL:Get 'side a) 'start) 'end 'start)) (EL:Get 'ends snapshot))))
                  ((= action "Details") (princ (strcat "\n" (vl-prin1-to-string row) "\n参数：" (vl-prin1-to-string (EL:Get 'params cfg)))))
                  ((= action "Locate")
                   (setq zoomed T)
                   (vla-ZoomCenter app (vlax-3d-point (EL:Get 'point a)) (* 2.5 (EL:Get 'Dmax (EL:Get 'params cfg)))))
                  ((= action "Exit") (setq action nil))))
          (setq action nil)))))
  (EL:ClearGapPreview)
  (if zoomed (vla-ZoomCenter app (vlax-3d-point ctr) size))
  (princ))
(defun EL:CurrentContext (cfg panel / snapshot physical seeds)
  (setq snapshot (EL:CollectEndpointSnapshot cfg) physical (EL:BuildPhysical snapshot cfg panel)
        snapshot (EL:Get 'snapshot physical) seeds (EL:SeedCandidates snapshot cfg panel))
  (list snapshot seeds))
(defun EL:LocateID (id / e)
  (if (setq e (handent id)) (progn (redraw e 3) (princ (strcat "\n已高亮句柄 " id "；重新识别或 REDRAW 清理。")))))
(defun c:ELTRACE (/ *error* cfg panel pick context seeds selected seed answer result current circuit)
  (defun *error* (msg) (EL:ClearGapPreview) (setq *EL:Result* nil) (if msg (princ (strcat "\n识别取消：" msg))) (princ))
  (setq *EL:Result* nil)
  (if (and (setq cfg (EL:LoadConfig)) (EL:Get 'calibrated cfg) (EL:ParamsValid (EL:Get 'params cfg)) (EL:RolesReady cfg))
    (if (setq pick (entsel "\n拾取待统计配电箱: "))
      (if (and (= (cdr (assoc 0 (entget (car pick)))) "INSERT") (= (cdr (assoc 410 (entget (car pick)))) "Model")
               (= (EL:Role (cdr (assoc 8 (entget (car pick)))) (EL:EffectiveName (car pick)) cfg) 'panel))
        (progn
          (setq panel (cdr (assoc 5 (entget (car pick)))) context (EL:CurrentContext cfg panel) seeds (cadr context))
          (if (EL:Get 'issues (EL:By 'id panel (EL:Get 'blocks (car context))))
            (princ "\n箱体轮廓存在未支持项，不能确认出线。")
            (progn
              (foreach seed seeds
                (EL:LocateID (EL:Get 'wire seed)) (initget "Yes No")
                (setq answer (getkword (strcat "\n" (EL:Get 'id seed) " 是否为独立出线？[Yes/No] <Yes>（进线选 No）: ")))
                (if (/= answer "No") (setq selected (cons seed selected)))
                (redraw (handent (EL:Get 'wire seed)) 4))
              (setq result (EL:AnalyzeSnapshot (car context) cfg panel (reverse selected))
                    current (EL:CollectEndpointSnapshot cfg))
              (if (equal (EL:Get 'signature current) (EL:Get 'signature (car context)))
                (progn
                  (setq *EL:Result* result)
                  (foreach circuit (EL:Get 'circuits result)
                    (princ (strcat "\n" (EL:Get 'id circuit) "：设备 " (itoa (length (EL:Get 'devices circuit)))
                      "，识别" (if (EL:Get 'complete circuit) "完整" "有未解决问题")))
                    (foreach answer (EL:Get 'issues circuit) (princ (strcat "\n  " (vl-prin1-to-string answer)))))
                  (if (EL:Get 'unrelated-issues result)
                    (princ (strcat "\n处理范围内另有 " (itoa (length (EL:Get 'unrelated-issues result)))
                      " 项独立问题，可用 ELISSUES 查看定位。")))
                  (if (not selected) (princ "\n未确认出线，不能生成系统图。")))
                (princ "\nSOURCE_CHANGED：源图已变化，请重新识别。")))))
        (princ "\n对象不属于已配置的配电箱角色。")))
    (princ "\n先运行 ELSETUP，完成图层及参数校准。")) (princ))
(defun EL:ResolveGapManually (cfg / context snapshot seeds physical a b metrics exception pair result checked panel pick)
  (if (setq pick (entsel "\n拾取该断口所属箱体（用于全局核对）: "))
    (if (and (= (cdr (assoc 0 (entget (car pick)))) "INSERT") (= (cdr (assoc 410 (entget (car pick)))) "Model")
             (= (EL:Role (cdr (assoc 8 (entget (car pick)))) (EL:EffectiveName (car pick)) cfg) 'panel))
      (progn
      (setq panel (cdr (assoc 5 (entget (car pick)))) context (EL:CurrentContext cfg panel)
            snapshot (car context) seeds (cadr context) *EL:PickParams* (EL:Get 'params cfg)
            a (EL:PickEndpoint snapshot "\n点选第一个具体断口端点: "))
      (if a (setq b (EL:PickEndpoint snapshot "\n点选另一具体断口端点: ")))
      (if (and seeds a b (not (EL:Get 'occupied a)) (not (EL:Get 'occupied b)))
        (progn
          (setq metrics (EL:ValidateGapPair a b snapshot cfg))
          (princ (strcat "\n几何判据：" (vl-prin1-to-string metrics)))
          (setq exception (getstring T "\n人工确认原因（不能为空；超距或非共线需说明）: "))
          (initget "Yes No")
          (if (and (/= exception "") (= (getkword "\n确认这两个具体端点的原接线？[Yes/No] <No>: ") "Yes"))
            (progn
              (setq pair (list (cons 'a (EL:Get 'key a)) (cons 'b (EL:Get 'key b)) (cons 'source 'manual)
                (cons 'signature (EL:Get 'signature snapshot)) (cons 'params (EL:Get 'params cfg))
                (cons 'drawing (EL:Get 'drawing cfg)) (cons 'date (getvar "CDATE")) (cons 'exception exception)
                (cons 'a-state (EL:Signature a)) (cons 'b-state (EL:Signature b))))
              (setq cfg (EL:Put 'gap-pairs (cons pair (EL:Get 'gap-pairs cfg)) cfg)
                    result (EL:AnalyzeSnapshot snapshot cfg panel seeds))
              (if (and (member pair (EL:Get 'connections result))
                       (equal (EL:Get 'signature snapshot) (EL:Get 'signature (EL:CollectEndpointSnapshot cfg))))
                (EL:SaveConfig cfg) (princ "\n端点占用、回路归属或源图校验未通过；配对未保存。")))))))
      (princ "\n请选择已配置的模型空间配电箱。"))))
(defun c:ELPAIRGAP (/ cfg)
  (if (and (setq cfg (EL:LoadConfig)) (EL:ParamsValid (EL:Get 'params cfg))) (EL:ResolveGapManually cfg)) (princ))
(defun c:ELPAIRLEADER (/ cfg a b ea eb snapshot ra rb pair context result)
  (if (and (setq cfg (EL:LoadConfig)) (EL:ParamsValid (EL:Get 'params cfg)))
    (progn
      (setq a (entsel "\n拾取第一个引线图块: "))
      (if a (setq b (entsel "\n拾取配对楼层的引线图块: ")))
      (if (and a b (not (equal (car a) (car b)))
               (= (cdr (assoc 0 (entget (car a)))) "INSERT") (= (cdr (assoc 0 (entget (car b)))) "INSERT"))
        (progn
          (foreach ea (list (car a) (car b))
            (setq cfg (EL:Put 'leader-layers (EL:Unique (cons (cdr (assoc 8 (entget ea))) (EL:Get 'leader-layers cfg))) cfg)
                  cfg (EL:Put 'leader-names (EL:Unique (cons (EL:EffectiveName ea) (EL:Get 'leader-names cfg))) cfg)))
          (setq snapshot (EL:CollectEndpointSnapshot cfg)
                ra (EL:By 'id (cdr (assoc 5 (entget (car a)))) (EL:Get 'blocks snapshot))
                rb (EL:By 'id (cdr (assoc 5 (entget (car b)))) (EL:Get 'blocks snapshot)))
          (if (vl-some '(lambda (p) (or (member (EL:Get 'a p) (list (EL:Get 'id ra) (EL:Get 'id rb)))
                      (member (EL:Get 'b p) (list (EL:Get 'id ra) (EL:Get 'id rb))))) (EL:Get 'leader-pairs cfg))
            (princ "\n至少一个引线已有配对；先用 ELCLEARPAIRS 清理失效关系。")
            (progn
              (setq pair (list (cons 'a (EL:Get 'id ra)) (cons 'b (EL:Get 'id rb))
                    (cons 'a-state (EL:Get 'raw ra)) (cons 'b-state (EL:Get 'raw rb))
                    (cons 'drawing (EL:Get 'drawing cfg)) (cons 'date (getvar "CDATE"))))
              (initget "Yes No")
              (if (= (getkword "\n确认该对引线？[Yes/No] <No>: ") "Yes")
                (EL:SaveConfig (EL:Put 'leader-pairs (cons pair (EL:Get 'leader-pairs cfg)) cfg))))))))) (princ))
(defun c:ELCLEARPAIRS (/ cfg kind)
  (if (setq cfg (EL:LoadConfig))
    (progn
      (initget "Gap Leader") (setq kind (getkword "\n清理本图配对类型 [Gap/Leader]: "))
      (if kind (EL:SaveConfig (EL:Put (if (= kind "Gap") 'gap-pairs 'leader-pairs) nil cfg))))) (princ))
(defun EL:PowerUISelect (index / row record category)
  (setq *EL:PowerIndex* index row (nth index *EL:PowerRows*)
        record (EL:ResolvePower (EL:Get 'identity row) *EL:PowerEdits* (EL:Get 'powers *EL:PowerCfg*) *EL:PowerLibrary*)
        category (EL:Get 'category record))
  (set_tile "category" (cond ((= category 'lighting) "1") ((= category 'sign) "2") ((= category 'exit) "3") ((= category 'other) "4") (T "0")))
  (set_tile "display" (cond ((EL:Get 'display record)) ((EL:Get 'name row)) (T "")))
  (set_tile "watts" (if (EL:Get 'watts record) (itoa (EL:Get 'watts record)) ""))
  (set_tile "zero" (if (EL:Get 'zero-confirmed record) "1" "0"))
  (set_tile "source" (strcat "动态状态：" (vl-prin1-to-string (cadr (EL:Get 'identity row)))
    "  值来源：" (cond ((not record) "未配置；请确认类别") ((= (EL:Get 'source record) 'current-input) "本次输入")
      ((= (EL:Get 'source record) 'drawing-saved) "本图保存") (T "项目设备库"))))
  (if (and (not record) (vl-some '(lambda (r) (equal (car (EL:Get 'identity r)) (EL:Get 'name row)))
           (append (EL:Get 'powers *EL:PowerCfg*) *EL:PowerLibrary*)))
    (set_tile "source" "存在同名但定义／动态状态不同的配置，须重新核对类别及功率。"))
  (set_tile "error" ""))
(defun EL:PowerUICategory (value / category watts)
  (setq category (nth (atoi value) '(nil lighting sign exit other)) watts (EL:DefaultWatts category))
  (if (and watts (= (get_tile "watts") "")) (set_tile "watts" (itoa watts))))
(defun EL:PowerUISave (/ row record old w)
  (setq row (nth *EL:PowerIndex* *EL:PowerRows*) w (EL:ParseWatts (get_tile "watts"))
        record (list (cons 'identity (EL:Get 'identity row))
          (cons 'category (nth (atoi (get_tile "category")) '(nil lighting sign exit other)))
          (cons 'display (get_tile "display")) (cons 'watts w)
          (cons 'zero-confirmed (= (get_tile "zero") "1")) (cons 'source 'current-input)))
  (if (EL:PowerValid record)
    (progn
      (setq old (EL:By 'identity (EL:Get 'identity row) *EL:PowerEdits*))
      (setq *EL:PowerEdits* (if old (subst record old *EL:PowerEdits*) (cons record *EL:PowerEdits*)))
      (set_tile "error" "本行已保存到本次编辑；点击应用后持久化。"))
    (set_tile "error" "请选择类别、填写名称和非负整数功率；0W 必须勾选用途确认。")))
(defun EL:ReleasePowerUI ()
  (if (and *EL:DialogID* (> *EL:DialogID* 0)) (unload_dialog *EL:DialogID*))
  (setq *EL:DialogID* nil *EL:PowerRows* nil *EL:PowerEdits* nil *EL:PowerIndex* nil
        *EL:PowerCfg* nil *EL:PowerLibrary* nil))
(defun EL:PowerDialog (result cfg library / dialog status row old edits)
  (setq *EL:PowerRows* (EL:PowerTableRows result) *EL:PowerEdits* nil *EL:PowerIndex* 0
        *EL:PowerCfg* cfg *EL:PowerLibrary* library dialog (load_dialog (strcat *EL:Root* "ui/power.dcl")) *EL:DialogID* dialog)
  (if (and (> dialog 0) *EL:PowerRows*)
    (progn
      (setq status 2)
      (while (= status 2)
        (if (new_dialog "el_power" dialog)
          (progn
            (start_list "rows")
            (foreach row *EL:PowerRows* (add_list (strcat (EL:Get 'name row) " / " (itoa (EL:Get 'count row))
              " / " (vl-prin1-to-string (EL:Get 'circuits row))))) (end_list)
            (start_list "category") (foreach row '("请选择类别" "应急照明灯（默认5W）" "疏散标志（默认1W）" "安全出口（默认1W）" "其他（手填）") (add_list row)) (end_list)
            (set_tile "rows" (itoa *EL:PowerIndex*)) (EL:PowerUISelect *EL:PowerIndex*)
            (action_tile "rows" "(EL:PowerUISelect (atoi $value))")
            (action_tile "category" "(EL:PowerUICategory $value)")
            (action_tile "save_row" "(EL:PowerUISave)")
            (action_tile "locate" "(done_dialog 2)")
            (action_tile "accept" "(done_dialog 1)") (action_tile "cancel" "(done_dialog 0)")
            (setq status (start_dialog))
            (if (= status 2)
              (progn
                (setq row (nth *EL:PowerIndex* *EL:PowerRows*))
                (EL:LocateID (car (EL:Get 'ids row)))
                (getstring "\n按 Enter 返回功率表: ")
                (if (handent (car (EL:Get 'ids row))) (redraw (handent (car (EL:Get 'ids row))) 4)))))
          (setq status 0)))
      (unload_dialog dialog) (setq *EL:DialogID* nil)
      (if (= status 1)
        (progn
          (setq edits (EL:Get 'powers cfg))
          (foreach row *EL:PowerEdits*
            (setq old (EL:By 'identity (EL:Get 'identity row) edits)
                  edits (if old (subst row old edits) (cons row edits))))
          (EL:Put 'powers edits cfg))))
    (princ "\n没有设备行或无法打开 DCL 功率表。")))
(defun c:ELPOWER (/ *error* cfg library edited)
  (defun *error* (msg) (EL:ClearGapPreview) (EL:ReleasePowerUI) (if msg (princ (strcat "\n功率编辑取消，未应用的行未保存：" msg))) (princ))
  (if (and *EL:Result* (setq cfg (EL:LoadConfig))
           (EL:SourceCurrent *EL:Result* cfg (EL:CollectEndpointSnapshot cfg)))
    (progn
      (setq library (EL:LoadLibrary) *EL:Result* (EL:BoxStatistics *EL:Result* cfg library nil)
            edited (EL:PowerDialog *EL:Result* cfg library))
      (EL:ReleasePowerUI)
      (if edited
        (if (setq cfg (EL:SaveConfig edited))
          (progn (setq *EL:Result* (EL:BoxStatistics *EL:Result* cfg library nil)) (EL:PrintStatistics *EL:Result*)))))
    (princ "\n本图没有有效统计或源图／识别配置已变化，请运行 ELTRACE。")) (princ))
(defun c:ELISSUES (/ rows index i issue object)
  (if *EL:Result*
    (progn
      (setq rows (append (EL:Get 'issues *EL:Result*) (EL:Get 'unrelated-issues *EL:Result*)) i 0)
      (foreach issue (EL:Get 'circuits *EL:Result*)
        (setq rows (append rows (EL:Get 'issues issue) (EL:Get 'power-issues issue))))
      (setq rows (EL:Unique rows))
      (foreach issue rows
        (setq i (1+ i)) (princ (strcat "\n" (itoa i) "：" (vl-prin1-to-string issue))))
      (if rows
        (progn
          (setq index (getint "\n输入问题序号定位（Enter 退出）: "))
          (if (and index (> index 0) (<= index (length rows)))
            (progn
              (setq object (EL:Get 'object (nth (1- index) rows)))
              (if (= (type object) 'STR) (EL:LocateID object)
                (foreach i object (if (= (type i) 'STR) (EL:LocateID i)))))))))) (princ))
(defun c:ELSTAT () (c:ELTRACE) (if *EL:Result* (c:ELPOWER)) (princ))
(defun c:ELSAVERESULT (/ path)
  (if *EL:Result*
    (progn
      (setq path (strcat *EL:Root* "output/statistics-" (EL:Hash (EL:Get 'drawing *EL:Result*)) ".eld"))
      (if (EL:WriteData path (list (cons 'version 1) (cons 'date (getvar "CDATE")) (cons 'result *EL:Result*)))
        (princ (strcat "\n统计与问题快照已保存：" path))))) (princ))
(defun c:ELSAVELIB (/ cfg library row old)
  (if (setq cfg (EL:LoadConfig))
    (progn
      (setq library (EL:LoadLibrary))
      (foreach row (EL:Get 'powers cfg)
        (if (EL:PowerShape row)
          (progn (setq old (EL:By 'identity (EL:Get 'identity row) library)
                  library (if old (subst row old library) (cons row library))))))
      (if (EL:WriteData (strcat *EL:Root* "config/device-library.eld") (list (cons 'version 1) (cons 'devices library)))
        (princ "\n本图确认功率已保存到项目设备库；定义或动态状态不同不会自动套用。")))) (princ))
(princ)
