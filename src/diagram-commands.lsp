;; Date: 2026-10-09. Common publication/synchronization entry points.
(defun EL:PowerInputPath (panel / drawing)
  (if (and panel *EL:Root* (setq drawing (EL:DrawingID)))
    (strcat *EL:Root* "config/power-input-" (EL:Hash (strcat drawing "/" panel)) ".eld")))
(defun EL:RememberPanelPowers (result powers / path)
  (if (assoc 'device-library result) (EL:DLRememberInputs result powers)
  (if (setq path (EL:PowerInputPath (EL:Get 'panel result)))
    (EL:WriteData path (list '(version . 1) (cons 'powers
      (vl-remove-if-not '(lambda (row) (numberp (cdr row))) powers)))))))
(defun EL:FixedPowers (record / data powers row path remembered)
  ;; Date: 2026-10-11. Shared defaults come only from ELDEVLIB; DWG values remain local.
  (setq powers (EL:Get 'powers record))
  (if (and (setq path (EL:PowerInputPath (EL:Get 'source-panel-handle record)))
      (setq remembered (EL:ReadData path)) (EL:SimplePowersValid remembered))
    (foreach row (EL:Get 'powers remembered) (setq powers (EL:Put (car row) (cdr row) powers))))
  (if (setq remembered (EL:DLLoadInputs (EL:Get 'source-panel-handle record)))
    (foreach row (EL:Get 'device-overrides remembered)
      (if (EL:Get 'watts-set (cdr row)) (setq powers (EL:Put (car row) (EL:Get 'watts (cdr row)) powers)))))
  powers)
(defun EL:SaveNamePowers (powers / data row merged)
  (if (setq data (EL:SimpleLoadPowers))
    (progn
      (setq merged (EL:Get 'powers data))
      (foreach row powers
        (if (numberp (cdr row)) (setq merged (EL:Put (car row) (cdr row) merged))))
      (EL:WriteData (strcat *EL:Root* "config/block-powers.eld") (list '(version . 1) (cons 'powers merged))))))
(defun EL:SaveDraft (result cfg powers capacity / store record context)
  (if (assoc 'effective-powers result) (setq powers (EL:Get 'effective-powers result)))
  (setq capacity (EL:CapacityDefault capacity))
  (if (not (EL:Get 'capacity-source result)) (setq result (EL:Put 'capacity-source 'default result)))
  (setq store (cond ((EL:StoreRead)) (T (EL:StoreInitial)))
    record (cond ((EL:DiagramForPanel (EL:Get 'panel result) store)) (T (EL:NewRecord (EL:Get 'panel result) store)))
    record (EL:Put 'draft-circuits (EL:Get 'circuits result) (EL:Put 'draft-capacity capacity
      (EL:Put 'powers powers (EL:Put 'config cfg (EL:Put 'engine (EL:Get 'engine result) record))))))
  (setq record (EL:Put 'panel-number (EL:PanelNumber result) record))
  (setq record (EL:DLPersist result record))
  ;; Date: 2026-10-10. Persist block-table ground choices with the draft.
  (if (assoc 'excluded-devices result)
    (setq record (EL:Put 'excluded-devices (EL:Get 'excluded-devices result) record)))
  (if (assoc 'block-ground result)
    (setq record (EL:Put 'block-ground (EL:Get 'block-ground result) record)))
  (setq record (EL:Put 'candidate-keys (EL:Get 'candidate-keys result)
    (EL:Put 'excluded-seeds (EL:Get 'excluded-seeds result)
      (EL:Put 'draft-capacity-source (EL:Get 'capacity-source result) record))))
  (if (not (EL:Get 'panel-output-handle record))
    (setq record (EL:Put 'rows (EL:Get 'circuits result)
      (EL:Put 'capacity-source (EL:Get 'capacity-source result) (EL:Put 'capacity-option capacity record)))))
  (if (or (not (EL:Get 'can-generate result)) (not (EL:SelectionsReady result capacity)))
    (setq record (EL:Put 'status 'stale record)))
  (if (EL:TemplateReady (EL:Get 'template cfg) cfg)
    (setq store (EL:Put 'fixed-template (EL:Get 'template cfg) store)))
  (EL:Require (EL:DLSubmissionCurrent result) "设备库已变化，当前输入保留；请刷新库并重新核对后保存。")
  (setq context (EL:TransactionVerifiedStore 'EL:StoreWrite (list (EL:StorePutDiagram record store))))
  (and (equal T (EL:Get 'outcome context))
    (equal record (EL:DiagramForPanel (EL:Get 'panel result) (EL:TransactionVerifiedRead context)))))
(defun EL:InvokeCCKK2 (result cfg powers capacity / *EL:CCKK2Request*)
  (setq *EL:CCKK2Request* (list result cfg powers capacity))
  (c:CCKK2))
(defun EL:CCKK2FromPanel (request / result)
  (setq result (car request))
  (princ (strcat "\n调用 CCKK2：" (itoa (length (EL:Get 'circuits result)))
    " 条实际回路，功率采用本次统计；无需再输入回路数。"))
  (EL:LogCall "CCKK2" (list (cons 'circuits (length (EL:Get 'circuits result)))
      (cons 'watts (mapcar '(lambda (row) (EL:Get 'watts row)) (EL:Get 'circuits result))))
    'EL:SyncDiagram (append request '(T T))))
(defun EL:EditPanel (result cfg / next context managed)
  ;; Date: 2026-10-10. Iterate saved-record navigation without nested dialogs.
  (while result
    (setq *EL:Result* result *EL:FixedConfig* cfg)
    (setq next (EL:EditPanelOnce result cfg))
    (if (setq context (EL:Get 'library-panel next))
      (progn (setq *EL:DLParentContext* context *EL:DLParentContinue* 'EL:DLResumePanel)
        (setq managed (EL:DLUIOpen) *EL:DLSessionSnapshot* nil *EL:DLCache* nil)
        (if (equal managed 'suspended) (setq result nil)
          (setq *EL:DLResume* context *EL:DLParentContext* nil *EL:DLParentContinue* nil
            result (EL:Get 'result context) cfg (EL:Get 'config context))))
      (setq result (EL:Get 'switch-result next) cfg (EL:Get 'switch-config next))))
  next)
(defun EL:EditPanelOnce (result cfg / *error* store record powers capacity edited prepared saved ownlog syncable template resolved resumed *EL:FreshScope* *EL:FreshScopeEnabled*)
  (defun *error* (msg)
    (EL:LogFailure msg)
    (vl-catch-all-apply 'EL:ClearGapPreview nil)
    (vl-catch-all-apply 'EL:ClearPickHighlights nil)
    (vl-catch-all-apply 'EL:ReleasePowerUI nil)
    (if msg (princ (strcat "\n主面板已停止；未提交草稿保留原值：" msg)))
    (EL:PerfFinish 'failed) (princ))
  (setq *EL:FreshScopeEnabled* T ownlog (not *EL:LogActive*))
  (if ownlog (EL:LogStart))
  (EL:LogEvent "EDIT_PANEL" (list (cons 'panel (EL:Get 'panel result))))
  (setq store (cond ((EL:LogCall "READ_STORE" nil 'EL:StoreRead nil)) (T (EL:StoreInitial)))
    record (cond ((EL:DiagramForPanel (EL:Get 'panel result) store))
      (T (EL:LogCall "NEW_RECORD" (list (cons 'panel (EL:Get 'panel result))
        (cons 'drawing-uuid (EL:Get 'drawing-uuid store))) 'EL:NewRecord (list (EL:Get 'panel result) store))))
    powers (EL:FixedPowers record)
    prepared (EL:LogCall "PREPARE_PANEL" (list (cons 'diagram-id (EL:Get 'diagram-id record))) 'EL:PreparedResult (list result
      (if (EL:Get 'draft-circuits record) (EL:Put 'rows (EL:Get 'draft-circuits record) record) record))))
  (setq capacity (EL:CapacityDefault
    (if (EL:Get 'draft-circuits record) (EL:Get 'draft-capacity record) (EL:Get 'capacity-option record)))
    template (EL:Get 'template cfg))
  (if (not (EL:TemplateReady template cfg))
    (setq template (if (EL:TemplateReady (EL:Get 'template (EL:Get 'config record)) cfg)
      (EL:Get 'template (EL:Get 'config record)) (EL:Get 'template record))))
  (if (not (EL:TemplateReady template cfg)) (setq template (EL:Get 'fixed-template store)))
  (setq cfg (EL:Put 'template template cfg))
  (if (and *EL:DLResume* (equal (EL:Get 'panel (EL:Get 'result *EL:DLResume*)) (EL:Get 'panel result)))
    (setq prepared (EL:Get 'result *EL:DLResume*) powers (EL:Get 'powers *EL:DLResume*)
      cfg (EL:Get 'config *EL:DLResume*) capacity (EL:Get 'capacity *EL:DLResume*) *EL:DLResume* nil))
  (setq *EL:DLSessionSnapshot* (EL:DLSnapshot) resolved (EL:DLPrepare prepared powers *EL:DLSessionSnapshot* nil)
    prepared (EL:Get 'result resolved) powers (EL:Get 'powers resolved))
  (if (setq edited (EL:LogCall "PANEL_DIALOG" (list (cons 'panel (EL:Get 'panel result)))
      'EL:PanelDialog (list prepared cfg powers capacity)))
    (if (not (or (EL:Get 'switch-result edited) (EL:Get 'pick-panel edited) (EL:Get 'library-panel edited))) (progn
      (setq result (EL:Get 'result edited) powers (EL:Get 'powers edited) capacity (EL:Get 'capacity edited)
        cfg (cond ((EL:Get 'config edited)) (T cfg))
        syncable (and (EL:Get 'can-generate result) (EL:SelectionsReady result capacity)
          (EL:TemplateReady (EL:Get 'template cfg) cfg)))
      (EL:LogEvent "PANEL_SUBMIT" (list (cons 'generate (EL:Get 'generate edited))
        (cons 'syncable syncable) (cons 'panel (EL:Get 'panel result))))
      (EL:PerfMark "panel-submit") (EL:PerfCount "panel-submits" 1)
      (EL:PerfSet "actual-circuits" (length (EL:Get 'circuits result)))
      (EL:RememberPanelPowers result powers)
      (if (and (not (assoc 'device-library result)) (not (EL:SaveNamePowers powers)))
        (princ "\n功率库写入失败，请保留当前窗口数值并检查插件目录写入权限。"))
      (if (and (EL:DLSubmissionCurrent result) (EL:LogCall "PRE_GENERATE_FRESH" nil 'EL:FreshResult (list result cfg)))
        (progn
          ;; Keep accepted setup and draft outside the preview undo group.
          (setq *EL:Result* result *EL:FixedConfig* cfg)
          (if (and syncable (EL:Get 'generate edited)
              (not (EL:Get 'panel-output-handle record)))
            (EL:Require (EL:LogCall "SAVE_GENERATION_DRAFT" nil 'EL:SaveDraft (list result cfg powers capacity)) "生成前保存草稿失败，请重试。"))
          (setq saved (if syncable
            (if (EL:Get 'generate edited)
              (EL:InvokeCCKK2 result cfg powers capacity)
              (EL:SyncDiagram result cfg powers capacity nil T))
            (progn
              (if (EL:Get 'generate edited)
                (princ "\n生成未执行：回路、功率或模板校验未通过；已保存为待更新草稿，请重新统计并核对。"))
              (EL:MarkStale (EL:Get 'panel result) 'review-or-template-pending) T)))
          (if saved
            (progn
              ;; The DWG keeps a recoverable power copy even when export is unavailable.
              (if (or (not (EL:Get 'panel-output-handle (EL:DiagramForPanel (EL:Get 'panel result) (EL:StoreRead))))
                  (not syncable))
                (setq saved (EL:SaveDraft result cfg powers capacity)))
              (if saved
                (progn
                  (setq *EL:Result* result *EL:FixedConfig* cfg)
                  (if (and (not (assoc 'device-library result)) (not (EL:SaveNamePowers powers))) (princ "\nDWG 已保存；共享图块功率库写入失败，其他图纸暂不复用本次值。"))
                  (princ "\n主面板已保存到本图；关闭图纸前请保存 DWG。")))))
          (if (not saved) (princ "\n本次保存或生成未完成，未报告成功；请查看上方原因后重试。")))
        (progn (EL:MarkStale (EL:Get 'panel result) 'source-changed)
          (EL:PerfInput 'alert (list (if (EL:DLSubmissionCurrent result)
            "源图状态已变化，回路草稿未保存，请重新统计。已填写功率已尝试单独记住。"
            "设备库已变化，回路草稿未保存；输入已尝试单独记住，请打开设备库并重新核对。"))))))))
  (if (and (not edited) (EL:Get 'panel-output-handle record))
    (EL:MarkStale (EL:Get 'panel result) 'review-cancelled))
  (EL:ClearPickHighlights)
  (if ownlog (EL:LogFinish (if edited 'panel-accepted 'panel-cancelled)))
  (if (or (EL:Get 'switch-result edited) (EL:Get 'pick-panel edited) (EL:Get 'library-panel edited)) edited))
(defun EL:PublishDiagram (result cfg / store record powers capacity)
  (setq store (EL:StoreRead) record (EL:DiagramForPanel (EL:Get 'panel result) store))
  (if record
    (progn
      (setq capacity (cond ((EL:Get 'capacity-option record)) (T 'cap300)) powers (EL:Get 'powers record))
      (if (equal (EL:Get 'engine result) 'fixed)
        (setq powers (EL:FixedPowers record) result (EL:PanelCompute result powers cfg))
        (setq result (EL:BoxStatistics result cfg (EL:LoadLibrary) nil)))
      (EL:SyncDiagram result cfg powers capacity nil nil))) result)
;; Date: 2026-10-10. Empty recognition is a user-visible outcome, not a panel error.
(defun EL:PickedDevicesReady (result / ids circuit message)
  (foreach circuit (EL:Get 'circuits result) (setq ids (append ids (EL:Get 'devices circuit))))
  (if ids T
    (progn
      (setq message "未识别到连接设备：当前配电箱出线只有导线或未接到可识别设备。请检查导线连接及设备图块后重新拾取；本次未保存或生成系统图。")
      (EL:LogEvent "NO_CONNECTED_DEVICES" (list (cons 'panel (EL:Get 'panel result))
        (cons 'circuits (length (EL:Get 'circuits result))) (cons 'message message)))
      (princ (strcat "\n" message)) (EL:PerfInput 'alert (list message)) nil)))
(defun EL:FixedStatPick (/ *error* panel pd cfg result record powers next number)
  (defun *error* (msg)
    (EL:LogFailure msg)
    (vl-catch-all-apply 'EL:ClearPickHighlights nil)
    (vl-catch-all-apply 'EL:ReleasePowerUI nil)
    (if pd (vl-catch-all-apply 'EL:MarkStale (list (cdr (assoc 5 pd)) 'recognition-cancelled)))
    (if msg (princ (strcat "\n统计已停止：" msg))) (EL:PerfFinish 'failed) (princ))
  (setq *EL:Result* nil *EL:DeviceResult* nil)
  (EL:LogStart)
  (if (and (EL:EnsureRoot) (progn (EL:LogAttach) T) (setq panel (EL:PickModel 'panel "\n拾取配电箱：")))
    (progn
      (setq pd (entget (car panel)))
      (EL:Require (not (EL:ManagedEntity (car panel))) "请选择平面图配电箱，不能统计系统图输出。")
      (setq number (EL:PickPanelNumber))
      (setq cfg (EL:Put 'template (EL:Get 'template (EL:LoadConfig))
        (EL:Put 'params (EL:GapParams (EL:SuggestedParams)) (EL:DefaultConfig (EL:DrawingID)))))
      (if (setq cfg (EL:PanelWireConfig (car panel) cfg))
        (progn
          (EL:LogEvent "PICKS" (list (cons 'panel (EL:LogEntity (car panel)))))
          (setq
            result (EL:LogCall "RECOGNIZE_FIXED" (list (cons 'panel (cdr (assoc 5 pd)))
              (cons 'styles (EL:Get 'wire-styles cfg))) 'EL:RecognizeFixed (list cfg (cdr (assoc 5 pd))))
            record (EL:DiagramForPanel (cdr (assoc 5 pd)) (EL:StoreRead)))
          ;; Review and powers now share one modal dialog.
          (setq result (EL:Put 'panel-number number
            (EL:Put 'excluded-seeds (EL:Get 'excluded-seeds record) result)))
          (setq powers (EL:FixedPowers record) result (EL:PanelCompute result powers cfg)
            *EL:Result* result *EL:FixedConfig* cfg)
          (if (EL:PickedDevicesReady result) (setq next (EL:EditPanel result cfg))
            (setq *EL:Result* nil next (EL:PanelStartDialog))))
        (EL:MarkStale (cdr (assoc 5 pd)) 'recognition-cancelled))))
  (EL:ClearPickHighlights) (EL:LogFinish 'command-finished) next)
;; Date: 2026-10-10. Reuse an exact saved trunk association; first use identifies the real panel.
(defun EL:TrunkSavedPanel (trunk store / ids row)
  (foreach row (EL:Get 'diagrams store)
    (if (equal trunk (EL:Get 'concentrated-trunk (EL:Get 'config row)))
      (setq ids (cons (EL:Get 'source-panel-handle row) ids))))
  (setq ids (EL:Unique ids))
  (if (= (length ids) 1) (car ids)))
(defun EL:FixedTrunkPick (/ *error* pick trunk panel cfg result record next data id number)
  (defun *error* (msg)
    (EL:LogFailure msg)
    (vl-catch-all-apply 'EL:ClearPickHighlights nil)
    (vl-catch-all-apply 'EL:ReleasePowerUI nil)
    (if msg (princ (strcat "\n集中引出线统计已停止：" msg))) (EL:PerfFinish 'failed) (princ))
  (setq *EL:Result* nil *EL:DeviceResult* nil)
  (EL:LogStart)
  (if (and (EL:EnsureRoot) (progn (EL:LogAttach) T)
      (setq pick (EL:PickModel 'wire "\n拾取与各回路出线相接的集中干线：")))
    (progn
      (setq trunk (car pick) data (entget trunk) id (cdr (assoc 5 data)))
      (EL:Require (and (not (EL:ManagedEntity trunk)) (not (equal (cdr (assoc 60 data)) 1)))
        "请选择平面图中可见的集中干线。")
      (setq panel (EL:TrunkSavedPanel id (EL:StoreRead)))
      (if (or (not panel) (not (handent panel)))
        (progn
          (princ "\n首次使用此干线，请补点实际配电箱；保存后自动复用关联。")
          (setq pick (EL:PickModel 'panel "\n拾取此集中干线所属的配电箱（Enter 取消）：")
            panel (if pick (cdr (assoc 5 (entget (car pick))))))))
      (if panel
        (progn
          (EL:Require (and (equal (cdr (assoc 0 (entget (handent panel)))) "INSERT")
            (not (EL:ManagedEntity (handent panel)))) "来源配电箱无效或为系统图输出。")
          (setq number (EL:PickPanelNumber))
          (setq cfg (EL:Put 'template (EL:Get 'template (EL:LoadConfig))
            (EL:Put 'params (EL:GapParams (EL:SuggestedParams)) (EL:DefaultConfig (EL:DrawingID))))
            cfg (EL:Put 'concentrated-trunk id (EL:Put 'auto-panel panel
              (EL:Put 'wire-styles (list (EL:WireStyle data))
                (EL:Put 'wire-layers (list (cdr (assoc 8 data))) cfg))))
            result (EL:LogCall "RECOGNIZE_TRUNK" (list panel id) 'EL:RecognizeFixed (list cfg panel))
            result (EL:Put 'panel-number number result))
          (princ (strcat "\n集中干线已识别 " (itoa (length (EL:Get 'circuits result)))
            " 条出线，箱侧连接段已排除；请用查看全部回路核对。"))
          (setq *EL:Result* result *EL:FixedConfig* cfg)
          (if (EL:PickedDevicesReady result) (setq next (EL:EditPanel result cfg))
            (setq *EL:Result* nil next (EL:PanelStartDialog)))))))
  (EL:ClearPickHighlights) (EL:LogFinish 'command-finished) next)
(defun c:ELGEN (/ *error* cfg result record powers capacity perfowner)
  (defun *error* (msg)
    (redraw) (EL:ClearPickHighlights)
    (if *EL:Result* (vl-catch-all-apply 'EL:MarkStale (list (EL:Get 'panel *EL:Result*) 'update-failed)))
    (if msg (princ (strcat "\n生成或更新停止：" msg))) (EL:PerfFinish 'failed) (princ))
  (setq perfowner (EL:PerfStart "ELGEN"))
  (if (and *EL:Result* (EL:EnsureRoot))
    (progn
      (setq result *EL:Result* record (EL:DiagramForPanel (EL:Get 'panel result) (EL:StoreRead)))
      (if (equal (EL:Get 'engine result) 'fixed)
        (progn
          (setq cfg *EL:FixedConfig* powers (EL:FixedPowers record) result (EL:PanelCompute result powers cfg))
          (if (not (EL:Get 'template cfg)) (setq cfg (EL:Put 'template (EL:Get 'template (EL:LoadConfig)) cfg))))
        (progn
          (princ "\n本次使用高级流程按身份保存的功率；不会写入按块名共享功率库。")
          (setq cfg (EL:LoadConfig) result (EL:BoxStatistics result cfg (EL:LoadLibrary) nil))))
      (setq capacity (cond ((EL:Get 'capacity-option record)) (T 'cap300)))
      (if (equal (EL:Get 'engine result) 'fixed)
        (EL:EditPanel result cfg)
        (EL:SyncDiagram result cfg powers capacity T T)))
    (princ "\n请先运行 ELSTAT 或 ELTRACE。"))
  (if perfowner (EL:PerfFinish 'command-finished)) (princ))
(defun c:ELUPDATE (/ *error* pick tag store record cfg panel result context seeds review perfowner *EL:ExitSnapshot* *EL:ExitDefaults* *EL:OutsidePorts*)
  (defun *error* (msg)
    (EL:ClearPickHighlights)
    (if panel (vl-catch-all-apply 'EL:MarkStale (list panel 'update-failed)))
    (if msg (princ (strcat "\n重新统计更新停止：" msg))) (EL:PerfFinish 'failed) (princ))
  (setq perfowner (EL:PerfStart "ELUPDATE"))
  (if (and (EL:EnsureRoot) (setq pick (EL:PickEntity "\n选择受管系统图的箱体、回路或功率文字：")))
    (progn
      (setq tag (EL:DiagramTag (car pick)) store (EL:StoreRead)
        record (EL:By 'diagram-id (cdr (nth 1 tag)) (EL:Get 'diagrams store)))
      (EL:Require (and record (equal (cdr (car tag)) (EL:Get 'drawing-uuid store))
        (equal (cdr (nth 4 tag)) (cdr (assoc 5 (entget (car pick)))))) "不是本图原始受管对象；复制或跨图对象不能自动继承关联。")
      (setq panel (EL:Get 'source-panel-handle record) cfg (EL:Get 'config record))
      (if (equal (EL:Get 'engine record) 'fixed)
        (progn
          (setq result (EL:ReviewFixedExits (EL:RecognizeFixed cfg panel) record))
          (EL:Require result "出线核对已取消。")
          (setq result (EL:PanelCompute result (EL:FixedPowers record) cfg) *EL:FixedConfig* cfg))
        (progn
          (setq context (EL:CurrentContext cfg panel) seeds (cadr context)
            *EL:ExitSnapshot* (car context) *EL:ExitDefaults*
              (list (cons 'keys (mapcar '(lambda (r) (EL:Get 'seed-key r)) (EL:ActualRows record)))))
          (setq review (EL:ReviewExits seeds))
          (EL:Require (and review (not (equal review 'add))) "高级出线核对取消；补充图层请运行 ELTRACE。")
          (setq seeds (car review))
          (setq result (EL:BoxStatistics (EL:AnalyzeSnapshot (car context) cfg panel seeds) cfg (EL:LoadLibrary) nil))))
      (setq *EL:Result* result)
      (if (equal (EL:Get 'engine result) 'fixed)
        (EL:EditPanel result cfg)
        (EL:SyncDiagram result cfg (EL:Get 'powers record) (EL:Get 'capacity-option record) nil T))))
  (EL:ClearPickHighlights) (if perfowner (EL:PerfFinish 'command-finished)) (princ))

;; Date: 2026-10-10. ELSTAT opens the panel before requesting model selection.
(defun EL:FixedStat (/ *error* next perfowner)
  (defun *error* (msg)
    (vl-catch-all-apply 'EL:ReleasePowerUI nil)
    (if msg (princ (strcat "\n面板已停止：" msg))) (EL:PerfFinish 'failed) (princ))
  (setq perfowner (EL:PerfStart "ELSTAT"))
  (if (EL:EnsureRoot)
    (progn
      (setq next (EL:PanelStartDialog))
      (while (or (EL:Get 'pick-panel next) (EL:Get 'switch-result next))
        (setq next (if (EL:Get 'switch-result next)
          (EL:EditPanel (EL:Get 'switch-result next) (EL:Get 'switch-config next))
          (if (equal (EL:Get 'pick-panel next) 'trunk)
            (EL:FixedTrunkPick) (EL:FixedStatPick)))))))
  (if perfowner (EL:PerfFinish 'command-finished)) (princ))

;; Date: 2026-10-11. Explicit, read-only export of the verified DWG record.
(defun EL:DiagnosticRecord (store / record pick tag handle)
  (if *EL:Result*
    (setq record (EL:DiagramForPanel (EL:Get 'panel *EL:Result*) store)))
  (if (not record)
    (if (setq pick (EL:PickEntity "\n选择要导出的受管系统图箱体、回路或文字（Enter 取消）："))
      (progn
        (setq handle (cdr (assoc 5 (entget (car pick)))) tag (EL:DiagramTag (car pick))
          record (EL:By 'diagram-id (cdr (nth 1 tag)) (EL:Get 'diagrams store)))
        (EL:Require (and record (equal (cdr (car tag)) (EL:Get 'drawing-uuid store))
          (equal (cdr (nth 4 tag)) handle)
          (EL:OwnedEntity handle store record (cdr (nth 2 tag)) (cdr (nth 3 tag)))
          (member (list handle (cdr (nth 2 tag)) (cdr (nth 3 tag))) (EL:DiagramOutputRefs record)))
          "不是本图原始受管成员；复制或外来对象不能导出关联记录。")))) record)
(defun EL:DiagnosticRecordValid (record store / ref entity)
  (EL:Require (and (equal (type (EL:Get 'diagram-id record)) 'STR)
    (/= (EL:Get 'diagram-id record) "")
    (equal (type (EL:Get 'source-panel-handle record)) 'STR)
    (/= (EL:Get 'source-panel-handle record) "")
    (equal (type (EL:Get 'panel-output-handle record)) 'STR)
    (/= (EL:Get 'panel-output-handle record) "")
    (equal (type (EL:Get 'drawing-uuid store)) 'STR)
    (/= (EL:Get 'drawing-uuid store) "")
    (EL:UniqueDiagram store record)) "系统图身份不完整或有复制关联，未导出诊断副本。")
  (foreach ref (EL:DiagramOutputRefs record)
    (setq entity (EL:OwnedEntity (car ref) store record (cadr ref) (caddr ref)))
    ;; Exporting is read-only, so a locked layer does not prevent diagnostics.
    (EL:Require (and entity (equal (cdr (assoc 410 (entget entity))) "Model"))
      "系统图成员缺失或归属失配，未导出诊断副本。")) T)
(defun EL:DiagnosticExport (/ store record path exported)
  (if (EL:EnsureRoot)
    (progn
      (EL:LogAttach)
      (setq store (EL:StoreRead))
      (EL:Require store "本图没有可导出的 DWG 系统图主记录。")
      (if (setq record (EL:DiagnosticRecord store))
        (progn
          (EL:DiagnosticRecordValid record store)
          (setq path (strcat *EL:Root* "output/diagram-" (EL:Hash (EL:Get 'diagram-id record)) ".eld")
            exported (EL:PerfCall "DIAGNOSTIC_EXPORT" 'EL:WriteData (list path record)))
          (if exported
            (progn
              (EL:LogEvent "DIAGNOSTIC_EXPORTED" (list (cons 'diagram-id (EL:Get 'diagram-id record)) (cons 'path path)))
              (princ (strcat "\n系统图诊断副本已导出：" path)))
            (progn
              (EL:LogEvent "DIAGNOSTIC_EXPORT_FAILED" (list (cons 'diagram-id (EL:Get 'diagram-id record)) (cons 'path path)))
              (princ (strcat "\n诊断副本导出失败，请检查目录写入权限：" path)))) exported)
        (progn (princ "\n未选择系统图，诊断导出已取消。") nil)))))
(defun c:ELDIAG (/ *error* perfowner outcome checkpoint failed)
  (defun *error* (message)
    (EL:PerfUnwind checkpoint) (EL:ClearPickHighlights)
    (EL:LogFailure message) (if perfowner (EL:PerfFinish 'failed)) (princ))
  (setq perfowner (EL:PerfStart "ELDIAG") checkpoint *EL:PerfPending*)
  (EL:LogStart)
  (setq outcome (vl-catch-all-apply 'EL:LogCall
    (list "DIAGNOSTIC_COMMAND" nil 'EL:DiagnosticExport nil)))
  (if (vl-catch-all-error-p outcome)
    (progn
      (setq failed T) (EL:PerfUnwind checkpoint)
      (EL:LogFailure (vl-catch-all-error-message outcome)))
    (EL:LogFinish (if outcome 'diagnostic-exported 'diagnostic-not-exported)))
  (EL:ClearPickHighlights)
  (if perfowner (EL:PerfFinish (if failed 'failed (if outcome 'diagnostic-exported 'diagnostic-not-exported)))) (princ))
