(defun EL:ColorPreviewWire (wire color / object space segment copy)
  (EL:Require (handent (EL:Get 'source-wire wire)) "集中出线源导线已删除，请重新统计。")
  (setq object (vlax-ename->vla-object (handent (EL:Get 'source-wire wire)))
