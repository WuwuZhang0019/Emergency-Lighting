;; Date: 2026-10-09. DWG-owned records; external .eld files are diagnostic only.
(defun EL:StoreRead (/ entry textdata pair value)
  (if (setq entry (dictsearch (namedobjdict) "EL_FIXED_V1"))
    (progn
      (setq textdata "")
      (foreach pair entry (if (= (car pair) 1) (setq textdata (strcat textdata (cdr pair)))))
      (setq value (vl-catch-all-apply 'read (list textdata)))
      (if (or (vl-catch-all-error-p value) (not (equal (EL:Get 'schema-version value) 1))
          (not (equal (type (EL:Get 'drawing-uuid value)) 'STR))
          (not (listp (EL:Get 'diagrams value))))
        (progn (princ "\nDWG 系统图主记录损坏或版本不兼容，已停止写入。") (exit)))
      value)))
(defun EL:StoreInitial ()
  (list '(schema-version . 1) (cons 'drawing-uuid (getvar "FINGERPRINTGUID")) '(diagrams)))
(defun EL:StoreWrite (store / textdata chunks entry entity data i)
  (setq textdata (vl-prin1-to-string store) i 1)
  ;; Keep each DXF string well below the byte limit even in GB2312.
  (while (<= i (strlen textdata))
    (setq chunks (cons (cons 1 (substr textdata i 100)) chunks) i (+ i 100)))
  (setq entry (dictsearch (namedobjdict) "EL_FIXED_V1") entity (cdr (assoc -1 entry)))
  (if entity
    (progn
      (setq data (vl-remove-if '(lambda (p) (= (car p) 1)) (entget entity)))
      (if (not (entmod (append data (reverse chunks)))) (exit)))
    (progn
      (setq entity (entmakex (append '((0 . "XRECORD") (100 . "AcDbXrecord") (280 . 1)) (reverse chunks))))
      (if (or (not entity) (not (dictadd (namedobjdict) "EL_FIXED_V1" entity))) (exit))))
  (if (not (equal store (EL:StoreRead))) (exit)) T)
(defun EL:DiagramForPanel (panel store / found rows)
  (setq rows (vl-remove-if-not '(lambda (r) (equal panel (EL:Get 'source-panel-handle r))) (EL:Get 'diagrams store)))
  (if (> (length rows) 1) (progn (princ "\n来源箱体存在重复系统图关联，需修复。") (exit)))
  (car rows))
(defun EL:StorePutDiagram (record store / rows old)
  (setq rows (EL:Get 'diagrams store) old (EL:By 'diagram-id (EL:Get 'diagram-id record) rows))
  (EL:Put 'diagrams (if old (subst record old rows) (append rows (list record))) store))
(defun EL:TagEntity (object store record kind uid / e data tag)
  (regapp "EL_FIXED_V1")
  (setq e (vlax-vla-object->ename object) data (entget e)
    tag (list "EL_FIXED_V1" (cons 1000 (EL:Get 'drawing-uuid store))
      (cons 1000 (EL:Get 'diagram-id record)) (cons 1000 kind) (cons 1000 uid)
      (cons 1000 (cdr (assoc 5 data)))))
  (if (not (entmod (append data (list (list -3 tag))))) (exit))
  (cdr (assoc 5 data)))
(defun EL:OwnedEntity (handle store record kind uid / e data tag)
  (if (and (equal (type handle) 'STR) (setq e (handent handle)))
    (progn
      (setq data (entget e) tag (EL:DiagramTag e))
      (if (and (equal (cdr (assoc 0 data)) (if (equal kind "text") "TEXT" "INSERT"))
          (equal tag (list (cons 1000 (EL:Get 'drawing-uuid store))
            (cons 1000 (EL:Get 'diagram-id record)) (cons 1000 kind) (cons 1000 uid) (cons 1000 handle)))) e))))
(defun EL:UniqueDiagram (store record / ss i e tag good)
  (setq ss (ssget "_X" '((-3 ("EL_FIXED_V1")))) i 0 good T)
  (if ss (repeat (sslength ss)
    (setq e (ssname ss i) tag (EL:DiagramTag e) i (1+ i))
    (if (equal (cdr (nth 1 tag)) (EL:Get 'diagram-id record))
      (if (or (not (equal (cdr (car tag)) (EL:Get 'drawing-uuid store)))
          (not (equal (cdr (nth 4 tag)) (cdr (assoc 5 (entget e)))))) (setq good nil))))) good)
(defun EL:DiagramTransform (entity / d sx sy sz normal)
  (setq d (entget entity) sx (cdr (assoc 41 d)) sy (cdr (assoc 42 d)) sz (cdr (assoc 43 d))
    normal (cdr (assoc 210 d)))
  (if (and (equal (cdr (assoc 410 d)) "Model") (numberp sx) (> sx 0.0)
      (equal sx sy 1.0e-8) (equal sx sz 1.0e-8)
      (or (not normal) (equal normal '(0.0 0.0 1.0) 1.0e-8)))
    (list (cons 'position (cdr (assoc 10 d))) (cons 'rotation (cdr (assoc 50 d))) (cons 'scale sx))))
(defun EL:Writable (entity / d layer flags)
  (if entity
    (progn (setq d (entget entity) layer (tblsearch "LAYER" (cdr (assoc 8 d))) flags (cdr (assoc 70 layer)))
      (and layer (equal (cdr (assoc 410 d)) "Model") (= 0 (logand flags 4))))))
(defun EL:RecordRows (result plan handles / out row c h)
  (foreach row (EL:Get 'rows plan)
    (setq c (EL:By 'circuit-uid (EL:Get 'circuit-uid row) (EL:Get 'circuits result))
      h (EL:By 'circuit-uid (EL:Get 'circuit-uid row) handles))
    (setq out (cons (append (list (cons 'circuit-uid (EL:Get 'circuit-uid row))
      (cons 'block-handle (EL:Get 'block-handle h)) (cons 'text-handle (EL:Get 'text-handle h))
      (cons 'position (EL:Get 'position row)) (cons 'text-position (EL:Get 'text-position row))
      (cons 'mode (EL:Get 'mode row)) (cons 'value (EL:Get 'value row)) (cons 'watts (EL:Get 'watts row)))
      (mapcar '(lambda (key) (cons key (EL:Get key c)))
        '(seed-key id output-order is-ground ground-source ground-rule ground-evidence))) out))) (reverse out))
(defun EL:TransactionRollback (/ doc)
  (if *EL:TransactionOpen*
    (progn
      (setq doc (vla-get-ActiveDocument (vlax-get-acad-object)))
      (vla-EndUndoMark doc) (setq *EL:TransactionOpen* nil)
      ;; The single group contains INSERT/TEXT, deletes, dynamic state and XRecord.
      (command-s "_.UNDO" "1") (setq *EL:Created* nil)))
  (redraw))
(defun EL:Transaction (function args / *error* doc outcome)
  (defun *error* (msg)
    (EL:TransactionRollback) (EL:ClearPickHighlights)
    (if msg (princ (strcat "\n系统图事务取消，已撤销本次修改：" msg))) (princ))
  (if (or (= 0 (logand 1 (getvar "UNDOCTL"))) (/= 0 (logand 8 (getvar "UNDOCTL"))))
    (princ "\n请启用 UNDO 并结束已有撤销组。")
    (progn
      (setq doc (vla-get-ActiveDocument (vlax-get-acad-object)))
      (vla-StartUndoMark doc) (setq *EL:TransactionOpen* T *EL:Created* nil)
      (setq outcome (vl-catch-all-apply function args))
      (if (or (vl-catch-all-error-p outcome) (not outcome))
        (progn (EL:TransactionRollback) (princ "\n本次系统图更新失败，已撤销图形及 DWG 记录修改。") nil)
        (progn (vla-EndUndoMark doc) (setq *EL:TransactionOpen* nil *EL:Created* nil) outcome)))))
(defun EL:CreateDiagram (result template capacity plan record store / doc space layer object handles row h)
  (setq doc (vla-get-ActiveDocument (vlax-get-acad-object)) space (vla-get-ModelSpace doc) layer (EL:Get 'layer template))
  (if (not (tblsearch "LAYER" layer)) (vla-Add (vla-get-Layers doc) layer))
  (setq object (EL:CreateBlock space (EL:Get 'panel-name plan) (EL:Get 'position plan)
    (EL:Get 'scale plan) (EL:Get 'rotation plan) (EL:Get 'property (EL:Get 'panel template)) (EL:Get 'panel-value plan) layer))
  (setq record (EL:Put 'panel-output-handle (EL:TagEntity object store record "panel" "panel") record))
  (foreach row (EL:Get 'rows plan)
    (setq object (EL:CreateBlock space (EL:Get 'name (EL:Get 'circuit template)) (EL:Get 'position row)
      (EL:Get 'scale plan) (EL:Get 'rotation plan) (EL:Get 'property (EL:Get 'circuit template)) (EL:Get 'value row) layer)
      h (list (cons 'circuit-uid (EL:Get 'circuit-uid row))
        (cons 'block-handle (EL:TagEntity object store record "circuit" (EL:Get 'circuit-uid row)))))
    (if (EL:Get 'text row)
      (setq h (EL:Put 'text-handle (EL:TagEntity (EL:CreateAnnotation space row plan layer)
        store record "text" (EL:Get 'circuit-uid row)) h)))
    (setq handles (cons h handles)))
  (setq record (EL:Put 'rows (EL:RecordRows result plan handles) (EL:Put 'plan plan record)))
  (EL:StoreWrite (EL:StorePutDiagram record store)) record)
