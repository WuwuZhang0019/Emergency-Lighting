(defun EL:Edge (a b) (if (< a b) (list a b) (list b a)))
(defun EL:Neighbours (id edges / out e)
  (foreach e edges
    (cond ((equal id (car e)) (setq out (cons (cadr e) out)))
          ((equal id (cadr e)) (setq out (cons (car e) out))))) (EL:Unique out))
(defun EL:Component (start edges / queue visited id next)
  (setq queue (list start))
  (while queue
    (setq id (car queue) queue (cdr queue))
    (if (not (member id visited))
      (progn
        (setq visited (cons id visited))
        (foreach next (EL:Neighbours id edges)
          (if (not (member next visited)) (setq queue (cons next queue))))))) (EL:Unique visited))
(defun EL:InsideSegments (p segments / count seg a b x)
  (setq count 0)
  (foreach seg segments
    (setq a (car seg) b (cadr seg))
    (if (or (and (> (cadr a) (cadr p)) (<= (cadr b) (cadr p)))
            (and (> (cadr b) (cadr p)) (<= (cadr a) (cadr p))))
      (progn
        (setq x (+ (car a) (* (- (cadr p) (cadr a)) (/ (- (car b) (car a)) (- (cadr b) (cadr a))))))
        (if (> x (car p)) (setq count (1+ count)))))) (= 1 (rem count 2)))
(defun EL:SeedCandidates (snapshot cfg panel / block ends seeds endrec id i wire direction step)
  (setq block (EL:By 'id panel (EL:Get 'blocks snapshot)) ends (EL:Get 'ends snapshot) i 0)
  (foreach endrec (vl-sort ends '(lambda (a b) (< (EL:Signature (EL:Get 'key a)) (EL:Signature (EL:Get 'key b)))))
    (if (and (equal (EL:Get 'contacts endrec) (list panel)) (not (EL:Get 'status endrec)))
      (progn
        (setq direction (EL:Get 'direction endrec)
              step (max 0.001 (* 3.0 (EL:Get 'eps_boundary (EL:Get 'params cfg)))))
        (if (and direction (not (EL:InsideSegments
          (EL:V- (EL:Get 'point endrec) (EL:V* step direction)) (EL:Get 'segments block))))
          (progn
            (setq i (1+ i))
            (setq seeds (cons (list (cons 'id (strcat "R" (itoa i))) (cons 'wire (EL:Get 'wire endrec))
              (cons 'key (EL:Get 'key endrec)) (cons 'point (EL:Get 'point endrec))) seeds)))))))
  (reverse seeds))
(defun EL:ValidatePairSet (snapshot cfg base pairs seeds / good issues counts pair a b key invalid temp component seed hits rejected accepted rec objects)
  ;; Validate all proposals before traversal. Reject every proposal in a conflict component.
  (foreach pair pairs
    (setq a (EL:By 'key (EL:Get 'a pair) (EL:Get 'ends snapshot))
          b (EL:By 'key (EL:Get 'b pair) (EL:Get 'ends snapshot)))
    (if (and a b (not (EL:Get 'occupied a)) (not (EL:Get 'occupied b))
             (not (equal (EL:Get 'wire a) (EL:Get 'wire b)))
             (not (= (EL:Get 'geometry a) 'INVALID_GEOMETRY)) (not (= (EL:Get 'geometry b) 'INVALID_GEOMETRY))
             (EL:LayerAllowed (EL:Get 'layer a) (EL:Get 'layer b) cfg)
             (<= (abs (- (caddr (EL:Get 'point a)) (caddr (EL:Get 'point b)))) (EL:Get 'eps_z (EL:Get 'params cfg))))
      (progn
        (setq good (cons pair good))
        (foreach key (list (EL:Get 'a pair) (EL:Get 'b pair))
          (setq counts (EL:Put key (1+ (cond ((EL:Get key counts)) (T 0))) counts))))
      (foreach rec (list (car (EL:Get 'a pair)) (car (EL:Get 'b pair)))
        (setq issues (cons (EL:Issue 'ENDPOINT_OCCUPIED rec pair) issues)))))
  (foreach pair good
    (if (or (> (EL:Get (EL:Get 'a pair) counts) 1) (> (EL:Get (EL:Get 'b pair) counts) 1))
      (progn
        (setq rejected (cons pair rejected))
        (foreach rec (list (car (EL:Get 'a pair)) (car (EL:Get 'b pair)))
          (setq issues (cons (EL:Issue 'ENDPOINT_OCCUPIED rec pair) issues))))))
  (setq temp base)
  (foreach pair good
    (if (not (member pair rejected))
      (setq temp (cons (EL:Edge (car (EL:Get 'a pair)) (car (EL:Get 'b pair))) temp))))
  (foreach seed seeds
    (setq component (EL:Component (EL:Get 'wire seed) temp) hits nil)
    (foreach rec seeds (if (member (EL:Get 'wire rec) component) (setq hits (cons (EL:Get 'id rec) hits))))
    (if (> (length hits) 1)
      (progn
        (foreach rec component (setq issues (cons (EL:Issue 'CIRCUIT_CONFLICT rec (EL:Unique hits)) issues)))
        (foreach pair good
          (if (member (car (EL:Get 'a pair)) component) (setq rejected (cons pair rejected)))))))
  (setq temp base)
  (foreach pair good
    (if (not (member pair rejected))
      (setq accepted (cons pair accepted) temp (cons (EL:Edge (car (EL:Get 'a pair)) (car (EL:Get 'b pair))) temp))))
  (list (cons 'pairs accepted) (cons 'edges (EL:Unique temp)) (cons 'issues (EL:Unique issues))))
(defun EL:LeaderConnections (snapshot cfg base / edges issues used pair a b valid block id rec)
  (setq edges base)
  (foreach pair (EL:Get 'leader-pairs cfg)
    (setq a (EL:By 'id (EL:Get 'a pair) (EL:Get 'blocks snapshot))
          b (EL:By 'id (EL:Get 'b pair) (EL:Get 'blocks snapshot)))
    (if (and a b (= (EL:Get 'role a) 'leader) (= (EL:Get 'role b) 'leader)
             (not (equal (EL:Get 'id a) (EL:Get 'id b)))
             (equal (EL:Get 'a-state pair) (EL:Get 'raw a)) (equal (EL:Get 'b-state pair) (EL:Get 'raw b))
             (not (member (EL:Get 'id a) used)) (not (member (EL:Get 'id b) used)))
      (progn
        (setq used (append used (list (EL:Get 'id a) (EL:Get 'id b)))
              edges (cons (EL:Edge (EL:Get 'id a) (EL:Get 'id b)) edges))
        (foreach rec (list a b)
          (if (/= (length (EL:Neighbours (EL:Get 'id rec) base)) 1)
            (setq issues (cons (EL:Issue 'LEADER_PORTS (EL:Get 'id rec) nil) issues)))))
      (foreach id (list (EL:Get 'a pair) (EL:Get 'b pair))
        (setq issues (cons (EL:Issue 'STALE_LEADER_PAIR id pair) issues)))))
  (foreach block (EL:Get 'blocks snapshot)
    (if (and (= (EL:Get 'role block) 'leader) (not (member (EL:Get 'id block) used)))
      (setq issues (cons (EL:Issue 'UNPAIRED_LEADER (EL:Get 'id block) nil) issues))))
  (list (cons 'edges (EL:Unique edges)) (cons 'issues issues)))
(defun EL:MergePairs (manual automatic / pairs issues claims pair key same)
  (setq pairs manual)
  (foreach pair manual (setq claims (append claims (list (EL:Get 'a pair) (EL:Get 'b pair)))))
  (foreach pair automatic
    (setq same (vl-some '(lambda (m) (or (and (equal (EL:Get 'a m) (EL:Get 'a pair)) (equal (EL:Get 'b m) (EL:Get 'b pair)))
      (and (equal (EL:Get 'b m) (EL:Get 'a pair)) (equal (EL:Get 'a m) (EL:Get 'b pair))))) manual))
    (cond (same nil)
          ((or (member (EL:Get 'a pair) claims) (member (EL:Get 'b pair) claims))
           (foreach key (list (EL:Get 'a pair) (EL:Get 'b pair))
             (setq issues (cons (EL:Issue 'ENDPOINT_OCCUPIED (car key) pair) issues))))
          (T (setq pairs (cons pair pairs)))))
  (list (cons 'pairs pairs) (cons 'issues issues)))
(defun EL:AnalyzeSnapshot (snapshot cfg panel seeds / physical leaders manual rows automatic merged checked issues resolved pair issue circuits circuit seed allobjects orphan portissues endrec)
  (setq physical (EL:BuildPhysical snapshot cfg panel) snapshot (EL:Get 'snapshot physical)
        leaders (EL:LeaderConnections snapshot cfg (EL:Get 'edges physical))
        manual (EL:LoadValidGapPairs cfg snapshot) rows (EL:FindGapCandidates snapshot cfg)
        automatic (EL:BuildMutualPairs rows snapshot cfg)
        merged (EL:MergePairs (EL:Get 'pairs manual) (EL:Get 'pairs automatic))
        checked (EL:ValidatePairSet snapshot cfg (EL:Get 'edges leaders) (EL:Get 'pairs merged) seeds)
        issues (append (EL:Get 'issues physical) (EL:Get 'issues leaders) (EL:Get 'issues manual)
          (EL:Get 'issues automatic) (EL:Get 'issues merged) (EL:Get 'issues checked)))
  (foreach pair (EL:Get 'pairs checked) (setq resolved (append resolved (list (EL:Get 'a pair) (EL:Get 'b pair)))))
  (setq issues (vl-remove-if '(lambda (i) (and (member (EL:Get 'code i)
      '(NO_CANDIDATE AMBIGUOUS_CANDIDATES NOT_MUTUALLY_UNIQUE UNSUPPORTED_END_GEOMETRY))
      (member (EL:Get 'key (EL:Get 'detail i)) resolved))) issues))
  (foreach seed seeds
    (setq circuit (EL:TraceCircuit seed snapshot (EL:Get 'edges checked) issues)
          circuits (cons circuit circuits) allobjects (append allobjects (EL:Get 'objects circuit))))
  (foreach issue (append issues (EL:Get 'issues snapshot))
    (if (not (member (EL:Get 'object issue) allobjects)) (setq orphan (cons issue orphan))))
  (foreach endrec (EL:Get 'ends snapshot)
    (if (and (member panel (EL:Get 'contacts endrec)) (EL:Get 'status endrec))
      (setq portissues (cons (EL:Issue 'PANEL_PORT_AMBIGUOUS (EL:Get 'wire endrec) endrec) portissues))))
  (list (cons 'drawing (EL:Get 'drawing cfg)) (cons 'panel panel) (cons 'snapshot snapshot) (cons 'rules (EL:RecognitionRules cfg))
        (cons 'config-revision (EL:Get 'revision cfg)) (cons 'circuits (reverse circuits))
        (cons 'connections (EL:Get 'pairs checked)) (cons 'candidates rows)
        (cons 'issues (append portissues issues)) (cons 'unrelated-issues (EL:Unique orphan))
        (cons 'complete (and seeds (not portissues) (not (vl-some '(lambda (c) (not (EL:Get 'complete c))) circuits))))))
(defun EL:BuildPhysical (snapshot cfg panel / ends out a b block contacts direct edges issues p tol ztol row other hit status)
  (setq ends (EL:Get 'ends snapshot) tol (EL:Get 'eps_touch (EL:Get 'params cfg)) ztol (EL:Get 'eps_z (EL:Get 'params cfg)))
  (foreach a ends
    (setq contacts nil direct nil p (EL:Get 'point a) status nil)
    (foreach block (EL:Get 'blocks snapshot)
      (if (EL:Touches p (EL:Get 'segments block) (EL:Get 'eps_boundary (EL:Get 'params cfg)))
        (setq contacts (cons (EL:Get 'id block) contacts))))
    (foreach b ends
      (if (and (not (equal (EL:Get 'wire a) (EL:Get 'wire b)))
               (EL:LayerAllowed (EL:Get 'layer a) (EL:Get 'layer b) cfg)
               (<= (abs (- (caddr p) (caddr (EL:Get 'point b)))) ztol)
               (<= (EL:Norm (EL:V- p (EL:Get 'point b))) tol)) (setq direct (cons (EL:Get 'key b) direct))))
    (cond ((> (+ (length contacts) (length direct)) 1) (setq status 'AMBIGUOUS_CONTACT))
          ((= (length contacts) 1)
           (setq block (EL:By 'id (car contacts) (EL:Get 'blocks snapshot)))
           (if (member (EL:Get 'role block) '(unknown ambiguous)) (setq status 'UNKNOWN_ROLE)))
          ((not direct)
           (foreach row (EL:Get 'wires snapshot)
             (if (not (equal (EL:Get 'id row) (EL:Get 'wire a)))
               (foreach hit (EL:Get 'segments row)
                 (if (and (<= (EL:PointSegmentDistance p (car hit) (cadr hit)) tol)
                          (not (vl-some '(lambda (endpoint) (<= (EL:Norm (EL:V- p (EL:Get 'point endpoint))) tol)) (EL:Get 'ends row))))
                   (setq status 'T_JUNCTION)))))))
    (if status (setq issues (cons (EL:Issue status (EL:Get 'wire a) (EL:Get 'key a)) issues)))
    (setq a (EL:Put 'contacts contacts a) a (EL:Put 'direct direct a)
          a (EL:Put 'occupied (or contacts direct status) a) a (EL:Put 'status status a))
    (if (and (= (length contacts) 1) (not status) (not (equal (car contacts) panel)))
      (setq edges (cons (EL:Edge (EL:Get 'wire a) (car contacts)) edges)))
    (setq out (cons a out)))
  (setq ends (reverse out))
  (foreach a ends
    (if (and (= (length (EL:Get 'direct a)) 1) (not (EL:Get 'status a)))
      (progn
        (setq b (EL:By 'key (car (EL:Get 'direct a)) ends))
        (if (and (= (length (EL:Get 'direct b)) 1) (not (EL:Get 'status b)))
          (setq edges (cons (EL:Edge (EL:Get 'wire a) (EL:Get 'wire b)) edges))
          (setq issues (cons (EL:Issue 'AMBIGUOUS_CONTACT (EL:Get 'wire a) (EL:Get 'key b)) issues))))))
  (list (cons 'snapshot (EL:Put 'ends ends snapshot)) (cons 'edges (EL:Unique edges)) (cons 'issues issues)))
(defun EL:BuildMutualPairs (rows snapshot cfg / pairs issues row cs target other rec a b state)
  (foreach row rows
    (setq a (EL:By 'key (EL:Get 'key row) (EL:Get 'ends snapshot)) cs (EL:Get 'candidates row))
    (if (not (EL:Get 'occupied a))
      (progn
        (setq state nil)
        (cond ((not (= (EL:Get 'geometry a) 'straight)) (setq state (EL:Get 'geometry a)))
              ((not cs) (setq state 'NO_CANDIDATE))
              ((> (length cs) 1) (setq state 'AMBIGUOUS_CANDIDATES))
              (T
               (setq target (EL:Get 'target (car cs)) other (EL:By 'key target rows))
               (if (and (= (length (EL:Get 'candidates other)) 1)
                        (equal (EL:Get 'target (car (EL:Get 'candidates other))) (EL:Get 'key row)))
                 (progn
                   (setq rec (list (cons 'a (EL:Get 'key row)) (cons 'b target) (cons 'source 'auto)
                     (cons 'metrics (car cs)) (cons 'params (EL:Get 'params cfg)) (cons 'signature (EL:Get 'signature snapshot))))
                   (if (not (vl-some '(lambda (pair) (and (equal (EL:Get 'a pair) target)
                          (equal (EL:Get 'b pair) (EL:Get 'key row)))) pairs)) (setq pairs (cons rec pairs))))
                 (setq state 'NOT_MUTUALLY_UNIQUE))))
        (if state (setq issues (cons (EL:Issue state (EL:Get 'wire a) row) issues))))))
  (list (cons 'pairs pairs) (cons 'issues issues)))
(defun EL:TraceCircuit (seed snapshot edges issues / queue visited devices wires problems step id parent neighbours next block endrec rec)
  (setq queue (list (list (EL:Get 'wire seed) nil)))
  (while queue
    (setq step (car queue) queue (cdr queue) id (car step) parent (cadr step))
    (if (not (member id visited))
      (progn
        (setq visited (cons id visited) block (EL:By 'id id (EL:Get 'blocks snapshot)))
        (if block
          (cond ((= (EL:Get 'role block) 'device) (setq devices (cons id devices)))
                ((= (EL:Get 'role block) 'panel) (setq problems (cons (EL:Issue 'OTHER_PANEL id nil) problems)))
                ((member (EL:Get 'role block) '(unknown ambiguous))
                 (setq problems (cons (EL:Issue 'UNKNOWN_ROLE id nil) problems))))
          (setq wires (cons id wires)))
        (setq neighbours (EL:Neighbours id edges))
        (if (> (length neighbours) 2) (setq problems (cons (EL:Issue 'ABNORMAL_BRANCH id neighbours) problems)))
        (foreach next neighbours
          (if (not (equal next parent))
            (if (member next visited) (setq problems (cons (EL:Issue 'CLOSED_CIRCUIT id next) problems))
              (setq queue (append queue (list (list next id))))))))))
  (foreach rec (append (EL:Get 'issues snapshot) issues)
    (if (member (EL:Get 'object rec) visited) (setq problems (cons rec problems))))
  (list (cons 'id (EL:Get 'id seed)) (cons 'seed seed) (cons 'wires (EL:Unique wires))
        (cons 'devices (EL:Unique devices)) (cons 'objects (EL:Unique visited))
        (cons 'issues (EL:Unique problems)) (cons 'complete (not problems))))
(princ)
