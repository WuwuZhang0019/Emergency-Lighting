;; Date: 2026-10-11. Read native Tianzheng circuit metadata; never write the plane.
(defun EL:NumberKey (text) (strcase (vl-string-trim " \t\r\n" text)))
(defun EL:NumberTextValid (text / code good)
  (setq good (and (equal (type text) 'STR) (/= text "")))
  (if good
    (progn
      (foreach code (vl-string->list text)
        (if (or (< code 32) (= code 127)) (setq good nil)))
      (if (vl-string-search "\\" text) (setq good nil)))) good)
(defun EL:NumberReadState (status values raw reason)
  (list (cons 'status status) (cons 'values values) (cons 'raw raw) (cons 'reason reason)))
(defun EL:ParseWireNumberDataImpl (data / row app item raw values keys text seen invalid)
  (foreach row data
    (if (and (listp row) (equal (car row) -3))
      (foreach app (cdr row)
        (if (and (listp app) (equal (type (car app)) 'STR) (equal (strcase (car app)) "LINENUM"))
          (progn
            (setq raw (cons app raw) seen nil)
            (foreach item (cdr app)
              (if (and (listp item) (equal (car item) 1000) (equal (type (cdr item)) 'STR))
                (progn
                  (setq seen T text (vl-string-trim " \t\r\n" (cdr item)))
                  (if (/= text "")
                    (if (EL:NumberTextValid text)
                      (if (not (member (EL:NumberKey text) keys))
                        (setq keys (cons (EL:NumberKey text) keys) values (cons text values)))
                      (setq invalid T))))
                (setq invalid T)))
            (if (not seen) (setq invalid T)))))))
  (EL:NumberReadState (cond (invalid 'invalid) ((> (length values) 1) 'conflict)
    (values 'ready) (T 'missing)) (reverse values) (reverse raw)
    (if invalid 'MALFORMED_LINENUM)))
(defun EL:ParseWireNumberData (data / checked)
  (setq checked (vl-catch-all-apply 'EL:ParseWireNumberDataImpl (list data)))
  (if (vl-catch-all-error-p checked)
    (EL:NumberReadState 'invalid nil nil 'MALFORMED_XDATA) checked))
(defun EL:ReadWireNumberData (handle / entity checked data state)
  (setq checked (vl-catch-all-apply 'handent (list handle)))
  (if (or (vl-catch-all-error-p checked) (not checked))
    (setq state (EL:NumberReadState 'invalid nil nil 'MISSING_SOURCE_WIRE))
    (progn
      (setq entity checked checked (vl-catch-all-apply 'entget (list entity '("linenum"))))
      (cond ((vl-catch-all-error-p checked)
          (setq state (EL:NumberReadState 'invalid nil nil 'READ_FAILED)))
        ((not checked) (setq state (EL:NumberReadState 'invalid nil nil 'MISSING_SOURCE_WIRE)))
        ((not (member (cdr (assoc 0 checked)) '("LINE" "LWPOLYLINE")))
          (setq state (EL:NumberReadState 'invalid nil nil 'NOT_A_SOURCE_WIRE)))
        (T (setq state (EL:ParseWireNumberData checked))))))
  (EL:Put 'handle handle state))
(princ)
