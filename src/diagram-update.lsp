;; Date: 2026-10-10. Differential updates. Never infer identity from row labels.
(defun EL:Require (condition message)
  ;; Date: 2026-10-10. Preserve validation reason before exit becomes a generic abort.
  (if (not condition) (progn (EL:LogEvent "VALIDATION_FAILED" (list (cons 'message message)))
    (princ (strcat "\n" message)) (exit))) T)
(defun EL:ActualRows (record)
  (vl-remove-if '(lambda (r) (equal (EL:Get 'mode r) 'reserve)) (EL:Get 'rows record)))
(defun EL:SameStructure (record plan)
  (equal (mapcar '(lambda (r) (EL:Get 'circuit-uid r)) (EL:Get 'rows record))
    (mapcar '(lambda (r) (EL:Get 'circuit-uid r)) (EL:Get 'rows plan))))
(defun EL:TextPoint (e / d)
  (setq d (entget e))
  (if (and (= (cond ((cdr (assoc 72 d))) (T 0)) 0) (= (cond ((cdr (assoc 73 d))) (T 0)) 0))
    (cdr (assoc 10 d)) (cdr (assoc 11 d))))
(defun EL:RebasePoint (point oldplan transform / v angle scale)
  (setq v (EL:V- point (EL:Get 'position oldplan)) angle (- (EL:Get 'rotation transform) (EL:Get 'rotation oldplan))
    scale (/ (EL:Get 'scale transform) (EL:Get 'scale oldplan)))
  (EL:LocalPoint v (EL:Get 'position transform) angle scale))
(defun EL:OutputState (handle store record kind uid / entity data state)
  (setq entity (if (equal (type handle) 'STR) (handent handle)) data (if entity (entget entity))
    state (cond ((not data) 'missing)
      ((not (EL:OwnedEntity handle store record kind uid)) 'ownership-mismatch)
      ((not (equal (cdr (assoc 410 data)) "Model")) 'not-model)
      ((not (EL:Writable entity)) 'locked-layer) (T 'ready)))
  (EL:LogEvent "DIAGRAM_OUTPUT_CHECK" (list (cons 'handle handle) (cons 'kind kind) (cons 'uid uid)
    (cons 'state state) (cons 'layer (cdr (assoc 8 data))) (cons 'layout (cdr (assoc 410 data))))) state)
(defun EL:CheckLayout (record store / panel transform oldplan changed conflict row e expected state)
  (setq state (EL:OutputState (EL:Get 'panel-output-handle record) store record "panel" "panel"))
  (EL:Require (equal state 'ready)
    (cond ((equal state 'missing) "系统图箱体已删除，请点击生成或更新重新放置。")
      ((equal state 'ownership-mismatch) "系统图箱体关联已改变，未修改现有对象；请查看 DIAGRAM_OUTPUT_CHECK。")
      ((equal state 'not-model) "系统图箱体不在模型空间，未更新。")
      (T "系统图箱体所在图层锁定或不可写，请解锁后更新。")))
  (setq panel (EL:OwnedEntity (EL:Get 'panel-output-handle record) store record "panel" "panel"))
  (setq transform (EL:DiagramTransform panel) oldplan (EL:Get 'plan record))
  (EL:Require transform "仅支持模型空间、正等比缩放和 WCS Z 轴旋转。")
  (setq changed (not (and (equal (EL:Get 'position transform) (EL:Get 'position oldplan) 1.0e-6)
    (equal (EL:Get 'rotation transform) (EL:Get 'rotation oldplan) 1.0e-8)
    (equal (EL:Get 'scale transform) (EL:Get 'scale oldplan) 1.0e-8))))
  (foreach row (EL:Get 'rows record)
    (setq e (EL:OwnedEntity (EL:Get 'block-handle row) store record "circuit" (EL:Get 'circuit-uid row)))
    (EL:Require (and e (EL:Writable e) (EL:DiagramTransform e)) "回路块缺失、被替换、锁层或变换不受支持；未更新。")
    (setq expected (EL:RebasePoint (EL:Get 'position row) oldplan transform))
    (if (not (and (equal (cdr (assoc 10 (entget e))) expected 1.0e-5)
        (equal (EL:Get 'scale (EL:DiagramTransform e)) (EL:Get 'scale transform) 1.0e-8)
        (equal (EL:Get 'rotation (EL:DiagramTransform e)) (EL:Get 'rotation transform) 1.0e-8))) (setq conflict T))
    (if (EL:Get 'text-handle row)
      (progn
        (setq e (handent (EL:Get 'text-handle row)))
        (if e
          (progn
            (EL:Require (and (EL:OwnedEntity (EL:Get 'text-handle row) store record "text" (EL:Get 'circuit-uid row))
              (EL:Writable e)) "文字关联失配或锁层，未更新。")
            (if (and (EL:Get 'text-position row)
                (not (equal (EL:TextPoint e) (EL:RebasePoint (EL:Get 'text-position row) oldplan transform) 1.0e-5)))
              (setq conflict T)))))))
  (if (EL:CCKKLabelsConflict record store transform) (setq conflict T))
  (EL:Require (not (and changed conflict)) "箱体与成员未保持整体变换；请恢复整体关系后更新。")
  (EL:Put 'layout-conflict conflict transform))
(defun EL:DynamicUpdate (e property value / obj before prop)
  (setq obj (vlax-ename->vla-object e) before (cdr (assoc 10 (entget e))) prop (EL:DynamicProperty obj property))
  (EL:Require prop "动态属性不存在。")
  (if (not (equal (vlax-variant-value (vla-get-Value prop)) value))
    (EL:Require (EL:SetDynamicValue obj property value) "动态属性写入或回读失败。"))
  (EL:Require (equal before (cdr (assoc 10 (entget e))) 1.0e-6) "动态状态切换导致基点漂移。"))
(defun EL:MoveManaged (e point / obj current delta)
  (setq obj (vlax-ename->vla-object e) current (if (equal (cdr (assoc 0 (entget e))) "TEXT") (EL:TextPoint e)
    (cdr (assoc 10 (entget e)))))
  (if (not (equal current point 1.0e-6))
    (EL:PerfWrite 'vla-Move (list obj (vlax-3d-point current) (vlax-3d-point point)))))
;; Date: 2026-10-11. Read actual owned output before forming the write set.
;; Stable UIDs select members; record positions remain the manual-layout baseline.
(defun EL:UpdateEntity (handle store record kind uid required / e owned)
  (setq e (if (equal (type handle) 'STR) (handent handle))
    owned (EL:OwnedEntity handle store record kind uid))
  (EL:Require (or (not e) owned) "系统图关联失配，未覆盖外来对象。")
  (EL:Require (or (not required) owned) "系统图成员缺失，未执行增量更新。")
  (EL:Require (or (not owned) (EL:Writable owned)) "系统图成员锁层或不可写，未执行增量更新。") owned)
(defun EL:UpdateOperation (action kind uid handle property before after reason dependencies)
  (list (cons 'action action) (cons 'kind kind) (cons 'uid uid) (cons 'handle handle)
    (cons 'property property) (cons 'before before) (cons 'after after)
    (cons 'reason reason) (cons 'depends-on dependencies)))
(defun EL:UpdateProperty (kind uid e property before after reason dependencies / same)
  (setq same (if (equal property 'position) (equal before after 1.0e-6) (equal before after)))
  (if (not same) (EL:UpdateOperation 'modify kind uid (cdr (assoc 5 (entget e))) property
    before after reason dependencies)))
(defun EL:UpdateDynamic (kind uid e definition value reason / property operation)
  (setq property (EL:DynamicProperty (vlax-ename->vla-object e) (EL:Get 'property definition)))
  (EL:Require property "动态属性不存在，未执行增量更新。")
  (setq operation (EL:UpdateProperty kind uid e 'dynamic (vlax-variant-value (vla-get-Value property)) value reason nil))
  (if operation (EL:Put 'dynamic-property (EL:Get 'property definition) operation)))
(defun EL:LabelDependencies (label)
  (list (cond ((EL:Get 'parent-uid label)) (T "panel"))))
(defun EL:UpdateBusinessUnchanged (record result template plan / good row old circuit key)
  (setq good (and (equal template (EL:Get 'template record))
    (equal (EL:Get 'excluded-devices record) (EL:Get 'excluded-devices result))
    (equal (EL:Get 'block-ground record) (EL:Get 'block-ground result))
    (equal (EL:Get 'candidate-keys record) (EL:Get 'candidate-keys result))
    (equal (EL:Get 'excluded-seeds record) (EL:Get 'excluded-seeds result))
    (equal (EL:PanelNumber record) (EL:PanelNumber result))
    (not (EL:Get 'draft-circuits record)) (equal (EL:Get 'status record) 'current)
    (EL:SameStructure record plan)
    (equal (cond ((EL:Get 'capacity-source record)) (T 'default))
      (cond ((EL:Get 'capacity-source result)) (T 'default)))
    (equal (EL:Get 'capacity-option record) (EL:Get 'capacity plan))
    (equal (EL:Get 'source-signature record) (EL:Get 'signature (EL:Get 'snapshot result)))
    (equal (EL:Get 'power-signature record) (EL:Signature (EL:Get 'power-config result)))
    (equal (EL:Get 'plan record) plan)))
  (foreach row (EL:Get 'rows plan)
    (setq old (EL:By 'circuit-uid (EL:Get 'circuit-uid row) (EL:Get 'rows record))
      circuit (EL:By 'circuit-uid (EL:Get 'circuit-uid row) (EL:Get 'circuits result)))
    (foreach key '(mode value watts)
      (if (not (equal (EL:Get key old) (EL:Get key row))) (setq good nil)))
    (foreach key '(seed-key id output-order is-ground ground-source ground-rule ground-evidence)
      (if (not (equal (EL:Get key old) (EL:Get key circuit))) (setq good nil)))) good)
(defun EL:UpdateOperations (result template plan record store structural / operations unchanged e row old uid before op count textentity label labels previous kind)
  (setq e (EL:UpdateEntity (EL:Get 'panel-output-handle record) store record "panel" "panel" T))
  (foreach op (list
      (EL:UpdateProperty "panel" "panel" e 'layer (cdr (assoc 8 (entget e))) (EL:Get 'layer template) 'template-layer nil)
      (EL:UpdateDynamic "panel" "panel" e (EL:Get 'panel template) (EL:Get 'panel-value plan) 'capacity))
    (if op (setq operations (cons op operations))))
  (if (not operations) (setq unchanged (list (list "panel" "panel" (EL:Get 'panel-output-handle record)))))
  (foreach row (EL:Get 'rows plan)
    (setq uid (EL:Get 'circuit-uid row) old (EL:By 'circuit-uid uid (EL:Get 'rows record)) count (length operations))
    (if old
      (progn
        (setq e (EL:UpdateEntity (EL:Get 'block-handle old) store record "circuit" uid T))
        (foreach op (list
            (EL:UpdateProperty "circuit" uid e 'layer (cdr (assoc 8 (entget e))) (EL:Get 'layer template) 'template-layer nil)
            (EL:UpdateDynamic "circuit" uid e (EL:Get 'circuit template) (EL:Get 'value row) 'circuit-type)
            (if structural (EL:UpdateProperty "circuit" uid e 'position (cdr (assoc 10 (entget e)))
              (EL:Get 'position row) 'layout (list uid))))
          (if op (setq operations (cons op operations))))
        (if (= count (length operations))
          (setq unchanged (cons (list "circuit" uid (EL:Get 'block-handle old)) unchanged))))
      (setq operations (cons (EL:UpdateOperation 'create "circuit" uid nil 'entity nil
        (list (cons 'name (EL:Get 'name (EL:Get 'circuit template)))
          (cons 'position (EL:Get 'position row)) (cons 'dynamic (EL:Get 'value row))
          (cons 'dynamic-property (EL:Get 'property (EL:Get 'circuit template)))) 'new-circuit nil) operations)))
    (setq textentity (if old (EL:UpdateEntity (EL:Get 'text-handle old) store record "text" uid nil))
      count (length operations))
    (cond
      ((and textentity (EL:Get 'text row) (EL:Get 'cckk-layout plan)
          (not (EL:Get 'cckk-layout (EL:Get 'plan record))))
        (setq operations (cons (EL:UpdateOperation 'replace "text" uid (EL:Get 'text-handle old) 'entity
          (cdr (assoc 1 (entget textentity))) (EL:Get 'text row) 'native-power-format (list uid)) operations)))
      ((and textentity (EL:Get 'text row))
        (foreach op (list
            (EL:UpdateProperty "text" uid textentity 'text (cdr (assoc 1 (entget textentity)))
              (EL:Get 'text row) 'circuit-power (list uid))
            (if structural (EL:UpdateProperty "text" uid textentity 'position (EL:TextPoint textentity)
              (EL:Get 'text-position row) 'layout (list uid))))
          (if op (setq operations (cons op operations)))))
      ((EL:Get 'text row)
        (setq operations (cons (EL:UpdateOperation 'create "text" uid nil 'entity nil
          (EL:Get 'text row) (if old 'missing-power-text 'new-circuit-power) (list uid)) operations)))
      (textentity (setq operations (cons (EL:UpdateOperation 'delete "text" uid (EL:Get 'text-handle old)
        'entity (cdr (assoc 1 (entget textentity))) nil 'reserve-has-no-power (list uid)) operations))))
    (if (and textentity (= count (length operations)))
      (setq unchanged (cons (list "text" uid (EL:Get 'text-handle old)) unchanged))))
  (foreach old (EL:Get 'rows record)
    (setq uid (EL:Get 'circuit-uid old))
    (if (not (EL:By 'circuit-uid uid (EL:Get 'rows plan)))
      (foreach kind '("circuit" "text")
        (setq e (EL:UpdateEntity (EL:Get (if (equal kind "circuit") 'block-handle 'text-handle) old)
          store record kind uid (equal kind "circuit")))
        (if e (setq operations (cons (EL:UpdateOperation 'delete kind uid (cdr (assoc 5 (entget e)))
          'entity (if (equal kind "text") (cdr (assoc 1 (entget e))) (EL:Get 'value old)) nil
          'removed-circuit (list uid)) operations))))))
  (setq labels (EL:CCKKLabels plan))
  (foreach label labels
    (setq uid (EL:Get 'uid label) old (EL:By 'uid uid (EL:Get 'cckk-labels record))
      e (if old (EL:CCKKLabelEntity old record store)) count (length operations))
    (cond
      ((not e) (setq operations (cons (EL:UpdateOperation 'create "label" uid nil 'entity nil
        (EL:Get 'text label) 'missing-caption (EL:LabelDependencies label)) operations)))
      ((or (not (equal (EL:Get 'cckk-text-version old) 1))
          (not (EL:CCKKLabelMatches e (EL:Put 'text (cdr (assoc 1 (entget e))) label) plan)))
        (setq operations (cons (EL:UpdateOperation 'replace "label" uid (EL:Get 'handle old) 'entity
          (EL:Get 'cckk-text-version old) 1 'native-caption-format (EL:LabelDependencies label)) operations)))
      (T (foreach op (list
            (EL:UpdateProperty "label" uid e 'text (cdr (assoc 1 (entget e))) (EL:Get 'text label)
              'caption-text (EL:LabelDependencies label))
            (if structural (EL:UpdateProperty "label" uid e 'position (EL:TextPoint e)
              (EL:Get 'text-position label) 'layout (EL:LabelDependencies label))))
          (if op (setq operations (cons op operations))))))
    (if (and e (= count (length operations))) (setq unchanged (cons (list "label" uid (EL:Get 'handle old)) unchanged))))
  (foreach old (EL:Get 'cckk-labels record)
    (if (and (not (EL:By 'uid (EL:Get 'uid old) labels)) (setq e (EL:CCKKLabelEntity old record store)))
      (setq operations (cons (EL:UpdateOperation 'delete "label" (EL:Get 'uid old) (EL:Get 'handle old)
        'entity (EL:Get 'text old) nil 'removed-caption (EL:LabelDependencies old)) operations))))
  (setq operations (reverse operations))
  (if (not *EL:UpdateReadback*)
    (progn
      (EL:PerfSet "incremental-operations" (length operations))
      (EL:PerfSet "incremental-unchanged" (length unchanged))
      (foreach kind '(create modify delete replace)
        (EL:PerfSet (strcat "incremental-" (strcase (vl-symbol-name kind) T))
          (length (vl-remove-if-not '(lambda (op) (equal (EL:Get 'action op) kind)) operations))))))
  (list (cons 'operations operations) (cons 'unchanged (reverse unchanged))
    (cons 'record-changed (not (EL:UpdateBusinessUnchanged record result template plan)))
    (cons 'diagram-id (EL:Get 'diagram-id record)) (cons 'structural structural)
    (cons 'epoch *EL:FreshEpoch*)
    (cons 'target-plan plan)))
(defun EL:UpdateHas (changes kind uid property / found op)
  (foreach op (EL:Get 'operations changes)
    (if (and (equal (EL:Get 'kind op) kind) (equal (EL:Get 'uid op) uid)
        (equal (EL:Get 'property op) property)) (setq found op))) found)
(defun EL:VerifyUpdate (result template plan record store structural changes / *EL:UpdateReadback* remaining op e)
  ;; Native writes can fire reactors. A final read-only check catches changed
  ;; targets outside the initial write set; never keep retrying a moving target.
  (setq *EL:UpdateReadback* T
    remaining (EL:UpdateOperations result template plan record store structural))
  (EL:Require (not (EL:Get 'operations remaining)) "增量更新后实际属性回读不符，撤销本次更新。")
  (foreach op (EL:Get 'operations changes)
    (if (member (EL:Get 'action op) '(delete replace))
      (progn
        (setq e (handent (EL:Get 'handle op)))
        (EL:Require (or (not e) (not (entget e))) "增量更新旧成员未删除，撤销本次更新。")))) T)
(defun EL:ApplyUpdate (result template plan record store structural / doc space panel row old e textentity handles h newrows removed key changes op basis)
  ;; The transaction start is an unknown callback boundary. Re-read actual
  ;; attributes if that boundary advanced; business comparison uses the last
  ;; saved record, not SyncDiagram's already-updated timestamp/configuration.
  (setq basis (cond ((EL:By 'diagram-id (EL:Get 'diagram-id record) (EL:Get 'diagrams store))) (T record)))
  (setq changes (if (and *EL:UpdateScopeActive* *EL:UpdateOperations*
      (equal (EL:Get 'diagram-id *EL:UpdateOperations*) (EL:Get 'diagram-id record))
      (equal (EL:Get 'structural *EL:UpdateOperations*) structural)
      (equal (EL:Get 'epoch *EL:UpdateOperations*) *EL:FreshEpoch*)
      (equal (EL:Get 'target-plan *EL:UpdateOperations*) plan)) *EL:UpdateOperations*
      (EL:UpdateOperations result template plan basis store structural)))
  (if (not (equal basis record)) (setq changes (EL:Put 'record-changed T changes)))
  (setq
    *EL:LastUpdateOperations* changes)
  (foreach op (EL:Get 'operations changes) (EL:LogEvent "INCREMENTAL_OPERATION" op))
  (setq doc (vla-get-ActiveDocument (vlax-get-acad-object)) space (vla-get-ModelSpace doc)
    panel (EL:OwnedEntity (EL:Get 'panel-output-handle record) store record "panel" "panel"))
  (if (not (tblsearch "LAYER" (EL:Get 'layer template)))
    (vla-Add (vla-get-Layers doc) (EL:Get 'layer template)))
  (if (EL:UpdateHas changes "panel" "panel" 'layer)
    (EL:PerfWrite 'vla-put-Layer (list (vlax-ename->vla-object panel) (EL:Get 'layer template))))
  (if (EL:UpdateHas changes "panel" "panel" 'dynamic)
    (EL:DynamicUpdate panel (EL:Get 'property (EL:Get 'panel template)) (EL:Get 'panel-value plan)))
  (foreach row (EL:Get 'rows plan)
    (setq key (EL:Get 'circuit-uid row) old (EL:By 'circuit-uid key (EL:Get 'rows record)))
    (EL:LogEvent "CCKK_ROW_UPDATE_BEGIN" (list (cons 'uid key) (cons 'existing (if old T nil))
      (cons 'watts (EL:Get 'watts row)) (cons 'position (EL:Get 'position row))))
    (if old
      (progn
        (setq e (EL:OwnedEntity (EL:Get 'block-handle old) store record "circuit" key))
        (if (EL:UpdateHas changes "circuit" key 'layer)
          (EL:PerfWrite 'vla-put-Layer (list (vlax-ename->vla-object e) (EL:Get 'layer template))))
        (if (EL:UpdateHas changes "circuit" key 'dynamic)
          (EL:DynamicUpdate e (EL:Get 'property (EL:Get 'circuit template)) (EL:Get 'value row)))
        (if (EL:UpdateHas changes "circuit" key 'position) (EL:MoveManaged e (EL:Get 'position row)))
        (setq h (list (cons 'circuit-uid key) (cons 'block-handle (EL:Get 'block-handle old)))))
      (progn
        (setq e (EL:CreateBlock space (EL:Get 'name (EL:Get 'circuit template)) (EL:Get 'position row)
          (EL:Get 'scale plan) (EL:Get 'rotation plan) (EL:Get 'property (EL:Get 'circuit template))
          (EL:Get 'value row) (EL:Get 'layer template)))
        (setq h (list (cons 'circuit-uid key) (cons 'block-handle (EL:TagEntity e store record "circuit" key))))))
    (setq textentity (if old (EL:OwnedEntity (EL:Get 'text-handle old) store record "text" key)))
    (if (and textentity (EL:Get 'cckk-layout plan) (not (EL:Get 'cckk-layout (EL:Get 'plan record))))
      (progn (EL:Require (EL:PerfWrite 'entdel (list textentity)) "旧版功率文字替换失败。") (setq textentity nil)))
    (if (EL:Get 'text row)
      (progn
        (if textentity
          (progn
            (if (EL:UpdateHas changes "text" key 'text)
              (EL:PerfWrite 'vla-put-TextString (list (vlax-ename->vla-object textentity) (EL:Get 'text row))))
            (if (EL:UpdateHas changes "text" key 'position) (EL:MoveManaged textentity (EL:Get 'text-position row)))
            (setq h (EL:Put 'text-handle (EL:Get 'text-handle old) h)))
          (setq h (EL:Put 'text-handle (EL:TagEntity (EL:CreatePowerAnnotation space row plan
              (EL:Get 'layer template) (handent (EL:Get 'block-handle h)))
            store record "text" key) h))))
      ;; Legacy reserve text is deleted only after ownership verification.
      (if textentity (EL:Require (EL:PerfWrite 'entdel (list textentity)) "无法删除旧预留文字。")))
    (setq handles (cons h handles))
    (EL:LogEvent "CCKK_ROW_UPDATED" h))
  (foreach old (EL:Get 'rows record)
    (if (not (EL:By 'circuit-uid (EL:Get 'circuit-uid old) (EL:Get 'rows plan)))
      (progn
        (setq e (EL:OwnedEntity (EL:Get 'block-handle old) store record "circuit" (EL:Get 'circuit-uid old))
          textentity (EL:OwnedEntity (EL:Get 'text-handle old) store record "text" (EL:Get 'circuit-uid old)))
        (EL:Require (EL:PerfWrite 'entdel (list e)) "删除旧回路失败。")
        (if textentity (EL:Require (EL:PerfWrite 'entdel (list textentity)) "删除旧功率文字失败。")))))
  (setq newrows (EL:RecordRows result plan handles))
  ;; Preserve managed layout baselines on power-only changes. Manual offsets
  ;; remain detectable on a later structural update instead of being blessed.
  (if (not structural)
    (setq newrows (mapcar '(lambda (r)
      (setq old (EL:By 'circuit-uid (EL:Get 'circuit-uid r) (EL:Get 'rows record)))
      (if old (EL:Put 'position (EL:RebasePoint (EL:Get 'position old) (EL:Get 'plan record) plan)
        (EL:Put 'text-position (if (EL:Get 'text-position old)
          (EL:RebasePoint (EL:Get 'text-position old) (EL:Get 'plan record) plan)) r)) r)) newrows)))
  (setq record (EL:Put 'rows newrows record))
  (setq record (EL:SyncCCKKLabels plan record store structural))
  (setq record (EL:Put 'plan plan record))
  (EL:VerifyUpdate result template plan record store structural changes)
  (if (or (EL:Get 'operations changes) (EL:Get 'record-changed changes))
    (EL:StoreWrite (EL:StorePutDiagram record store))) record)
(defun EL:MarkStale (panel reason / store record)
  (if (and panel (setq store (EL:StoreRead)) (setq record (EL:DiagramForPanel panel store)))
    (progn
      (setq record (EL:Put 'status 'stale (EL:Put 'stale-reason reason record)))
      (EL:Transaction 'EL:StoreWrite (list (EL:StorePutDiagram record store)))
      (princ "\n原系统图未更新，仍为上次结果。"))) nil)
(defun EL:NewRecord (panel store / id prefix serial)
  ;; HANDSEED is not a portable GETVAR string. Allocate within this DWG store.
  (EL:Require (and (equal (type panel) 'STR) (/= panel "")
    (equal (type (EL:Get 'drawing-uuid store)) 'STR) (/= (EL:Get 'drawing-uuid store) ""))
    "无法建立系统图身份：图纸标识或来源箱体句柄为空。")
  (setq prefix (strcat (EL:Get 'drawing-uuid store) "/" panel "/") serial 1
    id (strcat prefix (itoa serial)))
  (while (EL:By 'diagram-id id (EL:Get 'diagrams store))
    (setq serial (1+ serial) id (strcat prefix (itoa serial))))
  (list (cons 'diagram-id id) (cons 'source-panel-handle panel) '(capacity-option . cap300) '(capacity-source . default)
    '(template-version . 1) '(status . unverified)))
(defun EL:RecognizeFixed (cfg panel / snapshot network result record keys perf)
  (setq perf (EL:PerfBegin "RECOGNIZE_FIXED_RUN"))
  (EL:PerfCount "recognize-fixed-calls" 1)
  (EL:Require (and (handent panel) (not (EL:ManagedEntity (handent panel)))) "来源配电箱缺失或为受管输出。")
  (setq snapshot (EL:LogCall "SIMPLE_COLLECT" (list (cons 'panel panel)) 'EL:SimpleCollect (list cfg))
    snapshot (if (EL:Get 'concentrated-trunk cfg) (EL:TrunkSnapshot snapshot cfg panel) snapshot)
    network (EL:LogCall "SIMPLE_NETWORK" (list (cons 'panel panel) (cons 'wires (length (EL:Get 'wires snapshot)))
      (cons 'blocks (length (EL:Get 'blocks snapshot)))) 'EL:SimpleNetwork (list snapshot cfg panel)))
  (setq result (EL:SelectFixedExits (EL:LogCall "SPLIT_NETWORK" (list (cons 'panel panel)) 'EL:SplitNetwork (list network cfg)) nil))
  (EL:PerfSet "wire-count" (length (EL:Get 'wires snapshot)))
  (EL:PerfSet "block-count" (length (EL:Get 'blocks snapshot)))
  (EL:PerfEnd perf 'returned) result)
(defun EL:FixedFreshSnapshot (cfg panel / snapshot network)
  ;; Date: 2026-10-11. Identical collect/network/CircuitSnapshot signature,
  ;; without tracing circuits or selecting exits just to compare the source.
  (EL:Require (and (handent panel) (not (EL:ManagedEntity (handent panel)))) "来源配电箱缺失或为受管输出。")
  (EL:PerfCount "freshness-scan-calls" 1)
  (setq snapshot (EL:LogCall "SIMPLE_COLLECT" nil 'EL:SimpleCollect (list cfg))
    snapshot (if (EL:Get 'concentrated-trunk cfg) (EL:TrunkSnapshot snapshot cfg panel) snapshot)
    network (EL:LogCall "SIMPLE_NETWORK" nil 'EL:SimpleNetwork (list snapshot cfg panel)))
  (EL:CircuitSnapshot (EL:Get 'snapshot network) panel))
(defun EL:FreshResult (result cfg / fresh key good)
  (setq key (list (EL:Get 'drawing cfg) (getvar "DWGNAME") (getvar "DWGPREFIX")
    (EL:Get 'panel result) (EL:RecognitionRules cfg)
    (EL:Get 'signature (EL:Get 'snapshot result)) *EL:FreshEpoch*))
  (if (and *EL:FreshScopeEnabled* (equal (EL:Get 'engine result) 'fixed)
      *EL:FreshScope* (equal key (car *EL:FreshScope*)))
    (progn (EL:PerfCount "freshness-reuses" 1) (setq fresh (cadr *EL:FreshScope*)))
    (setq fresh (if (equal (EL:Get 'engine result) 'fixed)
      (EL:PerfCall "FRESH_SOURCE_SCAN" 'EL:FixedFreshSnapshot (list cfg (EL:Get 'panel result)))
      (EL:CollectEndpointSnapshot cfg))))
  (setq good (EL:LogCall "COMPARE_SOURCE" nil 'EL:SourceCurrent (list result cfg fresh)))
  (if (and good *EL:FreshScopeEnabled* (equal (EL:Get 'engine result) 'fixed))
    (setq *EL:FreshScope* (list key fresh))
    (setq *EL:FreshScope* nil)) good)
(defun EL:PreparedResult (result record / matched rows c edited key)
  ;; Date: 2026-10-11. Restore the saved number without overwriting a new pick.
  (if (not (assoc 'panel-number result))
    (setq result (EL:Put 'panel-number (EL:PanelNumber record) result)))
  ;; Date: 2026-10-10. Restore explicit per-block ground choices.
  (if (and (not (assoc 'block-ground result)) (assoc 'block-ground record))
    (setq result (EL:Put 'block-ground (EL:Get 'block-ground record) result)))
  (if (and (not (assoc 'excluded-devices result)) (assoc 'excluded-devices record))
    (setq result (EL:Put 'excluded-devices (EL:Get 'excluded-devices record) result)))
  (setq matched (EL:MatchCircuits (EL:Get 'circuits result) (EL:ActualRows record) (EL:Get 'diagram-id record)))
  (foreach c (EL:Get 'circuits matched)
    (setq edited (EL:By 'circuit-uid (EL:Get 'circuit-uid c) (EL:Get 'circuits result)))
    (if edited
      (foreach key '(is-ground ground-source ground-rule ground-evidence)
        (setq c (EL:Put key (EL:Get key edited) c))))
    (setq rows (cons c rows)))
  (if (not (EL:Get 'capacity-source result))
    (setq result (EL:Put 'capacity-source
      (cond ((if (EL:Get 'draft-circuits record) (EL:Get 'draft-capacity-source record) (EL:Get 'capacity-source record)))
        (T 'default)) result)))
  (EL:ResolveCircuitNumbers
    (EL:Put 'identity-ambiguous (EL:Get 'ambiguous matched) (EL:Put 'circuits (reverse rows) result))))
(defun EL:ConfirmRemoved (result record / old c)
  (princ "\n出线种子身份发生变化。旧回路：")
  (foreach old (EL:ActualRows record)
    (if (not (EL:By 'seed-key (EL:Get 'seed-key old) (EL:Get 'circuits result)))
      (princ (strcat "\n  删除 " (EL:Get 'circuit-uid old) " " (vl-prin1-to-string (EL:Get 'seed-key old))))))
  (princ "\n本次实际回路：")
  (foreach c (EL:Get 'circuits result) (princ (strcat "\n  " (EL:Get 'id c) " " (vl-prin1-to-string (EL:Get 'seed-key c)))))
  (initget "Replace Cancel")
  (equal (EL:PerfInput 'getkword (list "\n确认将失去种子的旧回路删除，新种子作为新回路？[Replace/Cancel] <Cancel>：")) "Replace"))
(defun EL:CheckDynamicTarget (entity definition value / obj prop)
  (EL:Require (equal (EL:EffectiveName entity) (EL:Get 'name definition)) "关联图块有效名称已改变，需修复。")
  (setq obj (vlax-ename->vla-object entity) prop (EL:DynamicProperty obj (EL:Get 'property definition)))
  (EL:Require (and prop (= (vla-get-ReadOnly prop) :vlax-false) (member value (EL:AllowedValues prop)))
    "输出对象动态属性已改变、只读或不支持目标档位。"))
(defun EL:UpdatePreflight (record store template plan / e old row)
  (setq e (EL:OwnedEntity (EL:Get 'panel-output-handle record) store record "panel" "panel"))
  (EL:CheckDynamicTarget e (EL:Get 'panel template) (EL:Get 'panel-value plan))
  (foreach old (EL:Get 'rows record)
    (setq e (EL:OwnedEntity (EL:Get 'block-handle old) store record "circuit" (EL:Get 'circuit-uid old))
      row (EL:By 'circuit-uid (EL:Get 'circuit-uid old) (EL:Get 'rows plan)))
    (EL:CheckDynamicTarget e (EL:Get 'circuit template) (if row (EL:Get 'value row) (EL:Get 'value old)))) T)
(defun EL:DiagramUnchanged (record result plan store / structural)
  ;; Date: 2026-10-11. Reuse this exact read-only set inside the later transaction.
  (setq structural (or (not (EL:SameStructure record plan))
      (not (EL:Get 'cckk-layout (EL:Get 'plan record))))
    *EL:UpdateOperations* (EL:UpdateOperations result (EL:Get 'template record) plan record store structural)
    *EL:LastUpdateOperations* *EL:UpdateOperations*)
  (and (not (EL:Get 'operations *EL:UpdateOperations*))
    (not (EL:Get 'record-changed *EL:UpdateOperations*))))
;; Date: 2026-10-10. Locate committed output, including all rows and captions.
;; This is presentation only: a failed zoom must not invalidate a saved diagram.
(defun EL:DiagramOutputRefs (record / refs row label)
  (setq refs (list (list (EL:Get 'panel-output-handle record) "panel" "panel")))
  (foreach row (EL:Get 'rows record)
    (setq refs (cons (list (EL:Get 'block-handle row) "circuit" (EL:Get 'circuit-uid row)) refs))
    (if (EL:Get 'text-handle row)
      (setq refs (cons (list (EL:Get 'text-handle row) "text" (EL:Get 'circuit-uid row)) refs))))
  (foreach label (EL:Get 'cckk-labels record)
    (setq refs (cons (list (EL:Get 'handle label) "text" (EL:Get 'uid label)) refs))) refs)
;; Date: 2026-10-10. Deleted output is recoverable; foreign objects are not deleted.
(defun EL:RebuildPreflight (record store / ref state)
  (EL:Require (equal (EL:OutputState (EL:Get 'panel-output-handle record) store record "panel" "panel") 'missing)
    "原系统图箱体仍存在，不能按已删除状态重新生成。")
  (foreach ref (EL:DiagramOutputRefs record)
    (setq state (EL:OutputState (car ref) store record (cadr ref) (caddr ref)))
    (EL:Require (member state '(missing ready))
      (strcat "旧系统图残余对象关联不符、锁层或不在模型空间，未清理：" (car ref)))) T)
(defun EL:RebuildDiagram (result template capacity plan record store oldrecord / ref entity)
  (EL:RebuildPreflight oldrecord store)
  (foreach ref (EL:DiagramOutputRefs oldrecord)
    (if (setq entity (EL:OwnedEntity (car ref) store oldrecord (cadr ref) (caddr ref)))
      (progn
        (EL:Require (EL:PerfWrite 'entdel (list entity)) "旧系统图残余对象清理失败，撤销本次重新生成。")
        (EL:Require (not (entget entity)) "旧系统图残余对象仍存在，撤销本次重新生成。"))))
  (EL:LogEvent "DIAGRAM_REBUILD" (list (cons 'old-panel (EL:Get 'panel-output-handle oldrecord))
    (cons 'diagram-id (EL:Get 'diagram-id record))))
  (if *EL:CCKK2Request* (EL:CCKK2CreateDiagram result template capacity plan record store)
    (EL:CreateDiagram result template capacity plan record store)))
(defun EL:DiagramViewBounds (record store / ref entity bounds lo hi good)
  (setq good T)
  (foreach ref (EL:DiagramOutputRefs record)
    (setq entity (EL:OwnedEntity (car ref) store record (cadr ref) (caddr ref))
      bounds (if entity (EL:EntityBounds entity)))
    (if bounds
      (setq lo (if lo (mapcar 'min lo (car bounds)) (car bounds))
        hi (if hi (mapcar 'max hi (cadr bounds)) (cadr bounds)))
      (setq good nil)))
  (if (and good lo hi) (list lo hi)))
(defun EL:ShowDiagramBody (record store / bounds)
  (if (and (= (getvar "TILEMODE") 1) (> (getvar "CVPORT") 1))
    (progn
      (EL:FreshBoundary)
      (vla-Regen (vla-get-ActiveDocument (vlax-get-acad-object)) 1)
      (EL:FreshBoundary)
      (if (setq bounds (EL:DiagramViewBounds record store))
        (progn
          (EL:LogEvent "DIAGRAM_VIEW_BOUNDS" (list (cons 'panel (EL:Get 'panel-output-handle record))
            (cons 'rows (length (EL:Get 'rows record))) (cons 'bounds bounds)))
          (EL:FreshBoundary)
          (EL:SimpleZoom (car bounds) (cadr bounds))
          (EL:FreshBoundary) T)))))
(defun EL:ShowDiagram (record store / shown checkpoint)
  (setq checkpoint *EL:PerfPending*)
  (setq shown (vl-catch-all-apply 'EL:PerfCall (list "DIAGRAM_VIEW" 'EL:ShowDiagramBody (list record store))))
  (if (vl-catch-all-error-p shown) (EL:PerfUnwind checkpoint))
  (if (equal shown T)
    (progn (EL:LogEvent "DIAGRAM_VIEW_SHOWN" (list (cons 'panel (EL:Get 'panel-output-handle record))))
      (princ "\n已定位到完整系统图。") T)
    (progn
      (EL:LogEvent "DIAGRAM_VIEW_FAILED" (list (cons 'panel (EL:Get 'panel-output-handle record))
        (cons 'position (EL:Get 'position (EL:Get 'plan record)))
        (cons 'reason (if (vl-catch-all-error-p shown) (vl-catch-all-error-message shown) "OUTPUT_BOUNDS_OR_MODEL_VIEW_UNAVAILABLE"))))
      (princ (strcat "\n系统图已保存，但自动定位未完成；输出箱体句柄："
        (EL:Get 'panel-output-handle record) "，插入点："
        (vl-prin1-to-string (EL:Get 'position (EL:Get 'plan record))) "。请查看诊断日志。")) nil)))
(defun EL:SyncDiagram (result cfg powers capacity generate interactive)
  (EL:SyncDiagramScoped result cfg powers capacity generate interactive *EL:FreshScope*))
(defun EL:SyncDiagramScoped (result cfg powers capacity generate interactive scope / store record template transform plan point structural outcome rotation scale rebuild context *EL:NativePreview* *EL:FreshScope* *EL:FreshScopeEnabled* *EL:UpdateOperations* *EL:UpdateScopeActive*)
  (setq *EL:FreshScope* scope *EL:FreshScopeEnabled* T *EL:UpdateScopeActive* T)
  (setq capacity (EL:CapacityDefault capacity))
  (setq store (cond ((EL:StoreRead)) (T (EL:StoreInitial)))
    record (cond ((EL:DiagramForPanel (EL:Get 'panel result) store)) (T (EL:NewRecord (EL:Get 'panel result) store)))
    template (cond ((EL:Get 'template cfg)) ((EL:Get 'template record)))
    result (EL:PreparedResult result record))
  (cond
    ((not (EL:CircuitNumbersReady result))
      (princ (strcat "\n" (EL:NumberProblemText result)))
      (EL:MarkStale (EL:Get 'panel result) 'circuit-number-pending))
    ((not (EL:Get 'can-generate result)) (EL:PrintStatistics result) (EL:MarkStale (EL:Get 'panel result) 'invalid-result))
    ((and (equal (EL:Get 'engine result) 'fixed) (not (EL:SelectionsReady result capacity)))
      (princ "\n回路类型尚未确认，请在统计面板集中核对；原系统图未更新。")
      (EL:MarkStale (EL:Get 'panel result) 'selection-pending))
    ((vl-some '(lambda (c) (EL:Get 'identity-error c)) (EL:Get 'circuits result))
      (princ "\n出线种子身份不唯一，不能通过删除确认绕过；请修复源图。")
      (EL:MarkStale (EL:Get 'panel result) 'identity-conflict))
    ((not (EL:FreshResult result cfg)) (EL:MarkStale (EL:Get 'panel result) 'source-changed))
    ((and (EL:Get 'identity-ambiguous result)
        (not (and interactive (EL:ConfirmRemoved result record))))
      (EL:MarkStale (EL:Get 'panel result) 'identity-conflict))
    ((not (or generate (EL:Get 'panel-output-handle record))) T)
    (T
      (EL:Require (and (<= 1 (length (EL:Get 'circuits result))) (<= (length (EL:Get 'circuits result)) 8)) "本图块最多容纳8条实际回路，请拆箱后统计。")
      (EL:Require (and (tblsearch "STYLE" "ICDA-STYLE1") (EL:OutputLayerReady "SYS_系统标注_E")
        (EL:OutputLayerReady "TEL_TEXT")) "请补齐 ICDA-STYLE1 样式，并打开、解冻和解锁输出图层。")
      (EL:Require (and (EL:FixedTemplate template) (EL:TemplateRuntimeValid template cfg)) "模板未适配或已变化，请运行 ELTEMPLATE。")
      (EL:Require (EL:UniqueDiagram store record) "发现复制系统图或外来标识，需显式修复关联，未更新。")
      (if (and generate interactive (EL:Get 'panel-output-handle record)
          (equal (EL:OutputState (EL:Get 'panel-output-handle record) store record "panel" "panel") 'missing))
        (progn
          (EL:RebuildPreflight record store)
          (setq rebuild record record (EL:Put 'panel-output-handle nil (EL:Put 'cckk-labels nil record)))
          (princ "\n原系统图已删除，将按本次统计重新放置；取消会保留原记录和残余对象。")))
      (if (EL:Get 'panel-output-handle record)
        (progn
          (if (and generate interactive) (princ "\n检测到已有系统图，将在原位置更新，完成后自动定位显示。"))
          (setq transform (EL:CheckLayout record store)))
        (progn
          (EL:Require (and (= (getvar "TILEMODE") 1) (> (getvar "CVPORT") 1)) "请进入模型空间生成系统图。")
          ;; CCKK2 places the real block with native -INSERT inside the transaction.
          (setq point (if *EL:CCKK2Request* '(0.0 0.0 0.0)
            (EL:PerfInput 'getpoint (list "\n选择系统图箱体插入点："))))
          (EL:Require point "插入取消。")
          (if (not *EL:CCKK2Request*) (EL:PerfMark "placement-confirmed"))
          ;; Date: 2026-10-09. New diagrams use the agreed 0-degree, 1:1 defaults.
          (setq transform (list (cons 'position (trans point 1 0))
            '(rotation . 0.0) '(scale . 1.0))
            *EL:NativePreview* interactive)))
      (setq plan (EL:FixedPlan result template capacity (EL:Get 'position transform) (EL:Get 'rotation transform) (EL:Get 'scale transform))
        structural (or (not (EL:SameStructure record plan))
          (not (EL:Get 'cckk-layout (EL:Get 'plan record)))))
      (EL:Require plan "回路计划无效。")
      (EL:PerfSet "actual-circuits" (length (EL:Get 'circuits result)))
      (EL:PerfSet "reserve-circuits" (- (length (EL:Get 'rows plan)) (length (EL:Get 'circuits result))))
      (if (and structural (EL:Get 'layout-conflict transform))
        (progn
          (EL:PreviewPlan plan)
          (initget "Reflow Cancel")
          (EL:Require (and interactive (equal (EL:PerfInput 'getkword (list "\n结构变化影响手工排版，按预览模板重排？[Reflow/Cancel] <Cancel>：")) "Reflow"))
            "已保留现场排版，取消结构更新。") (redraw)))
      (EL:Require (EL:FreshResult result cfg) "SOURCE_CHANGED：提交前源图变化，未更新。")
      (if (EL:Get 'panel-output-handle record) (EL:UpdatePreflight record store template plan))
      (if (and (EL:Get 'panel-output-handle record) (equal template (EL:Get 'template record))
          (equal cfg (EL:Get 'config record)) (equal powers (EL:Get 'powers record))
          (EL:DiagramUnchanged record result plan store))
        (progn (princ "\n系统图数据与图形均未变化，无需写入。") (setq outcome record))
        (progn
      (setq record (EL:Put 'draft-circuits nil (EL:Put 'draft-capacity nil
        (EL:Put 'capacity-option capacity (EL:Put 'template template (EL:Put 'config cfg
        (EL:Put 'engine (EL:Get 'engine result) (EL:Put 'source-signature (EL:Get 'signature (EL:Get 'snapshot result))
          (EL:Put 'power-signature (EL:Signature (EL:Get 'power-config result))
            (EL:Put 'powers powers (EL:Put 'status 'current (EL:Put 'updated-at (getvar "CDATE") record))))))))))))
      (if (assoc 'excluded-devices result)
        (setq record (EL:Put 'excluded-devices (EL:Get 'excluded-devices result) record)))
      (if (assoc 'block-ground result)
        (setq record (EL:Put 'block-ground (EL:Get 'block-ground result) record)))
      (setq record (EL:Put 'candidate-keys (EL:Get 'candidate-keys result)
        (EL:Put 'excluded-seeds (EL:Get 'excluded-seeds result)
          (EL:Put 'capacity-source (EL:Get 'capacity-source result)
            (EL:Put 'draft-capacity-source nil record)))))
      (setq record (EL:Put 'panel-number (EL:PanelNumber result) record))
      (setq store (EL:Put 'fixed-template template store))
      (setq context
        (cond (rebuild (EL:TransactionVerifiedStore 'EL:RebuildDiagram (list result template capacity plan record store rebuild)))
          ((EL:Get 'panel-output-handle record)
            (EL:TransactionVerifiedStore 'EL:ApplyUpdate (list result template plan record store structural)))
          (T (EL:TransactionVerifiedStore (if *EL:CCKK2Request* 'EL:CCKK2CreateDiagram 'EL:CreateDiagram)
            (list result template capacity plan record store))))
        outcome (EL:Get 'outcome context))))
      (if (and outcome (listp outcome)
          (EL:Get 'panel-output-handle outcome)
          (equal outcome (EL:DiagramForPanel (EL:Get 'panel result) (EL:TransactionVerifiedRead context))))
        (progn
          ;; Date: 2026-10-11. Full diagnostic copies are exported by ELDIAG.
          ;; Successful generation/update finishes after the verified DWG save.
          (princ (strcat "\n系统图已同步：" (itoa (length (EL:Get 'circuits result))) " 条实际回路，"
            (itoa (- (length (EL:Get 'rows plan)) (length (EL:Get 'circuits result)))) " 条预留，无预留功率文字。"))
          (if (and generate interactive) (EL:ShowDiagram outcome store)) T)
        (progn
          ;; Do not auto-recover and start another write after failed rollback.
          (if (not *EL:TransactionOpen*) (EL:MarkStale (EL:Get 'panel result) 'transaction-failed))
          nil)))))
