      (vla-put-Visible object :vlax-false)))
  (foreach segment (EL:Get 'segments wire)
    (setq copy (vla-AddLine space (vlax-3d-point (car segment)) (vlax-3d-point (cadr segment)))
      *EL:ColorPreviewCopies* (cons copy *EL:ColorPreviewCopies*))
