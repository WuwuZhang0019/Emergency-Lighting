;; Date: 2026-10-16. Bundled graphics and saved powers seed the user's catalog transactionally.
(defun EL:DLDefaultSource ()
  (if *EL:Root* (strcat (EL:NormalizeRoot *EL:Root*) "assets/default-device-library/")))
(defun EL:DLDefaultMatch (seed catalog / keys entry found)
  ;; Include deleted entries: a user's deletion is never undone by startup.
  (setq keys (mapcar 'EL:DLNameKey (EL:DLEntryNames seed)))
  (foreach entry (EL:Get 'devices catalog)
    (if (and (vl-some '(lambda (name) (member (EL:DLNameKey name) keys)) (EL:DLEntryNames entry))
      (or (not found) (not (equal (EL:Get 'status entry) 'deleted))))
      (setq found entry))) found)
(defun EL:DLDefaultAssetsPresent (entry snapshot)
  (and (EL:DLEntryAssets entry)
    (findfile (strcat (EL:Get 'root snapshot) (EL:Get 'block-file entry)))
    (findfile (strcat (EL:Get 'root snapshot) (EL:Get 'legend-file entry)))))
(defun EL:DLDefaultNeeded (defaults snapshot / seed entry needed)
  (foreach seed (EL:Get 'devices defaults)
    (setq entry (EL:DLDefaultMatch seed (EL:Get 'catalog snapshot)))
    (if (or (not entry) (and (not (equal (EL:Get 'status entry) 'deleted))
      (not (EL:DLDefaultAssetsPresent entry snapshot)))) (setq needed T))) needed)
(defun EL:DLDefaultMerge (defaults source snapshot / catalog seed old entry rows next)
  (setq catalog (EL:Get 'catalog snapshot))
  (foreach seed (EL:Get 'devices defaults)
    (setq old (EL:DLDefaultMatch seed catalog))
    (if (or (not old) (and (not (equal (EL:Get 'status old) 'deleted))
      (not (EL:DLDefaultAssetsPresent old snapshot))))
      (progn
        (setq entry (if old old
          (EL:Put 'device-id (EL:DLNextID catalog) (EL:Put 'revision 0 seed))))
        ;; Existing names, watts, ground, activation and display remain user-owned.
        (if (not old) (setq entry (EL:Put 'asset-revision 0 entry)))
        (setq *EL:DLError* (strcat "复制默认设备“" (EL:Get 'display seed)
          "”的图形未完成，请检查库目录权限和完整交付包。"))
        (setq entry (EL:DLAssetInstall snapshot entry (strcat source (EL:Get 'block-file seed))
          (strcat source (EL:Get 'legend-file seed)))
          *EL:DLError* nil
          entry (EL:Put 'revision (1+ (EL:Get 'revision entry)) entry)
          rows (if old (subst entry old (EL:Get 'devices catalog))
            (append (EL:Get 'devices catalog) (list entry)))
          catalog (EL:Put 'devices rows catalog))
        (if (not old)
          (setq next (1+ (atoi (substr (EL:Get 'device-id entry) 6)))
            catalog (EL:Put 'next-id next catalog))))))
  (EL:Put 'revision (1+ (EL:Get 'revision catalog)) catalog))
(defun EL:DLDefaultInstallLocked (defaults source snapshot / candidate)
  ;; Compare the old index before creating immutable asset revisions.
  (setq *EL:DLError* "设备库已变化，默认设备未写入；请刷新重试。")
  (EL:Require (if (EL:Get 'present snapshot)
      (equal (EL:DLReadText (strcat (EL:Get 'root snapshot) "catalog.eld")) (EL:Get 'raw snapshot))
      (not (findfile (strcat (EL:Get 'root snapshot) "catalog.eld"))))
    "设备库已变化，默认设备未写入；请刷新重试。")
  (setq *EL:DLError* nil candidate (EL:DLDefaultMerge defaults source snapshot)
    *EL:DLError* "默认设备库索引保存和回读未完成，请检查目录权限后重试。")
  (if (EL:DLCommitLocked snapshot candidate) (progn (setq *EL:DLError* nil) T)))
(defun EL:DLDefaultEnsure (snapshot / source defaults root lock owner outcome loaded)
  (setq source (EL:DLDefaultSource) root (EL:Get 'root snapshot))
  (cond
    ((not snapshot) nil)
    ((or (not source) (not (findfile (strcat source "catalog.eld")))) snapshot)
    ((equal (list root source (EL:Get 'raw snapshot)) *EL:DLDefaultCache*) snapshot)
    ((not (setq defaults (EL:DLParse (EL:DLReadText (strcat source "catalog.eld"))))) snapshot)
    ((/= (length (EL:Get 'devices defaults)) 49)
      (EL:DLFail "默认设备库不完整，请重新解压完整应急照明包。") snapshot)
    ((not (EL:DLDefaultNeeded defaults snapshot))
      (setq *EL:DLDefaultCache* (list root source (EL:Get 'raw snapshot))) snapshot)
    (T
      (setq lock (strcat root ".write-lock") owner (EL:DLOperationID))
      (if (and (EL:DLMkdir root) (EL:DLLockAcquire lock owner))
        (progn
          (setq outcome (vl-catch-all-apply 'EL:DLDefaultInstallLocked (list defaults source snapshot)))
          (EL:DLLockRelease lock owner)
          (if (and (not (vl-catch-all-error-p outcome)) outcome
              (setq loaded (EL:DLSnapshotLoad root)))
            (progn
              (setq snapshot loaded *EL:DLCache* nil *EL:DLDefaultCache* (list root source (EL:Get 'raw loaded)))
              (EL:LogEvent "DEFAULT_DEVICE_LIBRARY_INSTALLED" (list (cons 'root root) '(count . 49)))
              (princ "\n默认设备库已补齐：49 项图形；默认功率可在 ELDEVLIB 中查看或修改。"))
            (EL:DLFail (strcat "默认设备库安装未完成，原资料保留，请刷新重试："
              (cond (*EL:DLError*) ((vl-catch-all-error-p outcome) (vl-catch-all-error-message outcome))
                (T "复制或索引保存失败。"))))))
        (if (not *EL:DLError*) (EL:DLFail "默认设备库目录不可写，请检查当前用户目录权限。"))) snapshot)))
(defun EL:DLDefaultSnapshot (root / snapshot outcome)
  ;; Every entry point keeps the original library and reports a specific read failure.
  (setq *EL:DLError* nil root (EL:NormalizeRoot root))
  (if (not root) (EL:DLFail "无法取得设备库目录，请检查当前 Windows 用户的本地数据目录。")
  (progn (setq outcome (vl-catch-all-apply 'EL:DLSnapshotLoad (list root)))
  (if (vl-catch-all-error-p outcome)
    (EL:DLFail (strcat "无法读取设备库：" root "；" (vl-catch-all-error-message outcome)))
    (if outcome
      (progn
        (setq snapshot outcome outcome (vl-catch-all-apply 'EL:DLDefaultEnsure (list snapshot)))
        (if (vl-catch-all-error-p outcome)
          (progn (EL:DLFail (strcat "默认设备库未补齐，原资料保留："
            (cond (*EL:DLError*) (T (vl-catch-all-error-message outcome))))) snapshot) outcome)))))))
(defun EL:DLDefaultStartup (/ snapshot)
  (setq *EL:DLDefaultCache* nil)
  (if (and (EL:DLDefaultSource) (findfile (strcat (EL:DLDefaultSource) "catalog.eld")))
    (progn (setq snapshot (EL:DLDefaultSnapshot (EL:DLRoot)))
      (if *EL:DLError* (princ (strcat "\n" *EL:DLError*))) snapshot)
    (progn (EL:DLFail "交付包缺少默认设备库，请保留完整解压目录后重新加载。")
      (princ (strcat "\n" *EL:DLError*)) nil)))
(princ)
