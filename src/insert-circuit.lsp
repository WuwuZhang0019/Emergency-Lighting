;; Date: 2026-10-09. Standalone circuit/panel insertion with centered labels.
(defun EL:CCKKLayer (name / row)
  (if (not (tblsearch "LAYER" name))
    (entmake (list '(0 . "LAYER") '(100 . "AcDbSymbolTableRecord")
      '(100 . "AcDbLayerTableRecord") (cons 2 name) '(70 . 0) '(62 . 7) '(6 . "Continuous"))))
  (setq row (tblsearch "LAYER" name))
  (if (and row (= 0 (logand (cdr (assoc 70 row)) 5)) (> (cdr (assoc 62 row)) 0)) T
    (progn (princ (strcat "\n请先打开、解冻并解锁图层：" name)) nil)))
(defun EL:CCKKText (block label dx dy layer style color / data base angle point normal)
  (setq data (entget block) base (cdr (assoc 10 data)) angle (cdr (assoc 50 data))
    normal (cdr (assoc 210 data))
    dx (* dx (cdr (assoc 41 data))) dy (* dy (cdr (assoc 42 data))))
  (if (not normal) (setq normal '(0.0 0.0 1.0)))
  ;; Both INSERT origin and TEXT alignment point use the same OCS.
  (setq point (list (+ (car base) (- (* dx (cos angle)) (* dy (sin angle))))
    (+ (cadr base) (+ (* dx (sin angle)) (* dy (cos angle)))) (caddr base)))
  (if (entmake (list '(0 . "TEXT") '(100 . "AcDbEntity") (cons 8 layer)
      (cons 62 color) '(6 . "ByLayer") '(48 . 1.0) '(370 . -1) '(440 . 0)
      '(100 . "AcDbText") (cons 10 point) '(40 . 350.0) (cons 1 label)
      (cons 50 angle) '(41 . 0.7) '(51 . 0.0) (cons 7 style)
      '(71 . 0) '(72 . 1) (cons 11 point) (cons 210 normal) '(39 . 0.0)
      '(100 . "AcDbText") '(73 . 0)))
    (entlast)))
(defun EL:CCKKInsert (blockname style textlayer color labels commandname / *error* saved item before block created text)
  (defun *error* (message)
    (foreach item created (if (entget item) (entdel item)))
    (foreach item saved (setvar (car item) (cdr item)))
    (if (and message (not (wcmatch (strcase message) "*CANCEL*,*QUIT*,*EXIT*,*BREAK*")))
      (princ (strcat "\n" commandname " 插入失败：" message))
      (princ "\n已取消插入。"))
    (princ))
  (cond
    ((not (tblsearch "BLOCK" blockname))
      (princ (strcat "\n当前图纸没有图块 " blockname "，请先将该图块复制到本图。")))
    ((not (tblsearch "STYLE" style))
      (princ (strcat "\n当前图纸没有文字样式 " style "，请先复制使用该样式的文字到本图。")))
    ((and (EL:CCKKLayer "SYS_系统标注_E") (EL:CCKKLayer textlayer))
      (foreach item '("CMDECHO" "ATTREQ" "DRAGMODE" "CLAYER")
        (setq saved (cons (cons item (getvar item)) saved)))
      (setvar "CMDECHO" 0)
      (setvar "ATTREQ" 0)
      (setvar "DRAGMODE" 2)
      (setvar "CLAYER" "SYS_系统标注_E")
      (setq before (entlast))
      (princ "\n移动鼠标预览图块，左键点击插入并添加文字，Esc 取消。")
      (command "_.-INSERT" blockname "_Scale" 1.0 "_Rotate" 0.0 pause)
      (setq block (entlast))
      (if (and block (not (equal block before)) (equal (cdr (assoc 0 (entget block))) "INSERT"))
        (progn
          (setq created (list block))
          (foreach item labels
            (setq text (EL:CCKKText block (car item) (cadr item) (caddr item) textlayer style color))
            (if text (setq created (cons text created))
              (progn (princ "\n文字创建失败，本次图块和文字将清理。") (exit))))))
      (foreach item saved (setvar (car item) (cdr item)))))
  (princ))
