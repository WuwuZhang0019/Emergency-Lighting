;; Date: 2026-10-09. Common publication/synchronization entry points.
(defun EL:FixedPowers (record / data powers row)
  (setq data (EL:SimpleLoadPowers) powers (EL:Get 'powers record))
  (EL:Require data "图块功率库无效，原文件保留。")
  (foreach row (EL:Get 'powers data) (setq powers (EL:Put (car row) (cdr row) powers)))
  (if (EL:Get 'draft-circuits record)
    (foreach row (EL:Get 'powers record) (setq powers (EL:Put (car row) (cdr row) powers)))) powers)
(defun EL:SaveNamePowers (powers / data row merged)
  (if (setq data (EL:SimpleLoadPowers))
    (progn
      (setq merged (EL:Get 'powers data))
      (foreach row powers
        (if (numberp (cdr row)) (setq merged (EL:Put (car row) (cdr row) merged))))
      (EL:WriteData (strcat *EL:Root* "config/block-powers.eld") (list '(version . 1) (cons 'powers merged))))))
(defun EL:SaveDraft (result cfg powers capacity / store record)
  (setq store (cond ((EL:StoreRead)) (T (EL:StoreInitial)))
    record (cond ((EL:DiagramForPanel (EL:Get 'panel result) store)) (T (EL:NewRecord (EL:Get 'panel result) store)))
    record (EL:Put 'draft-circuits (EL:Get 'circuits result) (EL:Put 'draft-capacity capacity
      (EL:Put 'powers powers (EL:Put 'config cfg (EL:Put 'engine (EL:Get 'engine result) record))))))
  (if (not (EL:Get 'panel-output-handle record))
    (setq record (EL:Put 'rows (EL:Get 'circuits result) (EL:Put 'capacity-option capacity record))))
  (if (not (EL:Get 'can-generate result)) (setq record (EL:Put 'status 'stale record)))
  (EL:Transaction 'EL:StoreWrite (list (EL:StorePutDiagram record store))))
(defun EL:EditPanel (result cfg / *error* store record powers capacity edited prepared saved)
  (defun *error* (msg)
    (EL:ClearGapPreview) (EL:ClearPickHighlights) (EL:ReleasePowerUI)
    (if msg (princ (strcat "\n主面板已停止；未提交草稿保留原值：" msg))) (princ))
  (setq store (cond ((EL:StoreRead)) (T (EL:StoreInitial)))
    record (cond ((EL:DiagramForPanel (EL:Get 'panel result) store)) (T (EL:NewRecord (EL:Get 'panel result) store)))
    powers (EL:FixedPowers record) capacity (cond ((EL:Get 'draft-capacity record)) ((EL:Get 'capacity-option record)) (T 'cap300))
    prepared (EL:PreparedResult result
      (if (EL:Get 'draft-circuits record) (EL:Put 'rows (EL:Get 'draft-circuits record) record) record)))
  (if (setq edited (EL:PanelDialog prepared cfg powers capacity))
    (progn
      (setq result (EL:Get 'result edited) powers (EL:Get 'powers edited) capacity (EL:Get 'capacity edited))
      (if (EL:FreshResult result cfg)
        (progn
          (setq saved (if (EL:Get 'can-generate result)
            (EL:SyncDiagram result cfg powers capacity (EL:Get 'generate edited) T)
            (progn (EL:MarkStale (EL:Get 'panel result) 'incomplete-draft) T)))
          (if saved
            (progn
              ;; The DWG keeps a recoverable power copy even when export is unavailable.
              (if (or (not (EL:Get 'panel-output-handle (EL:DiagramForPanel (EL:Get 'panel result) (EL:StoreRead))))
                  (not (EL:Get 'can-generate result)))
                (setq saved (EL:SaveDraft result cfg powers capacity)))
              (if saved
                (progn
                  (setq *EL:Result* result *EL:FixedConfig* cfg)
                  (if (not (EL:SaveNamePowers powers)) (princ "\nDWG 已保存；共享图块功率库写入失败，其他图纸暂不复用本次值。"))
                  (princ "\n主面板已保存。"))))))
        (EL:MarkStale (EL:Get 'panel result) 'source-changed))))
  (EL:ClearPickHighlights) (princ))
(defun EL:PublishDiagram (result cfg / store record powers capacity)
  (setq store (EL:StoreRead) record (EL:DiagramForPanel (EL:Get 'panel result) store))
  (if record
    (progn
      (setq capacity (cond ((EL:Get 'capacity-option record)) (T 'cap300)) powers (EL:Get 'powers record))
      (if (equal (EL:Get 'engine result) 'fixed)
        (setq powers (EL:FixedPowers record) result (EL:PanelCompute result powers cfg))
        (setq result (EL:BoxStatistics result cfg (EL:LoadLibrary) nil)))
      (EL:SyncDiagram result cfg powers capacity nil nil))) result)
(defun EL:FixedStat (/ *error* panel sample pd wd cfg result record powers)
  (defun *error* (msg)
    (EL:ClearPickHighlights) (EL:ReleasePowerUI)
    (if pd (vl-catch-all-apply 'EL:MarkStale (list (cdr (assoc 5 pd)) 'recognition-cancelled)))
    (if msg (princ (strcat "\n统计已停止：" msg))) (princ))
  (setq *EL:Result* nil *EL:DeviceResult* nil)
  (if (and (EL:EnsureRoot) (setq panel (EL:PickModel 'panel "\n拾取配电箱：")))
    (progn
      (setq pd (entget (car panel)))
      (EL:Require (not (EL:ManagedEntity (car panel))) "请选择平面图配电箱，不能统计系统图输出。")
      (if (setq sample (EL:PickModel 'wire "\n拾取该系统的一条导线（确定图层）："))
        (progn
          (setq wd (entget (car sample)) cfg (EL:DefaultConfig (EL:DrawingID))
            cfg (EL:Put 'template (EL:Get 'template (EL:LoadConfig))
              (EL:Put 'params (EL:GapParams (EL:SuggestedParams)) (EL:Put 'wire-layers (list (cdr (assoc 8 wd))) cfg)))
            result (EL:RecognizeFixed cfg (cdr (assoc 5 pd)))
            record (EL:DiagramForPanel (cdr (assoc 5 pd)) (EL:StoreRead))
            powers (EL:FixedPowers record) result (EL:PanelCompute result powers cfg)
            *EL:Result* result *EL:FixedConfig* cfg)
          (EL:PublishDiagram result cfg)
          (if (EL:Get 'circuits result) (EL:EditPanel result cfg)
            (princ "\n未取得有效实际出线；不能生成只有两条预留的系统图。")))
        (EL:MarkStale (cdr (assoc 5 pd)) 'recognition-cancelled))))
  (EL:ClearPickHighlights) (princ))
(defun c:ELGEN (/ *error* cfg result record powers capacity)
  (defun *error* (msg)
    (redraw) (EL:ClearPickHighlights)
    (if *EL:Result* (vl-catch-all-apply 'EL:MarkStale (list (EL:Get 'panel *EL:Result*) 'update-failed)))
    (if msg (princ (strcat "\n生成或更新停止：" msg))) (princ))
  (if (and *EL:Result* (EL:EnsureRoot))
    (progn
      (setq result *EL:Result* record (EL:DiagramForPanel (EL:Get 'panel result) (EL:StoreRead)))
      (if (equal (EL:Get 'engine result) 'fixed)
        (progn
          (setq cfg *EL:FixedConfig* powers (EL:FixedPowers record) result (EL:PanelCompute result powers cfg))
          (if (not (EL:Get 'template cfg)) (setq cfg (EL:Put 'template (EL:Get 'template (EL:LoadConfig)) cfg))))
        (progn
          (princ "\n本次使用高级流程按身份保存的功率；不会写入按块名共享功率库。")
          (setq cfg (EL:LoadConfig) result (EL:BoxStatistics result cfg (EL:LoadLibrary) nil))))
      (setq capacity (cond ((EL:Get 'capacity-option record)) (T 'cap300)))
      (EL:SyncDiagram result cfg powers capacity T T))
    (princ "\n请先运行 ELSTAT 或 ELTRACE。")) (princ))
(defun c:ELUPDATE (/ *error* pick tag store record cfg panel result context seeds)
  (defun *error* (msg)
    (EL:ClearPickHighlights)
    (if panel (vl-catch-all-apply 'EL:MarkStale (list panel 'update-failed)))
    (if msg (princ (strcat "\n重新统计更新停止：" msg))) (princ))
  (if (and (EL:EnsureRoot) (setq pick (EL:PickEntity "\n选择受管系统图的箱体、回路或功率文字：")))
    (progn
      (setq tag (EL:DiagramTag (car pick)) store (EL:StoreRead)
        record (EL:By 'diagram-id (cdr (nth 1 tag)) (EL:Get 'diagrams store)))
      (EL:Require (and record (equal (cdr (car tag)) (EL:Get 'drawing-uuid store))
        (equal (cdr (nth 4 tag)) (cdr (assoc 5 (entget (car pick)))))) "不是本图原始受管对象；复制或跨图对象不能自动继承关联。")
      (setq panel (EL:Get 'source-panel-handle record) cfg (EL:Get 'config record))
      (if (equal (EL:Get 'engine record) 'fixed)
        (setq result (EL:PanelCompute (EL:RecognizeFixed cfg panel) (EL:FixedPowers record) cfg) *EL:FixedConfig* cfg)
        (progn
          (setq context (EL:CurrentContext cfg panel) seeds (cadr context))
          (setq result (EL:BoxStatistics (EL:AnalyzeSnapshot (car context) cfg panel seeds) cfg (EL:LoadLibrary) nil))))
      (setq *EL:Result* result)
      (EL:SyncDiagram result cfg (EL:Get 'powers record) (EL:Get 'capacity-option record) nil T)))
  (EL:ClearPickHighlights) (princ))
