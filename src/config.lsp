(defun EL:DrawingID ()
  (if (= (getvar "DWGTITLED") 1)
    (strcase (strcat (getvar "DWGPREFIX") (getvar "DWGNAME")))))
(defun EL:ConfigPath (id) (strcat *EL:Root* "config/drawing-" (EL:Hash id) ".eld"))
(defun EL:DefaultConfig (id)
  (list (cons 'version 1) (cons 'drawing id) (cons 'revision 0)
        (cons 'calibrated nil) (cons 'units nil) (cons 'params nil)
        (cons 'wire-layers nil) (cons 'panel-layers nil) (cons 'device-layers nil)
        (cons 'leader-layers nil) (cons 'panel-names nil) (cons 'device-names nil)
        (cons 'leader-names nil) (cons 'layer-pairs nil) (cons 'gap-pairs nil)
        (cons 'leader-pairs nil) (cons 'powers nil) (cons 'template nil)))
(defun EL:ConfigValid (cfg id / ok k pair)
  (setq ok (and (EL:OnlyKeys cfg '(version drawing revision calibrated units params
        wire-layers panel-layers device-layers leader-layers panel-names device-names
        leader-names layer-pairs gap-pairs leader-pairs powers template))
        (equal (EL:Get 'version cfg) 1) (equal (EL:Get 'drawing cfg) id)
        (= (type (EL:Get 'revision cfg)) 'INT) (>= (EL:Get 'revision cfg) 0)
        (or (not (EL:Get 'params cfg)) (EL:ParamsValid (EL:Get 'params cfg)))))
  (foreach k '(wire-layers panel-layers device-layers leader-layers panel-names device-names leader-names)
    (if (not (EL:Strings (EL:Get k cfg))) (setq ok nil)))
  (foreach pair (EL:Get 'layer-pairs cfg)
    (if (not (and (EL:Strings pair) (= (length pair) 2))) (setq ok nil)))
  (foreach pair (EL:Get 'gap-pairs cfg)
    (if (not (and (EL:OnlyKeys pair '(a b source signature params drawing date exception a-state b-state))
                  (equal (EL:Get 'source pair) 'manual) (equal (EL:Get 'drawing pair) id)
                  (= (length (EL:Get 'a pair)) 2) (= (length (EL:Get 'b pair)) 2)
                  (= (type (car (EL:Get 'a pair))) 'STR) (= (type (car (EL:Get 'b pair))) 'STR)
                  (member (cadr (EL:Get 'a pair)) '(start end)) (member (cadr (EL:Get 'b pair)) '(start end))
                  (= (type (EL:Get 'signature pair)) 'STR) (EL:ParamsValid (EL:Get 'params pair)))) (setq ok nil)))
  (foreach pair (EL:Get 'leader-pairs cfg)
    (if (not (and (EL:OnlyKeys pair '(a b a-state b-state drawing date))
                  (equal (EL:Get 'drawing pair) id) (= (type (EL:Get 'a pair)) 'STR)
                  (= (type (EL:Get 'b pair)) 'STR) (= (type (EL:Get 'a-state pair)) 'STR)
                  (= (type (EL:Get 'b-state pair)) 'STR))) (setq ok nil)))
  (foreach pair (EL:Get 'powers cfg) (if (not (EL:PowerShape pair)) (setq ok nil)))
  ok)
(defun EL:LoadValidGapPairs (cfg snapshot / valid issues pair a b rec)
  (foreach pair (EL:Get 'gap-pairs cfg)
    (setq a (EL:By 'key (EL:Get 'a pair) (EL:Get 'ends snapshot))
          b (EL:By 'key (EL:Get 'b pair) (EL:Get 'ends snapshot)))
    (if (and a b (equal (EL:Get 'drawing pair) (EL:Get 'drawing cfg))
             (equal (EL:Get 'signature pair) (EL:Get 'signature snapshot))
             (equal (EL:Get 'params pair) (EL:Get 'params cfg))
             (not (EL:Get 'occupied a)) (not (EL:Get 'occupied b)))
      (setq valid (cons pair valid))
      (foreach rec (list (car (EL:Get 'a pair)) (car (EL:Get 'b pair)))
        (setq issues (cons (EL:Issue 'STALE_PAIR rec pair) issues)))))
  (list (cons 'pairs valid) (cons 'issues issues)))
(defun EL:ReadData (path / file line textdata result)
  ;; READ parses data; EVAL/LOAD is never used for configuration.
  (if (setq file (open path "r" "utf8"))
    (progn
      (setq textdata "")
      (while (setq line (read-line file)) (setq textdata (strcat textdata line "\n")))
      (close file)
      (setq result (vl-catch-all-apply 'read (list textdata)))
      (if (not (vl-catch-all-error-p result)) result))))
(defun EL:WriteData (path data / file tmp backup result)
  ;; Same-directory replacement; restore the previous version on rename failure.
  (setq tmp (strcat path ".tmp") backup (strcat path ".bak"))
  (if (setq file (open tmp "w" "utf8"))
    (progn
      (write-line (vl-prin1-to-string data) file) (close file)
      (if (findfile backup) (vl-file-delete backup))
      (if (findfile path) (setq result (vl-file-rename path backup)) (setq result T))
      (if result
        (progn
          (setq result (vl-file-rename tmp path))
          (if result (if (findfile backup) (vl-file-delete backup))
            (if (findfile backup) (vl-file-rename backup path)))))
      (if (findfile tmp) (vl-file-delete tmp)) result)))
(defun EL:LoadConfig (/ id path raw checked)
  (if (setq id (EL:DrawingID))
    (progn
      (setq path (EL:ConfigPath id))
      (if (not (findfile path)) (EL:DefaultConfig id)
        (progn
          (setq raw (EL:ReadData path)
                checked (vl-catch-all-apply 'EL:ConfigValid (list raw id)))
          (if (and (not (vl-catch-all-error-p checked)) checked) raw
            (progn (princ (strcat "\n配置失效，请核对或用 ELSETUP 重新采样：" path)) nil)))))
    (progn (princ "\n请先保存 DWG，再建立图纸配置。") nil)))
(defun EL:SaveConfig (cfg / next)
  (setq next (EL:Put 'revision (1+ (EL:Get 'revision cfg)) cfg))
  (if (and (EL:ConfigValid next (EL:DrawingID))
           (EL:WriteData (EL:ConfigPath (EL:DrawingID)) next)) next
    (progn (princ "\n配置未保存；检查配置字段和目录写入权限。") nil)))
(defun EL:EffectiveName (entity / obj)
  (setq obj (vlax-ename->vla-object entity))
  (if (vlax-property-available-p obj 'EffectiveName) (vla-get-EffectiveName obj)
    (cdr (assoc 2 (entget entity)))))
(defun EL:Role (layer name cfg / panel leader device)
  (setq panel (and (member layer (EL:Get 'panel-layers cfg)) (member name (EL:Get 'panel-names cfg)))
        leader (and (member layer (EL:Get 'leader-layers cfg)) (member name (EL:Get 'leader-names cfg)))
        device (and (member layer (EL:Get 'device-layers cfg))
          (or (member name (EL:Get 'device-names cfg))
              (and (not (member layer (EL:Get 'panel-layers cfg)))
                   (not (member layer (EL:Get 'leader-layers cfg)))))))
  (cond ((and panel leader) 'ambiguous) (leader 'leader) (panel 'panel) (device 'device) (T 'unknown)))
(defun EL:Sample (cfg role prompt / pick data layer name lk nk)
  (if (setq pick (entsel prompt))
    (progn
      (setq data (entget (car pick)) layer (cdr (assoc 8 data)))
      (if (if (= role 'wire) (member (cdr (assoc 0 data)) '("LINE" "LWPOLYLINE"))
            (equal (cdr (assoc 0 data)) "INSERT"))
        (progn
          (setq lk (read (strcat (vl-symbol-name role) "-LAYERS")))
          (setq cfg (EL:Put lk (EL:Unique (cons layer (EL:Get lk cfg))) cfg))
          (if (/= role 'wire)
            (progn
              (setq name (EL:EffectiveName (car pick)) nk (read (strcat (vl-symbol-name role) "-NAMES")))
              (setq cfg (EL:Put nk (EL:Unique (cons name (EL:Get nk cfg))) cfg))))
          cfg)
        (progn (princ "\n样本类型错误，未保存。") nil)))))
(defun EL:InputParams (/ p x key defaults)
  ;; No production defaults: numbers below are only suggestions for explicit calibration.
  (setq defaults '((eps_touch . 0.1) (eps_boundary . 0.1) (eps_perp . 0.5)
      (eps_z . 0.01) (theta_max . 0.01) (R0 . 20.0) (Dmax . 200.0)))
  (foreach key '(eps_touch eps_boundary eps_perp eps_z theta_max R0 Dmax)
    (setq x (getreal (strcat "\n" (vl-symbol-name key) "（绘图单位；角度为弧度）<"
      (rtos (EL:Get key defaults) 2 4) ">: ")))
    (setq p (cons (cons key (if x x (EL:Get key defaults))) p)))
  (if (EL:ParamsValid p) p (progn (princ "\n参数范围无效，未保存。") nil)))
(defun c:ELSETUP (/ cfg p units)
  (if (setq cfg (EL:LoadConfig))
    (progn
      (setq cfg (EL:Sample cfg 'panel "\n拾取配电箱样本: "))
      (if cfg (setq cfg (EL:Sample cfg 'wire "\n拾取导线样本: ")))
      (if cfg (setq cfg (EL:Sample cfg 'device "\n拾取设备样本: ")))
      (if cfg
        (progn
          (setq units (getstring T "\n图纸单位说明（例如 mm；须人工核对）: ") p (EL:InputParams))
          (if (and p (/= units ""))
            (progn
              (initget "Yes No")
              (if (= (getkword "\n已核对正常接线误差、最大断口及相邻回路间距？[Yes/No] <No>: ") "Yes")
                (progn
                  (setq cfg (EL:Put 'params p cfg) cfg (EL:Put 'units units cfg)
                        cfg (EL:Put 'calibrated T cfg))
                  (if (EL:SaveConfig cfg) (princ "\n图层和参数配置已保存。"))))))))))
  (princ))
(defun c:ELSAMPLE (/ cfg role)
  (if (setq cfg (EL:LoadConfig))
    (progn
      (initget "Panel Wire Device Leader")
      (if (setq role (getkword "\n追加样本角色 [Panel/Wire/Device/Leader]: "))
        (if (setq cfg (EL:Sample cfg (read role) "\n拾取该角色样本: ")) (EL:SaveConfig cfg)))))
  (princ))
(princ)
