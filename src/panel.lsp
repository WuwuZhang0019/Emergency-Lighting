        *EL:ThumbPage* (max 0 (min (EL:Get 'thumb *EL:DLPanelPosition*)
          (* 8 (fix (/ (max 0 (1- (length (EL:PanelBlockRows)))) 8))))) *EL:DLPanelPosition* nil)))
  (while (and (> dialog 0) (= status 3))
