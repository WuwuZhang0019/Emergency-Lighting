(defun EL:PowerValid (record / w)
  (setq w (EL:Get 'watts record))
  (and (member (EL:Get 'category record) '(lighting sign exit other))
       (= (type (EL:Get 'display record)) 'STR) (/= (EL:Get 'display record) "")
       (= (type w) 'INT) (>= w 0) (or (> w 0) (equal (EL:Get 'zero-confirmed record) T))))
(defun EL:PowerShape (record)
  (and (EL:OnlyKeys record '(identity category display watts zero-confirmed source))
       (listp (EL:Get 'identity record)) (= (length (EL:Get 'identity record)) 3)
       (= (type (car (EL:Get 'identity record))) 'STR) (EL:PowerValid record)))
(defun EL:DefaultWatts (category) (cond ((= category 'lighting) 5) ((member category '(sign exit)) 1)))
(defun EL:ResolvePower (identity current drawing library / record source)
  (cond ((setq record (EL:By 'identity identity current)) (setq source 'current-input))
        ((setq record (EL:By 'identity identity drawing)) (setq source 'drawing-saved))
        ((setq record (EL:By 'identity identity library)) (setq source 'library-saved)))
  (if record (EL:Put 'source source record)))
(defun EL:ParseWatts (s / n valid c)
  (setq n 0 valid (and (= (type s) 'STR) (> (strlen s) 0)))
  (if valid
    (foreach c (vl-string->list s)
      (if (or (< c 48) (> c 57) (> n 214748364) (and (= n 214748364) (> c 55)))
        (setq valid nil)
        (if valid (setq n (+ (* n 10) (- c 48)))))))
  (if valid n))
(defun EL:LoadLibrary (/ raw result)
  (setq raw (EL:ReadData (strcat *EL:Root* "config/device-library.eld")))
  (if raw
    (progn
      (setq result (vl-catch-all-apply '(lambda ()
        (and (EL:OnlyKeys raw '(version devices)) (= (EL:Get 'version raw) 1)
          (not (vl-some '(lambda (row) (not (EL:PowerShape row))) (EL:Get 'devices raw)))) nil))
      (if (and (not (vl-catch-all-error-p result)) result) (EL:Get 'devices raw)
        (princ "\n项目设备库失效；已保存的无效值不会参与计算，请核对配置。"))))))
(defun EL:CountRows (circuit blocks excluded / rows id block identity row)
  (foreach id (EL:Unique (EL:Get 'devices circuit))
    (setq block (EL:By 'id id blocks))
    (if (and block (= (EL:Get 'role block) 'device) (not (member id excluded)))
      (progn
        (setq identity (EL:Get 'identity block) row (EL:By 'identity identity rows))
        (if row
          (setq rows (subst (EL:Put 'ids (cons id (EL:Get 'ids row)) (EL:Put 'count (1+ (EL:Get 'count row)) row)) row rows))
          (setq rows (cons (list (cons 'identity identity) (cons 'name (EL:Get 'name block))
            (cons 'count 1) (cons 'ids (list id))) rows)))))) (reverse rows))
(defun EL:OwnershipConflicts (circuits / counts circuit id conflicts row)
  (foreach circuit circuits
    (foreach id (EL:Unique (EL:Get 'devices circuit))
      (setq counts (EL:Put id (cons (EL:Get 'id circuit) (EL:Get id counts)) counts))))
  (foreach row counts (if (> (length (cdr row)) 1) (setq conflicts (cons (car row) conflicts)))) conflicts)
(defun EL:CircuitStatistics (circuit blocks excluded cfg library current / rows out issues row record w total good)
  (setq rows (EL:CountRows circuit blocks excluded) total 0 good T)
  (foreach row rows
    (setq record (EL:ResolvePower (EL:Get 'identity row) current (EL:Get 'powers cfg) library))
    (if (EL:PowerValid record)
      (progn
        (setq w (EL:Get 'watts record) total (+ total (* w (EL:Get 'count row)))
              row (EL:Put 'watts w row) row (EL:Put 'subtotal (* w (EL:Get 'count row)) row)
              row (EL:Put 'display (EL:Get 'display record) row) row (EL:Put 'source (EL:Get 'source record) row)))
      (progn
        (setq good nil issues (cons (EL:Issue 'POWER_MISSING_OR_INVALID (EL:Get 'ids row) (EL:Get 'identity row)) issues))))
    (setq out (cons row out)))
  (if (vl-some '(lambda (id) (member id excluded)) (EL:Get 'devices circuit))
    (setq good nil issues (cons (EL:Issue 'DEVICE_OWNERSHIP_CONFLICT (EL:Get 'id circuit) excluded) issues)))
  (setq good (and good (EL:Get 'complete circuit)))
  (setq circuit (EL:Put 'counts (reverse out) circuit) circuit (EL:Put 'watts total circuit)
        circuit (EL:Put 'power-complete good circuit) circuit (EL:Put 'power-issues (reverse issues) circuit)
        circuit (EL:Put 'over-limit (> total 172) circuit))
  (EL:Put 'power-status (cond ((not good) 'incomplete) ((> total 172) 'over-limit) (T 'pass)) circuit))
(defun EL:BoxStatistics (result cfg library current / excluded circuits circuit total allowed)
  (setq excluded (EL:OwnershipConflicts (EL:Get 'circuits result)) total 0 allowed (EL:Get 'complete result))
  (foreach circuit (EL:Get 'circuits result)
    (setq circuit (EL:CircuitStatistics circuit (EL:Get 'blocks (EL:Get 'snapshot result)) excluded cfg library current))
    (if (EL:Get 'power-complete circuit) (setq total (+ total (EL:Get 'watts circuit))))
    (if (/= (EL:Get 'power-status circuit) 'pass) (setq allowed nil))
    (setq circuits (cons circuit circuits)))
  (setq result (EL:Put 'circuits (reverse circuits) result) result (EL:Put 'box-watts total result)
        result (EL:Put 'power-config (list (EL:Get 'powers cfg) library current) result)
        result (EL:Put 'device-conflicts excluded result))
  (EL:Put 'can-generate (and circuits allowed) result))
(defun EL:PowerTableRows (result / rows circuit row old)
  (foreach circuit (EL:Get 'circuits result)
    (foreach row (EL:Get 'counts circuit)
      (setq old (EL:By 'identity (EL:Get 'identity row) rows))
      (if old
        (setq rows (subst (EL:Put 'circuits (cons (list (EL:Get 'id circuit) (EL:Get 'count row)) (EL:Get 'circuits old))
          (EL:Put 'count (+ (EL:Get 'count row) (EL:Get 'count old)) old)) old rows))
        (setq rows (cons (EL:Put 'circuits (list (list (EL:Get 'id circuit) (EL:Get 'count row))) row) rows)))))
  (reverse rows))
(defun EL:PrintStatistics (result / circuit row)
  (foreach circuit (EL:Get 'circuits result)
    (princ (strcat "\n" (EL:Get 'id circuit) "：" (itoa (EL:Get 'watts circuit)) "W，"
      (vl-symbol-name (EL:Get 'power-status circuit))))
    (foreach row (EL:Get 'counts circuit)
      (princ (strcat "\n  " (EL:Get 'name row) " × " (itoa (EL:Get 'count row)) "，"
        (if (EL:Get 'watts row) (strcat (itoa (EL:Get 'watts row)) "W/个") "功率未确认"))))
    (foreach row (EL:Get 'power-issues circuit) (princ (strcat "\n  " (vl-prin1-to-string row)))))
  (princ (strcat "\n已完整识别且功率齐全的回路合计：" (itoa (EL:Get 'box-watts result)) "W。"))
  (if (not (EL:Get 'can-generate result)) (princ "\n存在未解决识别／功率问题或超过 172W，正式生成已禁用。")))
(princ)
