;; Date: 2026-10-12. Keep GB2312 byte pairs intact in the legacy CAD2020 engine.
(defun EL:PanelText (key value / lines line units char cost index limit legacy step width)
  (setq width (if (member key '("dl_asset" "dl_status")) 34 44))
  (setq line "" units 0 index 1 limit (cond ((equal key "p_total") 4) ((member key '("p_error" "dl_status")) 3) (T 2)))
  (setq legacy (= (strlen "中") 2))
  (while (<= index (strlen value))
    (setq char (substr value index 1) cost (if (> (ascii char) 127) 2 1))
    (setq step (if (and legacy (= cost 2)) 2 1)
      char (substr value index step))
    (if (> (+ units cost) width)
      (setq lines (append lines (list line)) line "" units 0))
    (setq line (strcat line char) units (+ units cost) index (+ index step)))
  (setq lines (append lines (list line)) index 0)
  (repeat limit
    (set_tile (if (= index 0) key (strcat key (itoa index))) (cond ((nth index lines)) (T "")))
    (setq index (1+ index)))
  (if (> (length lines) limit) (princ (strcat "\n" value))))
 ;; Date: 2026-10-10. Render the actual block instance in isolation.
(defun EL:ThumbSlideCommand (path)
  (command-s "_.MSLIDE" path))
(defun EL:ThumbRestore (/ item checked pending)
  (foreach item *EL:ThumbHidden*
    ;; Date: 2026-10-12. A rejected hide on a locked layer needs no write to restore.
    (if (not (equal (vl-catch-all-apply 'vla-get-Visible (list (car item))) (cadr item)))
      (progn
        (setq checked (vl-catch-all-apply 'vla-put-Visible (list (car item) (cadr item))))
        (if (or (vl-catch-all-error-p checked)
                (not (equal (vl-catch-all-apply 'vla-get-Visible (list (car item))) (cadr item))))
          (setq pending (cons item pending))))))
  (setq *EL:ThumbHidden* pending)
  (not pending))
(defun EL:ThumbIsolate (block / entity layout selected index object visible data layer)
  (EL:Require (EL:ThumbRestore) "上次图例预览尚未恢复，请运行 ELTHUMBRESET。")
  (setq entity (handent (EL:Get 'id block)))
  (EL:Require entity "图例代表实例已不存在。")
  (setq layout (assoc 410 (entget entity)))
  (EL:Require layout "图例实例不在可预览的图纸空间。")
  (setq selected (ssget "_X" (list layout)) index 0)
  ;; Date: 2026-10-12. Preflight before ANY visibility mutation; use library legend on locked drawings.
  (while (and selected (< index (sslength selected)))
    (setq data (entget (ssname selected index)) layer (tblsearch "LAYER" (cdr (assoc 8 data))))
    (EL:Require (and layer (= (logand (cdr (assoc 70 layer)) 4) 0))
      "当前空间有锁定图层，已跳过现场图例截图；可在 ELDEVLIB 登记独立图例。")
    (setq index (1+ index)))
  (setq index 0)
  (while (and selected (< index (sslength selected)))
    (if (not (equal entity (ssname selected index)))
      (progn
        (setq object (vlax-ename->vla-object (ssname selected index)) visible (vla-get-Visible object))
        (if (= visible :vlax-true)
          (progn
            ;; Register before mutation: cancellation must not lose restoration data.
            (setq *EL:ThumbHidden* (cons (list object visible) *EL:ThumbHidden*))
            (vla-put-Visible object :vlax-false)
            (EL:Require (= (vla-get-Visible object) :vlax-false) "无法隔离图例对象，未生成缩略图。")))))
    (setq index (1+ index))))
(defun EL:ThumbCaptureWork (block path)
  (EL:ThumbIsolate block)
  (setq *EL:ThumbZoomed* T)
  (EL:SimpleZoom (car (EL:Get 'bounds block)) (cadr (EL:Get 'bounds block)))
  (vla-Regen (vla-get-ActiveDocument (vlax-get-acad-object)) 1)
  (EL:ThumbSlideCommand path))
(defun EL:ThumbCapture (block / path checked restored filedia echo screen)
  (setq path (vl-filename-mktemp "el-device-" nil ".sld")
    filedia (getvar "FILEDIA") echo (getvar "CMDECHO") screen (getvar "SCREENSIZE")
    *EL:ThumbZoomed* nil)
  (setq *EL:ThumbSlides* (cons path *EL:ThumbSlides*))
  (setvar "FILEDIA" 0) (setvar "CMDECHO" 0)
  (setq checked (vl-catch-all-apply 'EL:ThumbCaptureWork (list block path)))
  (setq restored (EL:ThumbRestore))
  (setvar "FILEDIA" filedia) (setvar "CMDECHO" echo)
  (if *EL:ThumbZoomed* (vl-catch-all-apply 'vla-ZoomPrevious (list (vlax-get-acad-object))))
  (vl-catch-all-apply 'vla-Regen (list (vla-get-ActiveDocument (vlax-get-acad-object)) 1))
  (EL:Require restored "图例预览恢复失败，请运行 ELTHUMBRESET 后继续。")
  (if (and (not (vl-catch-all-error-p checked)) (findfile path)) (list path screen)))
(defun c:ELTHUMBRESET ()
  (princ (if (EL:ThumbRestore) "\n图例预览可见性已恢复。" "\n仍有对象未恢复，请检查锁层后重试。"))
  (vl-catch-all-apply 'vla-Regen (list (vla-get-ActiveDocument (vlax-get-acad-object)) 1)) (princ))
(defun EL:ThumbCleanup (/ path job)
  (EL:ThumbRestore)
  (foreach path *EL:ThumbSlides* (vl-catch-all-apply 'vl-file-delete (list path)))
  (foreach job *EL:ThumbJobs* (EL:DLCaptureCleanup job))
  (setq *EL:ThumbSlides* nil *EL:ThumbCache* nil *EL:ThumbSources* nil *EL:ThumbJobs* nil *EL:ThumbPending* nil))
;; Date: 2026-10-11. Capture missing legends before DCL; callbacks only reuse files.
(defun EL:ThumbPrepare (result)
  (EL:ThumbCleanup)
  (EL:ClearGapPreview) (EL:ClearPickHighlights)
  (EL:ThumbPrepareRows result T))
(defun EL:ThumbRefresh (result)
  (EL:ThumbPrepareRows result nil))
(defun EL:ThumbPrepareRows (result capture / ids circuit row block geometry snapshot checked entry)
  (setq *EL:ThumbCache* nil)
  (foreach circuit (EL:Get 'circuits result) (setq ids (append ids (EL:Get 'devices circuit))))
  (foreach row (if (assoc 'device-library result) (EL:DLMaterialRows result nil)
    (EL:SimpleRows (vl-remove-if-not '(lambda (b) (member (EL:Get 'id b) ids)) (EL:Get 'blocks (EL:Get 'snapshot result))) nil))
    (setq block (EL:By 'id (car (EL:Get 'ids row)) (EL:Get 'blocks (EL:Get 'snapshot result)))
      snapshot (cond (*EL:DLSessionSnapshot*) (T *EL:DLCache*))
      geometry nil)
    (setq entry (if (and (EL:Get 'entry row)
      (equal (EL:Get 'library-id row) (EL:Get 'library-id (EL:Get 'catalog snapshot)))) (EL:Get 'entry row)
      (if (not (EL:Get 'entry row)) (EL:DLFindEntry (EL:Get 'name row) snapshot))))
    (if (and (assoc 'device-library result) entry)
      (setq geometry (vl-catch-all-apply 'EL:PerfCall
        (list "DEVICE_LEGEND" 'EL:DLLegend (list entry snapshot)))))
    (if (vl-catch-all-error-p geometry) (setq geometry nil))
    (if (and (not geometry) block)
      (if (setq checked (assoc (EL:Get 'id block) *EL:ThumbSources*)) (setq geometry (cdr checked))
        (if capture (progn
          ;; Date: 2026-10-12. Native multi-document capture never hides source objects.
          (if (equal (getvar "SDI") 0)
            (if (not (EL:By 'id (EL:Get 'id block) *EL:ThumbPending*))
              (setq *EL:ThumbPending* (append *EL:ThumbPending* (list block))))
            (progn
              (setq geometry (vl-catch-all-apply 'EL:ThumbCapture (list block)))
              (if (vl-catch-all-error-p geometry) (setq geometry nil))
              (setq *EL:ThumbSources* (cons (cons (EL:Get 'id block) geometry) *EL:ThumbSources*))))))))
    (EL:Require (EL:ThumbRestore) "图例预览恢复失败，请运行 ELTHUMBRESET 后继续。")
    (if (and (not geometry) (not (EL:By 'id (EL:Get 'id block) *EL:ThumbPending*))) (EL:LogEvent "DEVICE_LEGEND_MISSING"
      (list (cons 'name (EL:Get 'name row)) (cons 'id (EL:Get 'id block)))))
    (setq *EL:ThumbCache* (cons (cons (EL:Get 'name row) geometry) *EL:ThumbCache*))))
;; Date: 2026-10-12. Reuse the owned-DWG capture path; resume the same panel after all slides.
(defun EL:ThumbBatchNext (/ block entity snapshot checked suspended)
  (while (and *EL:ThumbPending* (not suspended))
    (setq block (car *EL:ThumbPending*) *EL:ThumbPending* (cdr *EL:ThumbPending*)
      *EL:ThumbActive* block entity (handent (EL:Get 'id block))
      checked nil snapshot (list (cons 'root (strcat *EL:Root* "output/thumb-preview/"))))
    (if entity
      (progn (setq *EL:DLContinue* 'EL:ThumbBatchResume
        checked (vl-catch-all-apply 'EL:DLCaptureStart (list snapshot block entity)))
        (if (or (and (not (vl-catch-all-error-p checked)) checked) *EL:DLCaptureJob*) (setq suspended T))))
    (if (not suspended)
      (progn
        (setq *EL:DLContinue* nil *EL:ThumbSources* (cons (cons (EL:Get 'id block) nil) *EL:ThumbSources*))
        (EL:LogEvent "DEVICE_PREVIEW_FAILED" (list (cons 'id (EL:Get 'id block))
          (cons 'message (if (vl-catch-all-error-p checked) (vl-catch-all-error-message checked) "source or capture unavailable")))))))
  (if suspended 'suspended T))
(defun EL:ThumbBatchResume (entry / job geometry context result)
  (setq *EL:DLContinue* nil job (EL:Get 'captured entry))
  (if job
    (progn (setq geometry (list (EL:Get 'slide job) (EL:DLSLDSize (EL:Get 'slide job))))
      (setq *EL:ThumbJobs* (cons job *EL:ThumbJobs*))))
  (setq *EL:ThumbSources* (cons (cons (EL:Get 'id *EL:ThumbActive*) geometry) *EL:ThumbSources*))
  (if (not (equal (EL:ThumbBatchNext) 'suspended))
    (progn
      (setq context *EL:ThumbParentContext* *EL:ThumbParentContext* nil *EL:DLResume* context)
      (if context
        (progn (EL:PerfStart "ELSTAT") (setq result (EL:EditPanel (EL:Get 'result context) (EL:Get 'config context)))
          (EL:PerfFinish (if result 'returned 'cancelled)))))))
(defun EL:ThumbDraw (key geometry / w h screen scale sw sh checked shown)
  (setq w (dimx_tile key) h (dimy_tile key))
  (start_image key) (fill_image 0 0 w h -15)
  (if (and geometry (findfile (car geometry)) (setq screen (cadr geometry))
      (numberp (car screen)) (> (car screen) 0) (numberp (cadr screen)) (> (cadr screen) 0))
    (progn
      (fill_image 0 0 w h -2)
      (setq scale (min (/ (float w) (car screen)) (/ (float h) (cadr screen)))
        sw (max 1 (fix (* scale (car screen)))) sh (max 1 (fix (* scale (cadr screen)))))
      (setq checked (vl-catch-all-apply 'slide_image
        (list (fix (/ (- w sw) 2)) (fix (/ (- h sh) 2)) sw sh (car geometry)))
        shown (and (not (vl-catch-all-error-p checked)) checked))
      (if (not shown) (progn (fill_image 0 0 w h -15)
        (EL:LogEvent "DEVICE_LEGEND_DRAW_FAILED" (list (cons 'tile key) (cons 'path (car geometry))
          (cons 'message (if (vl-catch-all-error-p checked) (vl-catch-all-error-message checked) "slide_image returned nil"))))))))
  (end_image) shown)
;; Date: 2026-10-10. Main table shows images only; legacy review keeps captions.
(defun EL:ThumbFill () (EL:ThumbFillRows T))
(defun EL:ThumbFillRows (captions / i row key geometry size shown)
  (setq i 0 size (if captions 4 8))
  (repeat size
    (setq key (itoa i) row (nth (+ *EL:ThumbPage* i) *EL:ThumbRows*) geometry nil)
    (if row (setq geometry (cdr (assoc (EL:Get 'name row) *EL:ThumbCache*))))
    (setq shown (EL:ThumbDraw (strcat "f_image" key) geometry))
    (if captions (progn
    (set_tile (strcat "f_count" key) (if row (strcat "数量：" (itoa (EL:Get 'count row))) ""))
    (set_tile (strcat "f_hint" key) (cond ((not row) "") ((not shown) "预览失败，点击在图面查看")
      (T "独立图例，点击定位")))))
    (setq i (1+ i)))
  (set_tile "f_page" (strcat (itoa (1+ (fix (/ *EL:ThumbPage* size)))) " / "
    (itoa (max 1 (fix (/ (+ (length *EL:ThumbRows*) (1- size)) size))))))
  (mode_tile "f_prev" (if (> *EL:ThumbPage* 0) 0 1))
  (mode_tile "f_next" (if (< (+ *EL:ThumbPage* size) (length *EL:ThumbRows*)) 0 1)))
(defun EL:ThumbPage (delta)
  (setq *EL:ThumbPage* (max 0 (min (+ *EL:ThumbPage* delta)
    (* 4 (fix (/ (max 0 (1- (length *EL:ThumbRows*))) 4))))))
  (EL:ThumbFill))
(defun EL:ThumbActions (/ i key)
  (setq i 0)
  (repeat 4
    (setq key (itoa i))
    (action_tile (strcat "f_image" key) (strcat "(EL:ThumbRequest " key ")"))
    (setq i (1+ i)))
  (action_tile "f_prev" "(EL:ThumbPage -4)")
  (action_tile "f_next" "(EL:ThumbPage 4)"))
;; Date: 2026-10-09. Draft-only paged circuit table with real per-row toggles.
