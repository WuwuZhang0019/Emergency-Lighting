;; Date: 2026-10-11. Compare exact typed source data; never print a whole large snapshot.
;; The version tag distinguishes old serialized signatures and triggers one normal update.
(defun EL:FixedSourceSignature (snapshot)
  (list 'EL_FIXED_SOURCE_V1 (EL:StableData snapshot)))
(defun EL:CircuitSnapshot (snapshot panel / blocks b)
  (foreach b (EL:Get 'blocks snapshot)
    (setq blocks (cons (EL:Put 'identity (list (EL:Get 'name b) nil "block-name-v1")
      (EL:Put 'role (if (equal (EL:Get 'id b) panel) 'panel 'device) b)) blocks)))
  (EL:Put 'signature (EL:LogCall "SNAPSHOT_SIGNATURE" nil 'EL:FixedSourceSignature (list snapshot)) (EL:Put 'blocks (reverse blocks) snapshot)))
(defun EL:SplitNetwork (network cfg / snapshot panel edges seeds wire block i circuits result circuit
    *EL:DeviceContactCache* *EL:DeviceTemplateCache* *EL:DeviceTemplateEnabled*)
  (setq snapshot (EL:CircuitSnapshot (EL:Get 'snapshot network) (EL:Get 'panel network))
        panel (EL:Get 'panel network) block (EL:By 'id panel (EL:Get 'blocks snapshot)) i 0)
  (foreach wire (vl-sort (EL:Get 'wires snapshot) '(lambda (a b) (< (EL:Get 'id a) (EL:Get 'id b))))
    (if (if (EL:Get 'trunk-segments snapshot)
          (member (EL:Get 'id wire) (EL:Get 'trunk-roots snapshot)) (EL:PathBlockHit wire block cfg))
      (progn (setq i (1+ i))
        (setq seeds (cons (list (cons 'id (strcat "R" (itoa i))) (cons 'wire (EL:Get 'id wire))
          (cons 'key (list (EL:Get 'id wire) 'outlet))) seeds)))))
  (setq edges (vl-remove-if '(lambda (e) (member panel e)) (EL:Get 'edges network)))
  (setq *EL:DeviceTemplateEnabled* T)
  (foreach wire (reverse seeds)
    (setq circuit (EL:PerfCall "CIRCUIT_TRACE" 'EL:TraceCircuit
      (list wire snapshot edges (EL:Get 'gap-issues network))))
    (setq circuit (EL:Put 'number-scope (EL:PerfCall "CIRCUIT_NUMBER_SCOPE" 'EL:ExitNumberScope
      (list wire network cfg)) circuit) circuits (cons circuit circuits)))
  (foreach wire (reverse circuits)
    (EL:LogEvent "CIRCUIT_TRACE_RESULT" (list (cons 'id (EL:Get 'id wire))
      (cons 'wires (EL:Get 'wires wire)) (cons 'devices (EL:Get 'devices wire))
      (cons 'complete (EL:Get 'complete wire)) (cons 'issues (EL:Get 'issues wire)))))
  (list (cons 'panel panel) (cons 'drawing (EL:Get 'drawing snapshot)) (cons 'snapshot snapshot)
    (cons 'rules (EL:RecognitionRules cfg)) (cons 'circuits (reverse circuits))
    (cons 'complete (and circuits (not (EL:Get 'issues snapshot))
      (vl-every '(lambda (c) (EL:Get 'complete c)) circuits))) (cons 'engine 'fixed)))
(defun EL:NamePowerRecords (result powers / records b w entry)
  (foreach b (EL:Get 'blocks (EL:Get 'snapshot result))
    (setq w (EL:Get (strcase (EL:Get 'name b)) powers))
    (if (numberp w)
      (setq records (cons (list (cons 'identity (EL:Get 'identity b)) '(category . other)
        (cons 'display (if (and (assoc 'device-library result) (setq entry (EL:Get 'entry (EL:DLReference (EL:Get 'name b) result))))
          (EL:Get 'display entry) (EL:Get 'name b))) (cons 'watts w) '(zero-confirmed . T)) records)))) records)
(defun EL:SelectFixedExits (result excluded / circuits keys)
  (setq keys (mapcar '(lambda (c) (EL:Get 'key (EL:Get 'seed c))) (EL:Get 'circuits result))
    circuits (vl-remove-if '(lambda (c) (member (EL:Get 'key (EL:Get 'seed c)) excluded)) (EL:Get 'circuits result)))
  (EL:Put 'candidate-keys keys (EL:Put 'excluded-seeds excluded (EL:Put 'circuits circuits
    (EL:Put 'complete (and circuits (not (EL:Get 'issues (EL:Get 'snapshot result)))
      (vl-every '(lambda (c) (EL:Get 'complete c)) circuits)) result)))))
(defun EL:FixedExitDevices (/ indices ids i c rows row)
  ;; Show recognition already completed before exit confirmation. Counts are
  ;; unique block instances even when conflicting candidates share devices.
  (setq indices (read (strcat "(" *EL:FixedExitSelection* ")")))
  (foreach i indices
    (setq c (nth i (EL:Get 'circuits *EL:FixedExitResult*)) ids (append (EL:Get 'devices c) ids)))
  (setq ids (EL:Unique ids) rows (EL:SimpleRows
    (vl-remove-if-not '(lambda (b) (member (EL:Get 'id b) ids)) (EL:Get 'blocks *EL:ExitSnapshot*)) nil))
  (setq *EL:ThumbRows* rows *EL:ThumbPage* 0)
  (EL:ThumbFill)
  (set_tile "f_status" (cond
    ((not indices) "尚未选择出线，请选择实际回路。")
    ((not ids) "所选出线未识别到设备，请核对连接。")
    (T (strcat "所选出线已识别 " (itoa (length ids)) " 个设备，右侧填写功率。")))))
(defun EL:FixedExitHighlight (result value / snapshot indices index circuit wires devices id wire block bounds lo hi seg pad)
  ;; Date: 2026-10-09. Preview the traced circuit, not only its outlet seed.
  (EL:ClearGapPreview) (EL:ClearPickHighlights)
  (setq snapshot (EL:Get 'snapshot result) indices (read (strcat "(" value ")")))
  (foreach index indices
    (setq circuit (nth index (EL:Get 'circuits result))
      wires (append (EL:Get 'wires circuit) wires) devices (append (EL:Get 'devices circuit) devices)))
  (setq wires (EL:Unique wires) devices (EL:Unique devices))
  (foreach id (append wires devices)
    (setq wire (EL:By 'id id (EL:Get 'wires snapshot)) block (EL:By 'id id (EL:Get 'blocks snapshot))
      bounds (if wire (EL:SegmentBounds (EL:Get 'segments wire)) (EL:Get 'bounds block)))
    (if bounds (setq lo (if lo (mapcar 'min lo (car bounds)) (car bounds))
      hi (if hi (mapcar 'max hi (cadr bounds)) (cadr bounds)))))
  ;; Zoom first: a later zoom would erase the transient overlay.
  (if lo (vl-catch-all-apply 'EL:SimpleZoom (list lo hi)))
  (setq pad (/ (getvar "VIEWSIZE") 150.0))
  (foreach id wires
    (if (not (EL:Get 'source-wire (EL:By 'id id (EL:Get 'wires snapshot)))) (EL:LocateID id))
    (foreach seg (EL:Get 'segments (EL:By 'id id (EL:Get 'wires snapshot)))
      (EL:DrawTransient (car seg) (cadr seg) 2)))
  (foreach id devices
    (EL:LocateID id)
    (setq bounds (EL:Get 'bounds (EL:By 'id id (EL:Get 'blocks snapshot))))
    (if bounds
      (foreach seg (EL:BoundsSegments (EL:ExpandedBlockBounds bounds pad))
        (EL:DrawTransient (car seg) (cadr seg) 4))))
  (princ (if indices (strcat "\n黄色：所选回路导线 " (itoa (length wires))
    " 条；青色框：已识别设备 " (itoa (length devices)) " 个。按当前识别范围显示，待核对回路可能不完整。")
    "\n未选择出线，没有可预览的回路。")))
;; Date: 2026-10-10. Independent display copies preserve source/block colors.
(defun EL:CircuitColor (index)
  (nth (fix (rem index 24)) '(1 3 5 6 2 4 30 140 210 80 10 170 40 150 220 90 20 180 50 160 230 100 60 190)))
;; Date: 2026-10-11. Resolve source ByLayer/true colors before choosing preview colors.
(defun EL:ACIColorRGB (index / hue sector fraction high low middle value)
  (cond ((<= index 9) (nth index '((255 255 255) (255 0 0) (255 255 0) (0 255 0)
      (0 255 255) (0 0 255) (255 0 255) (255 255 255) (128 128 128) (192 192 192))))
    ((>= index 250) (setq value (nth (- index 250) '(51 80 105 130 190 255))) (list value value value))
    (T
      (setq hue (fix (/ (- index 10) 10)) sector (fix (/ hue 4)) fraction (/ (rem hue 4) 4.0)
        high (nth (fix (/ (rem (- index 10) 10) 2)) '(255 204 153 127 76))
        low (if (= (rem index 2) 1) (fix (/ high 2.0)) 0)
        middle (fix (+ low (* (- high low) (if (= (rem sector 2) 0) fraction (- 1.0 fraction))))))
      (nth sector (list (list high middle low) (list middle high low) (list low high middle)
        (list low middle high) (list middle low high) (list high low middle))))))
(defun EL:PreviewEntityRGB (id / entity data color rgb)
  (if (and (setq entity (handent id)) (setq data (entget entity)))
    (progn
      (setq color (cond ((cdr (assoc 62 data))) (T 256)))
      (if (and (not (assoc 420 data)) (= color 256))
        (setq data (tblsearch "LAYER" (cdr (assoc 8 data)))))
      (if (setq rgb (cdr (assoc 420 data)))
        (list (logand 255 (fix (/ rgb 65536))) (logand 255 (fix (/ rgb 256))) (logand 255 rgb))
        (EL:ACIColorRGB (abs (cond ((cdr (assoc 62 data))) (T 7))))))))
(defun EL:PreviewPalette (result / ids wire circuit id colors rgb choices palette used candidate)
  (foreach wire (EL:Get 'wires (EL:Get 'snapshot result))
    (setq ids (cons (cond ((EL:Get 'source-wire wire)) ((EL:Get 'id wire))) ids)))
  (if (not ids)
    (foreach circuit (EL:Get 'circuits result) (setq ids (append ids (EL:Get 'wires circuit)))))
  (foreach id (EL:Unique ids)
    (if (setq rgb (EL:PreviewEntityRGB id)) (setq colors (cons rgb colors))))
  (setq choices '(4 6 2 5 3 30 140 210 80 170 40 150 220 90 20 180 50 160 230 100 60 190 7 1)
    candidate 10)
  (repeat 48 (setq choices (append choices (list candidate))
    candidate (+ candidate (if (= (rem candidate 10) 0) 1 9))))
  (foreach candidate choices
    (setq rgb (EL:ACIColorRGB candidate))
    (if (and (not (member rgb used))
        (not (vl-some '(lambda (source) (< (EL:Dot (EL:V- rgb source) (EL:V- rgb source)) 10000.0)) colors)))
      (setq palette (append palette (list candidate)) used (cons rgb used))))
  palette)
(defun EL:ColorPreviewCleanup (/ item checked pending)
  (foreach item *EL:ColorPreviewCopies*
    (setq checked (vl-catch-all-apply 'vla-Delete (list item)))
    (if (vl-catch-all-error-p checked) (setq pending (cons item pending))))
  (setq *EL:ColorPreviewCopies* pending pending nil)
  (foreach item *EL:ColorPreviewSources*
    (setq checked (vl-catch-all-apply 'vla-put-Visible (list (car item) (cadr item))))
    (if (vl-catch-all-error-p checked) (setq pending (cons item pending))))
  (setq *EL:ColorPreviewSources* pending)
  (redraw)
