;; Date: 2026-10-11. Log initial DCL stages even before any model pick.
(defun EL:PanelStartDialog (/ dialog status switched ownlog path managed *EL:PanelDraft* *EL:HistoryRecords* *EL:HistoryIndex*)
  (setq ownlog (not *EL:LogActive*))
  (if ownlog (EL:LogStart))
  (setq path (strcat *EL:Root* "ui/power.dcl") status 3
    dialog (EL:LogCall "PANEL_START_LOAD" (list (cons 'path path)) 'load_dialog (list path))
    *EL:DialogID* dialog)
  (if (<= dialog 0)
    (progn (EL:LogEvent "PANEL_START_UNAVAILABLE" (list (cons 'path path) (cons 'dialog dialog)))
      (alert (strcat "无法加载统计面板，请重新解压完整交付包后加载：\n" path)) (setq status 0)))
  (while (and (= status 3) (> dialog 0))
    (if (EL:LogCall "PANEL_START_NEW" '((name . "el_panel")) 'new_dialog (list "el_panel" dialog))
    (progn
      (EL:LogCall "PANEL_START_INIT" nil 'EL:PanelStartInit nil)
      (setq status (EL:LogCall "PANEL_START_WAIT" nil 'EL:PerfInput (list 'start_dialog nil)))
      (EL:LogEvent "PANEL_START_RETURN" (list (cons 'status status)))
      (if (= status 8)
        (progn
          (setq switched (vl-catch-all-apply 'EL:HistoryOpen nil))
          (if (vl-catch-all-error-p switched)
            (progn (alert (strcat "打开记录未完成：" (vl-catch-all-error-message switched)))
              (setq switched nil status 3))))))
    (progn
      (EL:LogEvent "PANEL_START_UNAVAILABLE" '((name . "el_panel")))
      (alert "无法创建统计面板，请重新加载当前版本的完整交付包。") (setq status 0))))
  (if (> dialog 0) (unload_dialog dialog)) (setq *EL:DialogID* nil)
  (if ownlog (EL:LogFinish 'initial-panel-finished))
  (if (= status 11)
    (progn
      (setq *EL:DLParentContinue* 'c:ELSTAT managed (vl-catch-all-apply 'EL:DLUIOpen nil))
      (if (vl-catch-all-error-p managed) (princ (strcat "\n设备库未打开：" (vl-catch-all-error-message managed))))
      (if (not (equal managed 'suspended)) (progn (setq *EL:DLParentContinue* nil) (EL:PanelStartDialog))))
  (if switched switched
    (if (member status '(9 10)) (list (cons 'pick-panel (if (= status 10) 'trunk T)))))))

