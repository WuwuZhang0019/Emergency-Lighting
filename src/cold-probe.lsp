;; Date: 2026-10-22. Independent read-only cold-path experiment; never publishes results.
;; Date: 2026-10-22. APPLY/catch must target an already defined Lisp function.
;; Resolve the external .NET function inside that protected function body.
;; Date: 2026-10-22. Bounded checkpoints preserve context across catch/cleanup.
(defun EL:ColdCheckpoint (phase details / item)
  (foreach item details
    (setq *EL:ColdContext* (EL:Put (car item) (cdr item) *EL:ColdContext*)))
  (setq *EL:ColdContext* (EL:Put 'phase phase *EL:ColdContext*))
  (EL:LogEvent "COLD_CHECKPOINT" (list (cons 'phase phase) (cons 'details details))))
(defun EL:ColdFailure (message)
  (EL:LogEvent "COLD_FAILURE" (list (cons 'error message) (cons 'context *EL:ColdContext*)))
  (princ (strcat "\n原型失败阶段：" (EL:LogText (EL:Get 'phase *EL:ColdContext*))
    "\n原型诊断上下文：" (EL:LogText *EL:ColdContext*))))
(defun EL:ColdReplySummary (reply / payload textdata)
  (setq payload (EL:ColdNativePayload reply)
    textdata (if (and (listp payload) (equal (type (car payload)) 'STR)) (car payload)))
  (list (cons 'reply-type (type reply)) (cons 'payload-type (type payload))
    (cons 'native-status (cond
      ((and textdata (vl-string-search "\"status\":\"PROTOTYPE_COARSE_ONLY\"" textdata)) "PROTOTYPE_COARSE_ONLY")
      ((and textdata (vl-string-search "\"status\":\"ERROR\"" textdata)) "ERROR") (T "UNRECOGNIZED")))
    (cons 'json-length (if textdata (strlen textdata)))
    (cons 'json-prefix (if textdata (substr textdata 1 4096)))
    (cons 'json-truncated (and textdata (> (strlen textdata) 4096)))))
(defun EL:ColdNativePing ()
  (ELNETCOLD78 "EL_NET_COLD_PING_V1"))
(defun EL:ColdNativeInvoke (selection panel roots tolerance dmax boundary reportpath)
  (ELNETCOLD78 selection panel roots tolerance dmax boundary reportpath))
(defun EL:ColdNativeReady (/ reply ready)
  (EL:LogEvent "COLD_NATIVE_HANDSHAKE_BEGIN" (list (cons 'entry "ELNETCOLD78")))
  (setq reply (vl-catch-all-apply 'EL:ColdNativePing nil)
    ready (and (not (vl-catch-all-error-p reply))
      (or (and (equal (type reply) 'STR) (equal reply "EL_NET_COLD_PROBE_V1/0.1.78"))
        (and (listp reply) (= (length reply) 1) (equal (type (car reply)) 'STR)
          (equal (car reply) "EL_NET_COLD_PROBE_V1/0.1.78")))))
  (EL:LogEvent "COLD_NATIVE_HANDSHAKE" (list (cons 'ready ready)
    (cons 'response (if (not (vl-catch-all-error-p reply)) reply))
    (cons 'error (if (vl-catch-all-error-p reply) (vl-catch-all-error-message reply)))))
  ready)
(defun EL:ColdNativePayload (reply)
  ;; ResultBuffer list marshalling may enclose the explicit outer ListBegin.
  ;; Accept at most that one envelope; the payload/status check remains strict.
  (if (and (listp reply) (= (length reply) 1) (listp (car reply))) (car reply) reply))
(defun EL:ColdLoad (/ path)
  (if (not (EL:ColdNativeReady))
    (progn
      (setq path (strcat *EL:Root* "native/EmergencyLighting.ColdRecognition78.dll"))
      (EL:Require (findfile path) "缺少只读 .NET 原型 DLL，请保留完整 v0.1.78 交付目录。")
      (EL:LogEvent "COLD_NATIVE_LOAD_BEGIN" (list (cons 'dll path)))
      (command "_.NETLOAD" path)
      (EL:LogEvent "COLD_NATIVE_LOAD_RETURNED" (list (cons 'dll path)))))
  (EL:Require (EL:ColdNativeReady)
    "只读 .NET 原型握手失败，尚未开始采集；请检查 NETLOAD 错误及受信任路径，运行 ELDIAG 导出加载详情。"))
(defun EL:ColdRootHandles (cfg / text row)
  (setq text "")
  (foreach row (EL:Get 'circuit-starts cfg)
    (setq text (strcat text (if (= text "") "" ",") (EL:Get 'wire row)))) text)
(defun EL:ColdLegacy (cfg panel / *EL:CollectMemo* *EL:NetworkMemo* *EL:RecognitionContacts*
    *EL:StableSnapshotMemo* *EL:StoreReadCache* *EL:NetworkReuseDisabled*)
  ;; Dynamic bindings isolate all whole-result reuse, including the first new panel.
  (setq *EL:NetworkReuseDisabled* T)
  (EL:RecognizeFixed cfg panel))
(defun EL:ColdBoundsAudit (samples / row actual checked missing different verdict)
  ;; This COM parity audit is outside managed timing and is separately reported.
  (setq checked 0 missing 0 different 0)
  (foreach row samples
    (setq actual (if (handent (car row)) (EL:EntityBounds (handent (car row)))))
    (setq checked (1+ checked))
    (setq verdict (cond ((not actual) (setq missing (1+ missing)) 'missing)
      ((not (equal actual (cdr row) 0.000001)) (setq different (1+ different)) 'different)
      (T 'matching)))
    ;; Native reports at most 16 samples; retain a hard diagnostic cap as well.
    (if (<= checked 16)
      (EL:LogEvent "COLD_BOUNDS_SAMPLE" (list (cons 'handle (car row))
        (cons 'expected (cdr row)) (cons 'actual actual) (cons 'verdict verdict)))))
  (list (cons 'checked checked) (cons 'missing missing) (cons 'different different)))
(defun EL:ColdReportPath (extension)
  (strcat *EL:Root* "output/ELCOLD78-" (rtos (getvar "CDATE") 2 8)
    "-" (itoa (EL:Tick)) extension))
(defun EL:ColdRun (/ mode pick panel saved cfg started loaded selected returned audited finished
    owner epoch ss payload audit nativepath reportpath report legacy legacy-start legacy-end result rows row)
  (setq *EL:ColdCompleted* nil *EL:ColdContext* nil)
  ;; Date: 2026-10-22. An early failure must not export a previous run's reports.
  (setq *EL:ColdReports* (EL:Put (namedobjdict) nil *EL:ColdReports*))
  (EL:ColdCheckpoint "MODE" (list '(diagnostic-revision . "2026-10-22-logs1")))
  (princ "\nELCOLD78：只读冷路径性能原型；当前 .NET 仅验证批量读取、索引及保守候选发现，不替代完整识别。")
  (initget "Prototype Both")
  (setq mode (getkword "\n模式 [仅原型(Prototype)/完整旧路径对照(Both)] <Prototype>："))
  (if (not mode) (setq mode "Prototype"))
  (EL:ColdCheckpoint "PICK_PANEL" (list (cons 'mode mode)))
  (if (setq pick (EL:PickModel 'panel "\n拾取本次测试的新配电箱："))
    (progn
      (setq panel (cdr (assoc 5 (entget (car pick)))))
      (EL:Require (not (EL:ManagedEntity (car pick))) "请选择平面配电箱。")
      (EL:ColdCheckpoint "LOAD_CONFIG" (list (cons 'panel panel) (cons 'drawing (EL:DrawingID))))
      (setq saved (EL:LoadConfig))
      (EL:Require saved "图纸配置读取失败，请先检查现有识别预设。")
      (setq cfg (EL:Put 'roles (EL:Get 'roles saved) (EL:Put 'auto-panel panel
        (EL:Put 'params (EL:FixedRecognitionParams saved)
          (EL:PresetConfig (EL:DefaultConfig (EL:DrawingID)))))))
      (EL:ColdCheckpoint "PRESET_READY" nil)
      (if (and (setq cfg (EL:PresetReady (car pick) cfg))
          (progn (EL:ColdCheckpoint "PICK_STARTS" nil) (setq cfg (EL:PickCircuitStarts cfg))))
        (progn
          ;; Start before clearing the pick overlay, selecting, NETLOAD and the first JIT.
          (setq started (EL:Tick))
          (EL:ClearGapPreview) (EL:ClearPickHighlights)
          (EL:ColdCheckpoint "NATIVE_LOAD" (list (cons 'roots (EL:ColdRootHandles cfg))
            (cons 'root-count (length (EL:Get 'circuit-starts cfg)))
            (cons 'circuit-starts (EL:Get 'circuit-starts cfg))
            (cons 'device-tolerance (EL:DeviceContactTolerance cfg))
            (cons 'dmax (EL:Get 'Dmax (EL:Get 'params cfg)))
            (cons 'boundary-tolerance (EL:Get 'eps_boundary (EL:Get 'params cfg)))))
          (EL:PerfCall "COLD_NATIVE_LOAD" 'EL:ColdLoad nil)
          (setq loaded (EL:Tick) owner (namedobjdict) epoch *EL:FreshEpoch*
            nativepath (EL:ColdReportPath ".json") reportpath (EL:ColdReportPath ".eld"))
          (EL:ColdCheckpoint "SELECTION" (list (cons 'native-report nativepath) (cons 'comparison-report reportpath)
            (cons 'wire-layers (EL:Get 'wire-layers cfg))
            (cons 'panel-layers (EL:Get 'panel-layers cfg)) (cons 'device-layers (EL:Get 'device-layers cfg))))
          (setq ss (EL:PresetSelection cfg "INSERT,LINE,LWPOLYLINE" '(wire-layers panel-layers device-layers))
            selected (EL:Tick))
          ;; Register paths before native dispatch so ELDIAG includes failed native reports.
          (setq *EL:ColdReports* (EL:Put owner (list nativepath reportpath) *EL:ColdReports*))
          (EL:ColdCheckpoint "NATIVE_PROBE" (list (cons 'selection-type (type ss))
            (cons 'selection-count (if ss (sslength ss)))))
          (EL:Require ss "预设范围没有可测试对象。")
          (EL:LogEvent "COLD_NATIVE_PROBE_BEGIN" (list (cons 'entry "ELNETCOLD78")
            (cons 'panel panel) (cons 'roots (EL:ColdRootHandles cfg)) (cons 'report nativepath)))
          (setq payload (EL:MeasuredCatch 'EL:PerfCall (list "COLD_NATIVE_PROBE" 'EL:ColdNativeInvoke
            (list ss (handent panel) (EL:ColdRootHandles cfg)
              (EL:DeviceContactTolerance cfg) (EL:Get 'Dmax (EL:Get 'params cfg))
              (EL:Get 'eps_boundary (EL:Get 'params cfg)) nativepath))))
          (if (vl-catch-all-error-p payload)
            (progn
              (EL:LogEvent "COLD_NATIVE_PROBE_FAILED"
                (list (cons 'error (vl-catch-all-error-message payload)) (cons 'report nativepath)))
              (EL:Require nil (strcat "只读 .NET 原型调用失败：" (vl-catch-all-error-message payload)))))
          (EL:ColdCheckpoint "PAYLOAD_VALIDATE" (list (cons 'native-return (EL:ColdReplySummary payload))))
          (EL:LogEvent "COLD_NATIVE_RETURN" (EL:Get 'native-return *EL:ColdContext*))
          (setq payload (EL:ColdNativePayload payload) returned (EL:Tick))
          (if (not (and (listp payload) (equal (type (car payload)) 'STR)
              (vl-string-search "\"status\":\"PROTOTYPE_COARSE_ONLY\"" (car payload))))
            (EL:LogEvent "COLD_NATIVE_PROBE_FAILED" (EL:Get 'native-return *EL:ColdContext*)))
          (EL:Require (and (listp payload) (equal (type (car payload)) 'STR)
              (vl-string-search "\"status\":\"PROTOTYPE_COARSE_ONLY\"" (car payload)))
            "只读 .NET 原型失败，未产生识别结果；请导出 ELDIAG 检查原型报告。")
          (EL:ColdCheckpoint "BOUNDS_AUDIT" nil)
          (setq audit (EL:ColdBoundsAudit (cadr payload)) audited (EL:Tick))
          (EL:LogEvent "COLD_BOUNDS_AUDIT" audit)
          (EL:ColdCheckpoint "SOURCE_GUARD" (list (cons 'bounds-audit audit)
            (cons 'owner-same (equal owner (namedobjdict))) (cons 'epoch-before epoch)
            (cons 'epoch-after *EL:FreshEpoch*)))
          (EL:Require (and (equal owner (namedobjdict)) (equal epoch *EL:FreshEpoch*))
            "SOURCE_CHANGED：测试期间源图或当前图纸已变化，本次对照无效。")
          (if (equal mode "Both")
            (progn
              (princ "\n.NET 候选阶段完成；继续执行完整旧路径只读对照，另计耗时。")
              (EL:ColdCheckpoint "LEGACY_RECOGNITION" nil)
              (setq legacy-start (EL:Tick) result (EL:ColdLegacy cfg panel) legacy-end (EL:Tick))
              (EL:LogEvent "COLD_LEGACY_RETURN" (list (cons 'elapsed-ms (EL:PerfDelta legacy-start legacy-end))
                (cons 'result-type (type result)) (cons 'circuits (length (EL:Get 'circuits result)))
                (cons 'issues (EL:Get 'issues result))))
              (setq legacy (list '(status . legacy-full-readonly)
                (cons 'circuits (length (EL:Get 'circuits result)))
                (cons 'result (EL:DiagnosticResult result))))))
          (EL:ColdCheckpoint "FINAL_SOURCE_GUARD" (list (cons 'owner-same (equal owner (namedobjdict)))
            (cons 'epoch-after *EL:FreshEpoch*)))
          (setq finished (EL:Tick))
          (EL:Require (and (equal owner (namedobjdict)) (equal epoch *EL:FreshEpoch*))
            "SOURCE_CHANGED：完整对照期间源图或当前图纸已变化，本次对照无效。")
          (EL:ColdCheckpoint "REPORT_WRITE" nil)
          (setq report (list '(version . 1) '(date . "2026-10-22") '(package . "v0.1.78")
            '(diagnostic-revision . "2026-10-22-logs1")
            (cons 'legacy-executed (equal mode "Both"))
            (cons 'bounds-audit-passed (and (= (EL:Get 'missing audit) 0) (= (EL:Get 'different audit) 0)))
            '(status . prototype-coarse-only) '(complete-native-recognition . nil)
            '(target-full-recognition-ms . 3000) '(target-achieved . unverified)
            '(readonly-drawing . T) '(previous-result-cache . nil)
            (cons 'drawing (EL:DrawingID)) (cons 'panel panel) (cons 'mode mode)
            (cons 'config cfg) (cons 'native-report nativepath)
            (cons 'load-and-clear-ms (EL:PerfDelta started loaded))
            (cons 'selection-and-path-ms (EL:PerfDelta loaded selected))
            (cons 'managed-bridge-ms (EL:PerfDelta selected returned))
            (cons 'bounds-audit-ms (EL:PerfDelta returned audited))
            (cons 'prototype-pick-to-return-ms (EL:PerfDelta started audited))
            (cons 'legacy-full-ms (if legacy-start (EL:PerfDelta legacy-start legacy-end)))
            (cons 'end-to-end-ms (EL:PerfDelta started finished)) (cons 'bounds-audit audit)
            (cons 'legacy legacy)))
          (EL:Require (EL:WriteData reportpath report) "原型对照报告写入失败。")
          (setq *EL:ColdReports* (EL:Put owner (list nativepath reportpath) *EL:ColdReports*))
          (setq *EL:ColdCompleted* T)
          (EL:ColdCheckpoint "FINISHED" (list (cons 'legacy-executed (equal mode "Both"))
            '(complete-native-recognition . nil) (cons 'bounds-audit-passed (EL:Get 'bounds-audit-passed report))))
          (EL:LogEvent "COLD_PROBE78" report)
          (princ (strcat "\n.NET 候选原型从拾取结束到返回："
            (itoa (EL:PerfDelta started audited)) " ms（含本次 NETLOAD、选择和边界抽查）。"))
          (if legacy-start (princ (strcat "\n完整旧路径只读识别："
            (itoa (EL:PerfDelta legacy-start legacy-end)) " ms。")))
          (princ (strcat "\n边界抽查：" (itoa (EL:Get 'checked audit)) " 项，缺失 "
            (itoa (EL:Get 'missing audit)) " 项，差异 " (itoa (EL:Get 'different audit)) " 项。"))
          (princ (if (equal mode "Both") "\n本次已执行完整旧路径只读对照。"
            "\n本次选择 Prototype，仅候选阶段完成；未执行完整旧路径识别，不会打开统计面板。"))
          (princ "\n当前原型尚未执行 .NET 精细识别与编号；完整首次识别 3 秒目标尚未验收。")
          (princ (strcat "\n原型报告：" nativepath "\n对照报告：" reportpath "\n运行 ELDIAG 可一并导出。")))))))
(defun c:ELCOLD78 (/ *error* outcome *EL:ColdCompleted* *EL:ColdContext*)
  (defun *error* (message)
    (vl-catch-all-apply 'EL:ClearGapPreview nil)
    (vl-catch-all-apply 'EL:ClearPickHighlights nil)
    (EL:ColdFailure message)
    (EL:LogFailure message) (EL:LogFinish 'cold-probe-failed)
    (if message (princ (strcat "\n只读原型已停止：" message))) (princ))
  (if (EL:EnsureRoot)
    (progn
      (EL:LogStart)
      ;; Date: 2026-10-22. The generic log name contains '/', invalid in a
      ;; Windows timeline filename. Name this command's own run explicitly.
      (if *EL:PerfLogOwner* (setq *EL:PerfCommand* "ELCOLD78"))
      (setq outcome (EL:MeasuredCatch 'EL:ColdRun nil))
      (EL:ClearGapPreview) (EL:ClearPickHighlights)
      (if (vl-catch-all-error-p outcome)
        (progn (EL:ColdFailure (vl-catch-all-error-message outcome))
          (EL:LogFailure (vl-catch-all-error-message outcome))
          (princ (strcat "\n只读原型未完成：" (vl-catch-all-error-message outcome)))))
      ;; Date: 2026-10-22. Native EXIT may return without a catch error.
      ;; Only a written and validated comparison report completes the probe.
      (if (and (not (vl-catch-all-error-p outcome)) (not *EL:ColdCompleted*))
        (EL:ColdFailure "本轮未写出完成报告；请检查最后阶段及取消操作。"))
      (EL:LogFinish (if (or (vl-catch-all-error-p outcome) (not *EL:ColdCompleted*))
        'cold-probe-failed 'cold-probe-finished))))
  (princ))
