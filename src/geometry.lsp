;; Coordinates are WCS. Curved block contours are sampled to eps_boundary/8.
;; Tilted planes, xrefs and unsupported geometry are diagnosed, never ignored.
(defun EL:PointSegmentDistance (p a b / v w q n)
  (setq v (EL:V- b a) w (EL:V- p a) n (EL:Dot v v))
  (if (< n 1.0e-18) (EL:Norm w)
    (progn (setq q (max 0.0 (min 1.0 (/ (EL:Dot w v) n))))
      (EL:Norm (EL:V- p (EL:V+ a (EL:V* q v)))))))
(defun EL:Touches (p segments tol epsz / hit seg)
  (while (and segments (not hit))
    (setq seg (car segments) segments (cdr segments))
    (if (and (<= (EL:PointSegmentDistance p (car seg) (cadr seg)) tol)
             (<= (abs (- (caddr p) (caddr (car seg)))) epsz)) (setq hit T))) hit)
(defun EL:Segments (points / out)
  (while (cdr points)
    (setq out (cons (list (car points) (cadr points)) out) points (cdr points)))
  (reverse out))
(defun EL:AffinePoint (p m)
  (if (not (and (EL:Point p) (= (length m) 8) (not (member nil (mapcar 'numberp m)))))
    (EL:LogEvent "INVALID_AFFINE_INPUT" (list (cons 'point p) (cons 'matrix m))))
  (list (+ (* (nth 0 m) (car p)) (* (nth 2 m) (cadr p)) (nth 4 m))
        (+ (* (nth 1 m) (car p)) (* (nth 3 m) (cadr p)) (nth 5 m))
        (+ (* (nth 7 m) (caddr p)) (nth 6 m))))
(defun EL:AffineCompose (a b / o x y)
  (setq o (EL:AffinePoint (list (nth 4 b) (nth 5 b) (nth 6 b)) a)
        x (EL:AffinePoint (list (+ (nth 4 b) (nth 0 b)) (+ (nth 5 b) (nth 1 b)) (nth 6 b)) a)
        y (EL:AffinePoint (list (+ (nth 4 b) (nth 2 b)) (+ (nth 5 b) (nth 3 b)) (nth 6 b)) a))
  (list (- (car x) (car o)) (- (cadr x) (cadr o))
        (- (car y) (car o)) (- (cadr y) (cadr o)) (car o) (cadr o) (caddr o)
        (* (nth 7 a) (nth 7 b))))
(defun EL:InsertMatrix (e / d p r sx sy sz base o x y b)
  (setq d (entget e) p (cdr (assoc 10 d)) r (cond ((cdr (assoc 50 d))) (T 0.0))
        sx (cond ((cdr (assoc 41 d))) (T 1.0)) sy (cond ((cdr (assoc 42 d))) (T 1.0))
        sz (cond ((cdr (assoc 43 d))) (T 1.0))
        b (tblsearch "BLOCK" (cdr (assoc 2 d))) base (cdr (assoc 10 b)))
  (EL:LogEvent "INSERT_MATRIX_INPUT" (list (EL:LogEntity e) (cons 'block-table b) (cons 'base base) (cons 'scales (list sx sy sz))))
  (setq o (EL:EntityOCSTrans p d nil "INSERT_TRANS" 'origin)
        x (EL:V- (EL:EntityOCSTrans (EL:V+ p (list (* sx (cos r)) (* sx (sin r)) 0.0)) d nil "INSERT_TRANS" 'x-axis) o)
        y (EL:V- (EL:EntityOCSTrans (EL:V+ p (list (* (- sy) (sin r)) (* sy (cos r)) 0.0)) d nil "INSERT_TRANS" 'y-axis) o))
  (setq sz (* sz (caddr (EL:EntityOCSTrans '(0.0 0.0 1.0) d T "INSERT_TRANS" 'z-axis))))
  (if (and (< (abs (caddr x)) 1.0e-9) (< (abs (caddr y)) 1.0e-9))
    (progn
      (setq o (EL:V- o (EL:V+ (EL:V* (car base) x) (EL:V* (cadr base) y))))
      (list (car x) (cadr x) (car y) (cadr y) (car o) (cadr o)
        (- (caddr o) (* sz (caddr base))) sz))))
(defun EL:ArcPoints (center radius start sweep err / n i pts angle)
  (setq n 4)
  (while (and (< n 4096) (> (* radius (- 1.0 (cos (/ (abs sweep) (* 2.0 n))))) err))
    (setq n (* n 2)))
  (if (<= (* radius (- 1.0 (cos (/ (abs sweep) (* 2.0 n))))) err)
    (progn
      (setq i 0)
      (repeat (1+ n)
        (setq angle (+ start (* sweep (/ (float i) n)))
              pts (cons (EL:V+ center (list (* radius (cos angle)) (* radius (sin angle)) 0.0)) pts)
              i (1+ i)))
      (reverse pts))))
(defun EL:BulgePoints (a b bulge err / chord mid left center radius start sweep)
  (if (< (abs bulge) 1.0e-12) (list a b)
    (progn
      (setq chord (EL:V- b a) mid (EL:V* 0.5 (EL:V+ a b))
            left (list (- (cadr chord)) (car chord) 0.0)
            center (EL:V+ mid (EL:V* (/ (- 1.0 (* bulge bulge)) (* 4.0 bulge)) left))
            radius (EL:Norm (EL:V- a center)) start (atan (- (cadr a) (cadr center)) (- (car a) (car center)))
            sweep (* 4.0 (atan bulge)))
      (EL:ArcPoints center radius start sweep err))))
(defun EL:OCSTrans (point normal displacement stage / converted)
  ;; Date: 2026-10-08. Use explicit OCS, including block-definition vertices.
  ;; Parent INSERT matrices are applied later, exactly once by BlockContour.
  (if (not (and (EL:Point point) (EL:Point normal) (> (EL:Norm normal) 1.0e-12)))
    (progn
      (EL:LogEvent (strcat "INVALID_" stage "_INPUT") (list (cons 'point point) (cons 'normal normal)
        (cons 'displacement displacement)))
      (princ "\n对象坐标或法向量无效，已停止识别；请保留诊断日志。")
      (exit)))
  (setq converted (trans point normal 0 displacement))
  (EL:LogEvent (strcat stage "_RESULT") converted)
  (if (not (EL:Point converted))
    (progn
      (EL:LogEvent (strcat "INVALID_" stage "_RESULT") (list (cons 'point point) (cons 'normal normal)
        (cons 'target 0) (cons 'displacement displacement) (cons 'result converted)))
      (princ "\n对象坐标转换未返回有效三维点，已停止识别；请保留诊断日志。")
      (exit)))
  converted)
(defun EL:EntityOCSTrans (point data displacement stage sample / normal)
  (setq normal (cond ((cdr (assoc 210 data))) (T '(0.0 0.0 1.0))))
  (EL:LogCall stage (list (cons 'handle (cdr (assoc 5 data))) (cons 'type (cdr (assoc 0 data)))
    (cons 'point point) (cons 'normal normal) (cons 'target 0) (cons 'displacement displacement)
    (cons 'sample sample) (cons 'method 'extrusion-vector))
    'EL:OCSTrans (list point normal displacement stage)))
(defun EL:PolylineTrans (point normal)
  (EL:OCSTrans point normal nil "POLYLINE_TRANS"))
(defun EL:PolylineData (e / data p elev normal points bulges x converted)
  (setq data (entget e) elev (cond ((cdr (assoc 38 data))) (T 0.0))
        normal (cond ((cdr (assoc 210 data))) (T '(0.0 0.0 1.0))))
  (EL:LogEvent "POLYLINE_INPUT" (list (cons 'entity (EL:LogEntity e)) (cons 'elevation elev) (cons 'raw-dxf data)))
  (foreach x data
    ;; Capture the exact DXF row before numeric group-code comparisons.
    (EL:LogEvent "POLYLINE_DXF_ROW" x)
    (cond ((= (car x) 10)
           (setq p (cdr x)
                 converted (EL:LogCall "POLYLINE_TRANS" (list (cons 'handle (cdr (assoc 5 data)))
                   (cons 'vertex p) (cons 'elevation elev) (cons 'normal normal) (cons 'target 0)
                   (cons 'method 'extrusion-vector))
                   'EL:PolylineTrans (list (list (car p) (cadr p) elev) normal)))
           (setq points (cons converted points)
                 bulges (cons 0.0 bulges)))
          ((= (car x) 42) (setq bulges (cons (cdr x) (cdr bulges))))))
  (EL:LogEvent "POLYLINE_NORMAL" normal)
  (if (< (caddr normal) 0.0)
    (setq bulges (mapcar '- bulges)))
  (list (reverse points) (reverse bulges)))
(defun EL:PolylineSegments (points bulges closed err / out tail bs part)
  (setq tail (if closed (append points (list (car points))) points) bs bulges)
  (while (cdr tail)
    (EL:LogEvent "POLYLINE_SEGMENT" (list (cons 'start (car tail)) (cons 'end (cadr tail))
      (cons 'bulge (car bs)) (cons 'error-bound err)))
    (setq part (EL:BulgePoints (car tail) (cadr tail) (cond ((car bs)) (T 0.0)) err))
    (if part (setq out (append out (EL:Segments part))) (setq out nil tail nil))
    (setq tail (cdr tail) bs (cdr bs))) out)
(defun EL:MakeEnd (id side points bulges layer / p q b rest state direction)
  ;; Last vertex has no outgoing segment: use the penultimate original bulge.
  (if (equal side 'end) (setq points (reverse points) bulges (cdr (reverse bulges))))
  (setq p (car points) rest (cdr points) b (car bulges))
  (while (and rest (< (EL:Norm (EL:V- (car rest) p)) 1.0e-9))
    (setq rest (cdr rest) bulges (cdr bulges) b (car bulges)))
  (setq q (car rest) state (cond ((not q) 'INVALID_GEOMETRY)
      ((and b (> (abs b) 1.0e-12)) 'UNSUPPORTED_END_GEOMETRY) (T 'straight)))
  (if q (setq direction (EL:Unit (EL:V- p q))))
  (list (cons 'key (list id side)) (cons 'wire id) (cons 'side side) (cons 'point p)
        (cons 'direction direction) (cons 'geometry state) (cons 'layer layer)))
(defun EL:WireRecord (e cfg / d id typ pts bs closed segments ends issues normal total seg bounds)
  (setq d (entget e) id (cdr (assoc 5 d)) typ (cdr (assoc 0 d)) normal (cdr (assoc 210 d)))
  (cond ((= typ "LINE") (setq pts (list (cdr (assoc 10 d)) (cdr (assoc 11 d))) bs '(0.0 0.0)))
        ((= typ "LWPOLYLINE")
         (setq pts (EL:PolylineData e) bs (cadr pts) pts (car pts)
               closed (= (logand 1 (cond ((cdr (assoc 70 d))) (T 0))) 1)))
        (T (setq issues (list (EL:Issue 'UNSUPPORTED_WIRE id typ)))))
  (if (and normal (> (+ (abs (car normal)) (abs (cadr normal))) 1.0e-9))
    (setq issues (cons (EL:Issue 'UNSUPPORTED_PLANE id normal) issues)))
  (if closed (setq issues (cons (EL:Issue 'CLOSED_WIRE id nil) issues)))
  (if pts
    (progn
      (setq segments (EL:PolylineSegments pts bs closed (/ (EL:Get 'eps_boundary (EL:Get 'params cfg)) 8.0)))
      (if (not closed)
        (setq ends (list (EL:MakeEnd id 'start pts bs (cdr (assoc 8 d)))
                         (EL:MakeEnd id 'end pts bs (cdr (assoc 8 d))))))))
  (if (and pts (not segments)) (setq issues (cons (EL:Issue 'INVALID_GEOMETRY id nil) issues)))
  (setq total 0.0)
  (foreach seg segments (setq total (+ total (EL:Norm (EL:V- (cadr seg) (car seg))))))
  (if (and pts (< total 1.0e-9)) (setq issues (cons (EL:Issue 'INVALID_GEOMETRY id nil) issues)))
  (if (and pts (> (- (apply 'max (mapcar 'caddr pts)) (apply 'min (mapcar 'caddr pts))) (EL:Get 'eps_z (EL:Get 'params cfg))))
    (setq issues (cons (EL:Issue 'UNSUPPORTED_PLANE id nil) issues)))
  (if (not (member typ '("LINE" "LWPOLYLINE"))) (setq bounds (EL:LogCall "ENTITY_BOUNDS" (EL:LogEntity e) 'EL:EntityBounds (list e))))
  (list (cons 'id id) (cons 'layer (cdr (assoc 8 d))) (cons 'type typ)
        (cons 'segments segments) (cons 'bounds bounds) (cons 'ends ends) (cons 'issues issues) (cons 'raw (EL:Signature d))))
(defun EL:TransformSegments (segments matrix)
  (mapcar '(lambda (segment) (list (EL:AffinePoint (car segment) matrix)
    (EL:AffinePoint (cadr segment) matrix))) segments))
(defun EL:CurveSegments (data err / typ center radius start sweep points point converted index)
  (setq typ (cdr (assoc 0 data)) center (cdr (assoc 10 data)) radius (cdr (assoc 40 data))
        start (if (= typ "CIRCLE") 0.0 (cdr (assoc 50 data)))
        sweep (if (= typ "CIRCLE") (* 2.0 pi)
          (rem (+ (* 2.0 pi) (- (cdr (assoc 51 data)) start)) (* 2.0 pi))))
  (setq points (EL:LogCall "CURVE_POINTS" (list (cons 'handle (cdr (assoc 5 data))) (cons 'type typ)
    (cons 'center center) (cons 'radius radius) (cons 'start start) (cons 'sweep sweep) (cons 'error-bound err))
    'EL:ArcPoints (list center radius start sweep err)))
  (EL:LogEvent "CURVE_POINT_COUNT" (list (cons 'handle (cdr (assoc 5 data))) (cons 'count (length points))))
  (setq index 0)
  (foreach point points
    (setq converted (cons (EL:EntityOCSTrans point data nil "CURVE_TRANS" index) converted)
          index (1+ index)))
  (EL:Segments (reverse converted)))
(defun EL:BlockContour (e matrix tol stack / d name b child cd typ m result segs issues local pd scale normal holes transformed)
  (setq d (entget e) name (cdr (assoc 2 d)) b (tblsearch "BLOCK" name)
        m (EL:LogCall "INSERT_MATRIX" (list (EL:LogEntity e) (cons 'parents stack)) 'EL:InsertMatrix (list e)))
  (EL:LogEvent "BLOCK_CONTOUR_INPUT" (list (cons 'name name) (cons 'flags (cdr (assoc 70 b))) (cons 'matrix m) (cons 'parent-matrix matrix) (cons 'tolerance tol)))
  (cond ((or (member name stack) (>= (length stack) 16))
         (setq issues (list (EL:Issue 'RECURSIVE_BLOCK name nil))))
        ((or (not m) (/= 0 (logand 12 (cdr (assoc 70 b)))))
         (setq issues (list (EL:Issue 'UNSUPPORTED_BLOCK name 'plane-or-xref))))
        (T
         (setq m (EL:AffineCompose matrix m) child (cdr (assoc -2 b))
               scale (max 1.0 (+ (abs (nth 0 m)) (abs (nth 1 m)) (abs (nth 2 m)) (abs (nth 3 m)))))
         (while (and child (/= (cdr (assoc 0 (entget child))) "ENDBLK"))
           (setq cd (entget child) typ (cdr (assoc 0 cd)) local nil normal (cdr (assoc 210 cd)))
           (EL:LogEvent "CONTOUR_ENTITY" (list (cons 'block name) (cons 'parents stack) (EL:LogEntity child) (cons 'matrix m) (cons 'scale scale)))
           (EL:LogEvent "CONTOUR_FILTER_INPUT" (list (cons 'handle (cdr (assoc 5 cd)))
             (cons 'type typ) (cons 'visibility (cdr (assoc 60 cd))) (cons 'normal normal)))
           ;; Code 60 is optional: absent means visible. EQUAL accepts nil.
           (if (not (equal (cdr (assoc 60 cd)) 1))
             (cond
               ((member typ '("TEXT" "MTEXT" "ATTDEF" "ATTRIB" "POINT" "SEQEND")) nil)
               ((and normal (> (+ (abs (car normal)) (abs (cadr normal))) 1.0e-9))
                (setq issues (cons (EL:Issue 'UNSUPPORTED_PLANE name typ) issues)))
               ((= typ "LINE") (setq local (list (list (cdr (assoc 10 cd)) (cdr (assoc 11 cd))))))
               ((= typ "LWPOLYLINE")
                (setq pd (EL:LogCall "POLYLINE_DATA" (EL:LogEntity child) 'EL:PolylineData (list child)))
                (EL:LogEvent "POLYLINE_DATA_RESULT" (list (cons 'data pd) (cons 'flags (cdr (assoc 70 cd)))
                  (cons 'tolerance tol) (cons 'scale scale)))
                (setq local (EL:LogCall "POLYLINE_SEGMENTS" pd 'EL:PolylineSegments
                  (list (car pd) (cadr pd) (= 1 (logand 1 (cond ((cdr (assoc 70 cd))) (T 0)))) (/ tol (* 8.0 scale)))))
                (if (not local) (setq issues (cons (EL:Issue 'CONTOUR_RESOLUTION name typ) issues))))
               ((member typ '("CIRCLE" "ARC"))
                (setq local (EL:LogCall "CURVE_SEGMENTS" (EL:LogEntity child) 'EL:CurveSegments
                  (list cd (/ tol (* 8.0 scale)))))
                (if (not local) (setq issues (cons (EL:Issue 'CONTOUR_RESOLUTION name nil) issues))))
               ((= typ "INSERT")
                (setq result (EL:LogCall "NESTED_CONTOUR" (EL:LogEntity child) 'EL:BlockContour (list child m tol (cons name stack)))
                      holes (append holes (EL:Get 'holes result)) segs (append segs (EL:Get 'segments result)) issues (append issues (EL:Get 'issues result))))
               (T (setq issues (cons (EL:Issue 'UNSUPPORTED_CONTOUR name typ) issues)))))
           (setq transformed (EL:LogCall "CONTOUR_TRANSFORM" (list (cons 'handle (cdr (assoc 5 cd)))
             (cons 'segments local) (cons 'matrix m)) 'EL:TransformSegments (list local m)))
           (EL:LogEvent "CONTOUR_TRANSFORM_RESULT" (list (cons 'handle (cdr (assoc 5 cd))) (cons 'segments transformed)))
           (if (and (equal (strcase (cond ((cdr (assoc 8 cd))) (T "0"))) "EL_HOLE") local)
             (setq holes (append holes (EL:ClosedRings transformed))))
           (setq segs (append transformed segs))
           (EL:LogEvent "CONTOUR_NEXT" (cdr (assoc 5 cd)))
           (setq child (entnext child)))))
  (if (not segs) (setq issues (cons (EL:Issue 'EMPTY_CONTOUR name nil) issues)))
  (list (cons 'segments segs) (cons 'holes holes) (cons 'issues issues)))
(defun EL:DynamicState (e / obj props out p)
  (setq obj (vlax-ename->vla-object e))
  (if (= (vla-get-IsDynamicBlock obj) :vlax-true)
    (progn
      (setq props (vlax-invoke obj 'GetDynamicBlockProperties))
      (foreach p props (setq out (cons (list (vla-get-PropertyName p) (vlax-variant-value (vla-get-Value p))) out)))))
  (reverse out))
(defun EL:DefinitionData (name stack / b e rows d)
  (if (not (member name stack))
    (progn
      (setq b (tblsearch "BLOCK" name) e (cdr (assoc -2 b)))
      (while (and e (/= (cdr (assoc 0 (entget e))) "ENDBLK"))
        (setq d (vl-remove-if '(lambda (row) (member (car row) '(-1 5 330))) (entget e)))
        (if (= (cdr (assoc 0 d)) "INSERT")
          (setq rows (cons (EL:DefinitionData (cdr (assoc 2 d)) (cons name stack)) rows)))
        (setq rows (cons d rows) e (entnext e)))
      (list (cdr (assoc 10 b)) (reverse rows)))))
(defun EL:EntityBounds (e / lo hi result)
  (setq result (vl-catch-all-apply 'vla-GetBoundingBox (list (vlax-ename->vla-object e) 'lo 'hi)))
  (if (not (vl-catch-all-error-p result)) (list (vlax-safearray->list lo) (vlax-safearray->list hi))))
(defun EL:InBounds (point bounds tolerance)
  (and bounds (>= (car point) (- (car (car bounds)) tolerance)) (<= (car point) (+ (car (cadr bounds)) tolerance))
    (>= (cadr point) (- (cadr (car bounds)) tolerance)) (<= (cadr point) (+ (cadr (cadr bounds)) tolerance))
    (>= (caddr point) (- (caddr (car bounds)) tolerance)) (<= (caddr point) (+ (caddr (cadr bounds)) tolerance))))
(defun EL:BoundsSegments (bounds / a b z)
  (if bounds
    (progn (setq a (car bounds) b (cadr bounds) z (caddr a))
      (EL:Segments (list (list (car a) (cadr a) z) (list (car b) (cadr a) z)
        (list (car b) (cadr b) z) (list (car a) (cadr b) z) (list (car a) (cadr a) z))))))
(defun EL:SegmentBounds (segments / xmin ymin zmin xmax ymax zmax seg point x y z count)
  ;; Date: 2026-10-10. Scalar extrema avoid two temporary lists per endpoint.
  (setq count 0)
  (foreach seg segments
    (foreach point seg
      (setq x (car point) y (cadr point) z (caddr point))
      (if xmin
        (setq xmin (min xmin x) ymin (min ymin y) zmin (min zmin z)
              xmax (max xmax x) ymax (max ymax y) zmax (max zmax z))
        (setq xmin x ymin y zmin z xmax x ymax y zmax z)))
    (setq count (1+ count))
    (if (and *EL:ContactContext* (= (rem count 4096) 0))
      (EL:ContactProgress "bounds" count *EL:ContactContext*)))
  (if xmin (list (list xmin ymin zmin) (list xmax ymax zmax))))
(defun EL:ContactProgress (phase completed context)
  (if *EL:LogActive*
    (progn
      (EL:LogEvent "CONTACT_PROGRESS" (list (cons 'phase phase) (cons 'completed completed) (cons 'object context)))
      (vl-catch-all-apply 'grtext (list -1 (strcat "设备轮廓 "
        (cond ((EL:Get 'id context)) (T "未知")) " / " (cond ((equal phase "read") "读取图块") ((equal phase "bounds") "计算范围")
          ((equal phase "prepare") "准备接触检查") ((equal phase "ready") "准备完成") (T phase)) " / " (itoa completed)))))))
;; Contour order retains local adjacency. Balanced construction consumes each
;; item once, without sorting or copying sublists at every recursive level.
(defun EL:ContourTree (items / *EL:ContourCursor*)
  (setq *EL:ContourCursor* items)
  (EL:ContourTreeTake (length items)))
(defun EL:ContourTreeTake (count / mid left right pivot bounds lo hi child)
  (if (> count 0)
    (progn
      (setq mid (/ count 2) left (EL:ContourTreeTake mid)
            pivot (car *EL:ContourCursor*) *EL:ContourCursor* (cdr *EL:ContourCursor*)
            right (EL:ContourTreeTake (- count mid 1))
            bounds (EL:Get 'bounds pivot) lo (car bounds) hi (cadr bounds))
      (foreach child (list left right)
        (if child (setq lo (mapcar 'min lo (nth 3 child)) hi (mapcar 'max hi (nth 4 child)))))
      (list pivot left right lo hi))))
(defun EL:BoundsOverlap (a b tol)
  (and a b (<= (caar a) (+ (car (cadr b)) tol)) (>= (car (cadr a)) (- (caar b) tol))
    (<= (cadr (car a)) (+ (cadr (cadr b)) tol)) (>= (cadr (cadr a)) (- (cadr (car b)) tol))
    (<= (caddr (car a)) (+ (caddr (cadr b)) tol)) (>= (caddr (cadr a)) (- (caddr (car b)) tol))))
(defun EL:SpatialBoxQuery (tree bounds tol / item result)
  (if (and tree (EL:BoundsOverlap (list (nth 3 tree) (nth 4 tree)) bounds tol))
    (progn
      (setq item (car tree))
      (if (EL:BoundsOverlap (EL:Get 'bounds item) bounds tol) (setq result (list item)))
      (append result (EL:SpatialBoxQuery (cadr tree) bounds tol)
                     (EL:SpatialBoxQuery (caddr tree) bounds tol)))))
(defun EL:RingItems (segments / items seg a b index)
  ;; Date: 2026-10-08. XY broad phase only; exact 3D endpoint tests follow.
  (setq index 0)
  (foreach seg segments
    (setq a (list (caar seg) (cadr (car seg)) 0.0)
          b (list (car (cadr seg)) (cadr (cadr seg)) 0.0)
          items (cons (list (cons 'key index) (cons 'segment seg)
            (cons 'point (EL:V* 0.5 (EL:V+ a b)))
            (cons 'bounds (list (mapcar 'min a b) (mapcar 'max a b)))) items)
          index (1+ index)))
  (reverse items))
(defun EL:RingUsed (marks index size / mid)
  ;; Persistent balanced bit tree: no linear MEMBER/VL-REMOVE per edge.
  (if marks
    (if (= size 1) T
      (progn (setq mid (/ size 2))
        (if (< index mid) (EL:RingUsed (car marks) index mid)
          (EL:RingUsed (cadr marks) (- index mid) (- size mid)))))))
(defun EL:RingMark (marks index size / mid)
  (if (= size 1) T
    (progn (setq mid (/ size 2))
      (if (< index mid)
        (list (EL:RingMark (car marks) index mid) (cadr marks))
        (list (car marks) (EL:RingMark (cadr marks) (- index mid) (- size mid)))))))
(defun EL:RegionProgress (phase completed total)
  (EL:LogEvent "REGION_PROGRESS" (list (cons 'phase phase) (cons 'completed completed) (cons 'total total)))
  (if *EL:LogActive*
    (vl-catch-all-apply 'grtext (list -1 (strcat "闭合区域检查 " phase " " (itoa completed) "/" (itoa total)))))
  nil)
(defun EL:ClosedRings (segments / items tree marks count done item candidate ring start point query matches seg loops finished)
  ;; Only unbranched closed paths define interiors. Keep original input order.
  (setq count (length segments) done 0 items (EL:RingItems segments))
  (EL:RegionProgress "index" 0 count)
  (setq tree (EL:ContourTree items))
  (foreach item items
    (if (not (EL:RingUsed marks (EL:Get 'key item) count))
      (progn
        (setq seg (EL:Get 'segment item) marks (EL:RingMark marks (EL:Get 'key item) count)
              done (1+ done) ring (list seg) start (car seg) point (cadr seg) finished nil)
        (while (and (not finished) (not (equal start point 1.0e-7)))
          (setq query (list (car point) (cadr point) 0.0) matches nil)
          (foreach candidate (EL:SpatialBoxQuery tree (list query query) 1.0e-7)
            (setq seg (EL:Get 'segment candidate))
            (if (and (not (EL:RingUsed marks (EL:Get 'key candidate) count))
                (or (equal point (car seg) 1.0e-7) (equal point (cadr seg) 1.0e-7)))
              (setq matches (cons candidate matches))))
          (if (= (length matches) 1)
            (progn
              (setq candidate (car matches) seg (EL:Get 'segment candidate)
                    marks (EL:RingMark marks (EL:Get 'key candidate) count) done (1+ done))
              (if (equal point (cadr seg) 1.0e-7) (setq seg (reverse seg)))
              (setq ring (cons seg ring) point (cadr seg)))
            (setq finished T))
          (if (= (rem done 256) 0) (EL:RegionProgress "link" done count)))
        (setq ring (reverse ring))
        (if (and (not finished) (> (length ring) 2) (EL:SimpleRing ring)) (setq loops (cons ring loops))))))
  (EL:LogEvent "REGION_RESULT" (list (cons 'segments count) (cons 'rings (length loops))))
  (EL:RegionProgress "done" done count)
  loops)
(defun EL:SimpleRing (ring / valid a b elevation items tree item candidates candidate checked total)
  (setq valid T elevation (caddr (caar ring)) checked 0 total (length ring))
  (foreach a ring
    (if (or (> (abs (- (caddr (car a)) elevation)) (EL:GapEpsilon))
            (> (abs (- (caddr (cadr a)) elevation)) (EL:GapEpsilon))) (setq valid nil)))
  (if valid
    (progn
      (setq items (EL:RingItems ring) tree (EL:ContourTree items))
      (while (and valid items)
        (setq item (car items) a (EL:Get 'segment item)
              candidates (EL:SpatialBoxQuery tree (EL:Get 'bounds item) (EL:GapEpsilon)))
        (while (and valid candidates)
          (setq candidate (car candidates) b (EL:Get 'segment candidate))
          ;; Check both directions once: endpoint-to-interior hits are asymmetric.
          (if (and (< (EL:Get 'key item) (EL:Get 'key candidate)) (not (equal a b))
              (or (EL:GapHitsSegment (car a) (cadr a) (car b) (cadr b))
                  (EL:GapHitsSegment (car b) (cadr b) (car a) (cadr a))))
            (setq valid nil))
          (setq candidates (cdr candidates)))
        (setq items (cdr items) checked (1+ checked))
        (if (= (rem checked 256) 0) (EL:RegionProgress "intersections" checked total)))))
  valid)
(defun EL:AmbiguousRings (rings holes / ambiguous a b)
  (foreach a rings
    (foreach b rings
      (if (and (not (equal a b)) (not (vl-some '(lambda (h) (equal (EL:SegmentBounds a) (EL:SegmentBounds h))) holes))
               (EL:InsideSegments (caar a) b)) (setq ambiguous T))))
  ambiguous)
(defun EL:XYBounds (bounds)
  (if bounds (list (list (caar bounds) (cadr (car bounds)) 0.0)
    (list (car (cadr bounds)) (cadr (cadr bounds)) 0.0))))
(defun EL:ContactRings (rings / rows ring)
  (foreach ring rings (setq rows (cons (list ring (EL:XYBounds (EL:SegmentBounds ring))) rows)))
  (reverse rows))
(defun EL:PrepareContourContact (block / segments bounds tree count *EL:ContactContext*)
  ;; Date: 2026-10-10. Keep object identity/count in every expensive stage.
  (setq segments (EL:Get 'segments block) count (length segments)
        *EL:ContactContext* (list (cons 'id (EL:Get 'id block)) (cons 'name (EL:Get 'name block)) (cons 'segments count)))
  (EL:ContactProgress "prepare" 0 *EL:ContactContext*)
  (if (and *EL:LogActive* (>= count 4096))
    (princ (strcat "\n正在检查设备 " (cond ((EL:Get 'id block)) (T "未知"))
      "，轮廓 " (itoa count) " 段；可按 Esc 取消。")))
  ;; Native INSERT extents are conservative broad-phase bounds only.
  ;; Exact contact still tests sampled segments, closed rings and holes.
  (setq bounds (cond ((EL:Get 'contact-envelope block)) ((EL:Get 'segment-bounds block))
    (T (EL:LogCall "CONTACT_BOUNDS" *EL:ContactContext* 'EL:SegmentBounds (list segments)))))
  (if (>= count 64) (setq tree (EL:LogCall "CONTACT_TREE" *EL:ContactContext* 'EL:ContourTree (list (EL:RingItems segments)))))
  (EL:ContactProgress "ready" count *EL:ContactContext*)
  (append block (list (cons 'segment-bounds bounds) (cons 'contact-ready T) (cons 'contact-segment-bounds (EL:XYBounds bounds))
    (cons 'contact-path-bounds (cond ((EL:Get 'bounds block)) (T bounds)))
    (cons 'contact-tree tree) (cons 'contact-regions (EL:ContactRings (EL:Get 'regions block)))
    (cons 'contact-holes (EL:ContactRings (EL:Get 'holes block))))))
(defun EL:PrepareContactBlock (block)
  (if (EL:Get 'whole-block block)
    (append block (list (cons 'contact-path-bounds (EL:Get 'bounds block))))
    (EL:PrepareContourContact block)))
(defun EL:ContactSegments (block bounds / tree)
  (if (EL:Get 'contact-ready block)
    (if (EL:BoundsOverlap (EL:XYBounds bounds) (EL:Get 'contact-segment-bounds block) (EL:GapEpsilon))
      (if (setq tree (EL:Get 'contact-tree block))
        (mapcar '(lambda (row) (EL:Get 'segment row)) (EL:SpatialBoxQuery tree (EL:XYBounds bounds) (EL:GapEpsilon)))
        (EL:Get 'segments block)))
    (EL:Get 'segments block)))
(defun EL:PointContactBounds (point tol)
  (list (list (- (car point) tol) (- (cadr point) tol) 0.0)
        (list (+ (car point) tol) (+ (cadr point) tol) 0.0)))
(defun EL:ContourContains (point block / hit loop holes rows row bounds)
  (setq rows (if (EL:Get 'contact-ready block) (EL:Get 'contact-regions block)
    (mapcar '(lambda (ring) (list ring nil)) (EL:Get 'regions block))))
  (while (and rows (not hit))
    (setq row (car rows) loop (car row) bounds (cadr row) rows (cdr rows))
    (if (and (or (not bounds) (EL:BoundsOverlap (EL:PointContactBounds point 0.0) bounds 0.0))
             (<= (abs (- (caddr point) (caddr (caar loop)))) (EL:GapEpsilon))
             (EL:InsideSegments point loop)) (setq hit T)))
  (if hit
    (progn
      (setq rows (if (EL:Get 'contact-ready block) (EL:Get 'contact-holes block)
        (mapcar '(lambda (ring) (list ring nil)) (EL:Get 'holes block))))
      (while (and rows (not holes))
        (setq row (car rows) loop (car row) bounds (cadr row) rows (cdr rows))
        ;; Hole subtraction keeps the existing XY-only semantics.
        (if (and (or (not bounds) (EL:BoundsOverlap (EL:PointContactBounds point 0.0) bounds 0.0))
                 (EL:InsideSegments point loop)) (setq holes T)))))
  (and hit (not holes)))
(defun EL:RegionContains (point block)
  (if (EL:Get 'whole-block block) (EL:InBounds point (EL:Get 'bounds block) (EL:GapEpsilon))
    (EL:ContourContains point block)))
(defun EL:ContourPointHit (point block cfg)
  (or (EL:Touches point (EL:ContactSegments block
        (EL:PointContactBounds point (EL:Get 'eps_boundary (EL:Get 'params cfg))))
        (EL:Get 'eps_boundary (EL:Get 'params cfg)) (EL:GapEpsilon))
      (EL:RegionContains point block)))
(defun EL:BlockPointHit (point block cfg)
  (if (EL:Get 'whole-block block)
    (EL:InBounds point (EL:ExpandedBlockBounds (EL:Get 'bounds block)
      (EL:Get 'eps_boundary (EL:Get 'params cfg))) (EL:GapEpsilon))
    (EL:ContourPointHit point block cfg)))
(defun EL:PathBlockHit (wire block cfg)
  (if (EL:Get 'whole-block block) (EL:WholePathHit wire block cfg)
    (EL:ContourPathHit wire block cfg)))
(defun EL:ContourPathHit (wire block cfg / hit seg edge segments candidates)
  (setq segments (EL:Get 'segments wire))
  (while (and segments (not hit))
    (setq seg (car segments) segments (cdr segments))
    (if (or (EL:BlockPointHit (car seg) block cfg) (EL:BlockPointHit (cadr seg) block cfg)
            (EL:RegionContains (EL:V* 0.5 (EL:V+ (car seg) (cadr seg))) block)) (setq hit T))
    (if (not hit) (setq candidates (EL:ContactSegments block (EL:SegmentBounds (list seg)))))
    (while (and candidates (not hit))
      (setq edge (car candidates) candidates (cdr candidates))
      (if (and (<= (abs (- (caddr (car seg)) (caddr (car edge)))) (EL:GapEpsilon))
               (<= (abs (- (caddr (cadr seg)) (caddr (car edge)))) (EL:GapEpsilon))
               (EL:GapHitsSegment (car seg) (cadr seg) (car edge) (cadr edge))) (setq hit T))))
  hit)
(defun EL:BlockRecord (e cfg / d name identity role bounds segments issues)
  ;; Date: 2026-10-08. Treat INSERT as one WCS box; never traverse its contents.
  (setq d (entget e) name (EL:LogCall "EFFECTIVE_NAME" (EL:LogEntity e) 'EL:EffectiveName (list e))
        identity (list name (EL:LogCall "DYNAMIC_STATE" (EL:LogEntity e) 'EL:DynamicState (list e))
          (EL:Signature (list 'whole-block-v1 (EL:DrawingID) (cdr (assoc 2 d)))))
        role (cond ((EL:Get 'role (EL:By 'identity identity (EL:Get 'roles cfg))))
                   ((EL:Get 'role (EL:By 'identity identity *EL:LibraryRoles*))))
        bounds (EL:LogCall "BLOCK_BOUNDS" (EL:LogEntity e) 'EL:EntityBounds (list e)))
  (if (not bounds) (setq issues (list (EL:Issue 'MISSING_BLOCK_BOUNDS (cdr (assoc 5 d)) nil))))
  (setq segments (EL:BoundsSegments bounds))
  (list (cons 'id (cdr (assoc 5 d))) (cons 'layer (cdr (assoc 8 d))) (cons 'name name)
        (cons 'role (cond (role) (T (EL:Role (cdr (assoc 8 d)) name cfg))))
        (cons 'identity identity) (cons 'whole-block T)
        (cons 'regions (if segments (list segments))) (cons 'holes nil)
        (cons 'segments segments) (cons 'issues issues) (cons 'bounds bounds)
        (cons 'raw (EL:Signature (list d identity bounds)))))
(defun EL:ExpandedBlockBounds (bounds tol)
  (if bounds (list (EL:V- (car bounds) (list tol tol 0.0))
                  (EL:V+ (cadr bounds) (list tol tol 0.0)))))
(defun EL:SegmentBoxHit (segment bounds tol / expanded)
  (setq expanded (EL:ExpandedBlockBounds bounds tol))
  (and expanded (EL:RayBoxHits (car segment) (EL:V- (cadr segment) (car segment))
    1.0 (car expanded) (cadr expanded))))
(defun EL:WholePathHit (wire block cfg / segments hit)
  (setq segments (EL:Get 'segments wire))
  (while (and segments (not hit))
    (setq hit (EL:SegmentBoxHit (car segments) (EL:Get 'bounds block)
      (EL:Get 'eps_boundary (EL:Get 'params cfg))) segments (cdr segments)))
  hit)
(defun EL:CollectEndpointSnapshot (cfg / ss i e d layer wires blocks ends issues rec data inserts bounds tree candidate candidates tol outside *EL:LibraryRoles* started collected parsed)
  (setq started (EL:Tick) *EL:LibraryRoles* (if *EL:Root* (EL:LoadRoleLibrary)))
  (setq ss (ssget "_X" '((410 . "Model"))) i 0 tol (EL:Get 'eps_boundary (EL:Get 'params cfg)))
  (if ss
    (repeat (sslength ss)
      (setq e (ssname ss i) d (entget e) layer (cdr (assoc 8 d)) i (1+ i))
      (if *EL:GapStage* (setq *EL:GapStage* (strcat "采集对象 " (vl-prin1-to-string (cdr (assoc 5 d))) "；类型 " (vl-prin1-to-string (cdr (assoc 0 d))))))
      (if (not (EL:ManagedEntity e)) (progn
      (cond
        ((equal (cdr (assoc 0 d)) "INSERT")
          (setq bounds (EL:EntityBounds e))
          ;; Missing COM bounds is conservative: parse, never discard the object.
          (if bounds (setq inserts (cons (list (cons 'key (cdr (assoc 5 d))) (cons 'point (EL:V* 0.5 (EL:V+ (car bounds) (cadr bounds)))) (cons 'entity e) (cons 'bounds bounds)) inserts))
            (setq candidates (cons e candidates))))
        ((member layer (EL:Get 'wire-layers cfg))
          (setq rec (EL:LogCall "WIRE_RECORD" (EL:LogEntity e) 'EL:WireRecord (list e cfg)) wires (cons rec wires) ends (append ends (EL:Get 'ends rec))))
        ((member (cdr (assoc 0 d)) '("LINE" "LWPOLYLINE"))
          (setq outside (cons (EL:LogCall "OUTSIDE_WIRE_RECORD" (EL:LogEntity e) 'EL:WireRecord (list e cfg)) outside))))
      (setq data (cons (list (cdr (assoc 5 d)) d) data))))))
  (setq collected (EL:Elapsed started) parsed (EL:Tick) tree (EL:LogCall "BLOCK_INDEX" (list (cons 'count (length inserts))) 'EL:SpatialTree (list inserts 0)))
  (foreach rec wires
    (foreach candidate (EL:SpatialBoxQuery tree (EL:SegmentBounds (EL:Get 'segments rec)) tol)
      (setq candidates (cons (EL:Get 'entity candidate) candidates))))
  (foreach e (EL:Unique candidates)
    (setq rec (EL:LogCall "CANDIDATE_BLOCK" (EL:LogEntity e) 'EL:BlockRecord (list e cfg)) blocks (cons rec blocks)
          data (cons (list (EL:Get 'id rec) (EL:Get 'raw rec)) data)))
  (foreach rec (append wires blocks) (setq issues (append issues (EL:Get 'issues rec))))
  (EL:LogEvent "SNAPSHOT_COUNTS" (list (cons 'wires (length wires)) (cons 'blocks (length blocks)) (cons 'ends (length ends)) (cons 'issues issues)))
  (setq data (vl-sort data '(lambda (a b) (< (EL:Signature a) (EL:Signature b)))))
  (list (cons 'drawing (EL:DrawingID)) (cons 'wires wires) (cons 'blocks blocks) (cons 'outside-wires outside)
        (cons 'timing (list (cons 'collection-ms collected) (cons 'contours-ms (EL:Elapsed parsed))
          (cons 'wire-count (length wires)) (cons 'parsed-block-count (length blocks))))
        (cons 'ends ends) (cons 'issues issues) (cons 'signature (EL:Signature (list data *EL:LibraryRoles*)))))
(defun EL:GapHitsSegment (p q a b / v w den tval uval)
  (setq v (EL:V- q p) w (EL:V- b a) den (EL:Cross v w))
  (if (> (abs den) 1.0e-12)
    (progn
      (setq tval (/ (EL:Cross (EL:V- a p) w) (float den)) uval (/ (EL:Cross (EL:V- a p) v) (float den)))
      (and (> tval 1.0e-9) (< tval (- 1.0 1.0e-9)) (>= uval 0.0) (<= uval 1.0)))))
 ;; Only numerical roundoff, not a drawing/alignment tolerance (mm).
(defun EL:GapEpsilon () 1.0e-7)
(defun EL:GapEligible (end)
  (and (not (EL:Get 'occupied end)) (not (EL:Get 'wire-attached end))
       (equal (EL:Get 'geometry end) 'straight) (EL:Get 'direction end)))
(defun EL:SpatialTree (items axis / sorted mid i item pivot left right lo hi bounds invalid)
  ;; Balanced point/segment tree. Tie-break keys preserve coincident endpoints.
  (if *EL:LogActive*
    (progn
      (setq invalid (vl-remove-if '(lambda (row) (EL:Point (EL:Get 'point row))) items))
      (if invalid (EL:LogEvent "INDEX_INVALID_POINTS" (list axis invalid)))))
  (if items
    (progn
      (setq sorted (vl-sort items '(lambda (a b)
        (if (= (nth axis (EL:Get 'point a)) (nth axis (EL:Get 'point b)))
          (< (EL:Signature (EL:Get 'key a)) (EL:Signature (EL:Get 'key b)))
          (< (nth axis (EL:Get 'point a)) (nth axis (EL:Get 'point b))))))
            mid (/ (length sorted) 2) i 0)
      (foreach item sorted
        (cond ((< i mid) (setq left (cons item left)))
              ((= i mid) (setq pivot item)) (T (setq right (cons item right))))
        (setq i (1+ i)))
      (setq left (EL:SpatialTree left (fix (rem (1+ axis) 3)))
            right (EL:SpatialTree right (fix (rem (1+ axis) 3)))
            bounds (EL:Get 'bounds pivot)
            lo (if bounds (car bounds) (EL:Get 'point pivot))
            hi (if bounds (cadr bounds) lo))
      (foreach item (list left right)
        (if item (setq lo (mapcar 'min lo (nth 3 item)) hi (mapcar 'max hi (nth 4 item)))))
      (list pivot left right lo hi))))
(defun EL:RayBoxHits (p direction limit lo hi / axis low high d near far tmp ok eps)
  (setq axis 0 near 0.0 far limit ok T eps (EL:GapEpsilon))
  (repeat 3
    (setq low (- (nth axis lo) eps (nth axis p))
          high (- (+ (nth axis hi) eps) (nth axis p)) d (nth axis direction))
    (if (< (abs d) 1.0e-15)
      (if (or (> low 0.0) (< high 0.0)) (setq ok nil))
      (progn
        (setq low (/ low d) high (/ high d))
        (if (> low high) (setq tmp low low high high tmp))
        (setq near (max near low) far (min far high))
        (if (> near far) (setq ok nil))))
    (setq axis (1+ axis))) ok)
(defun EL:SpatialRayQuery (tree p direction limit / item bounds result)
  (if (and tree (EL:RayBoxHits p direction limit (nth 3 tree) (nth 4 tree)))
    (progn
      (setq item (car tree) bounds (EL:Get 'bounds item))
      (if (EL:RayBoxHits p direction limit
            (if bounds (car bounds) (EL:Get 'point item))
            (if bounds (cadr bounds) (EL:Get 'point item))) (setq result (list item)))
      (append result (EL:SpatialRayQuery (cadr tree) p direction limit)
                     (EL:SpatialRayQuery (caddr tree) p direction limit)))))
(defun EL:GapPathIndex (snapshot / items item seg)
  (foreach item (append (EL:Get 'wires snapshot) (EL:Get 'blocks snapshot))
    (if (EL:Get 'whole-block item)
      (if (and (EL:Get 'bounds item) (not (equal (EL:Get 'role item) 'ignore)))
        (setq items (cons (list (cons 'key (EL:Get 'id item)) (cons 'id (EL:Get 'id item))
          (cons 'whole-block T) (cons 'bounds (EL:Get 'bounds item))
          (cons 'point (EL:V* 0.5 (EL:V+ (car (EL:Get 'bounds item)) (cadr (EL:Get 'bounds item)))))) items)))
      (foreach seg (EL:Get 'segments item)
      (setq items (cons (list (cons 'key (list (EL:Get 'id item) seg)) (cons 'id (EL:Get 'id item))
        (cons 'point (EL:V* 0.5 (EL:V+ (car seg) (cadr seg)))) (cons 'segment seg)
        (cons 'bounds (list (mapcar 'min (car seg) (cadr seg)) (mapcar 'max (car seg) (cadr seg))))) items)))))
  (EL:SpatialTree items 0))
(defun EL:GapBlocked (a b snapshot params / p q tdir len blocked item seg lo hi eps tree)
  ;; Non-collinear wires do not block; whole equipment boxes do.
  (setq p (EL:Get 'point a) q (EL:Get 'point b) tdir (EL:Unit (EL:V- q p))
        len (EL:Norm (EL:V- q p)) eps (EL:GapEpsilon)
        tree (if *EL:GapIndexReady* *EL:GapPathIndex* (EL:GapPathIndex snapshot)))
  (foreach item (EL:SpatialRayQuery tree p tdir len)
    (setq seg (EL:Get 'segment item))
    (if (EL:Get 'whole-block item)
      (if (EL:SegmentBoxHit (list p q) (EL:Get 'bounds item) 0.0)
        (setq blocked (cons (EL:Get 'id item) blocked)))
    (if (and (<= (abs (- (caddr (car seg)) (caddr p))) eps)
             (<= (abs (- (caddr (cadr seg)) (caddr p))) eps)
             (<= (abs (EL:Cross (EL:V- (car seg) p) tdir)) eps)
             (<= (abs (EL:Cross (EL:V- (cadr seg) p) tdir)) eps))
      (progn
        (setq lo (min (EL:Dot (EL:V- (car seg) p) tdir) (EL:Dot (EL:V- (cadr seg) p) tdir))
              hi (max (EL:Dot (EL:V- (car seg) p) tdir) (EL:Dot (EL:V- (cadr seg) p) tdir)))
        (if (> (- (min hi (- len eps)) (max lo eps)) eps)
          (setq blocked (cons (EL:Get 'id item) blocked)))))))
  (vl-sort (EL:Unique blocked) '<))
(defun EL:ValidateGapPair (a b snapshot cfg / p q tdir u v len ga gb ea eb c reason params blockers)
  (setq params (EL:Get 'params cfg) p (EL:Get 'point a) q (EL:Get 'point b)
        tdir (EL:Get 'direction a) u (EL:Get 'direction b))
  (cond ((or (EL:Get 'wire-attached a) (EL:Get 'wire-attached b)) (setq reason 'WIRE_ATTACHED_TO_EQUIPMENT))
        ((or (EL:Get 'occupied a) (EL:Get 'occupied b)) (setq reason 'ENDPOINT_OCCUPIED))
        ((equal (EL:Get 'wire a) (EL:Get 'wire b)) (setq reason 'SAME_ENTITY))
        ((not (and (equal (EL:Get 'geometry a) 'straight) (equal (EL:Get 'geometry b) 'straight)))
         (setq reason 'UNSUPPORTED_END_GEOMETRY))
        ((not (EL:LayerAllowed (EL:Get 'layer a) (EL:Get 'layer b) cfg)) (setq reason 'LAYER_REJECTED))
        ((> (abs (- (caddr p) (caddr q))) (EL:GapEpsilon)) (setq reason 'PLANE_REJECTED))
        (T
         (setq v (EL:V- q p) len (EL:Norm v) ga (EL:Dot v tdir) gb (EL:Dot (EL:V* -1.0 v) u)
               ea (abs (EL:Cross v tdir)) eb (abs (EL:Cross (EL:V* -1.0 v) u)) c (EL:Dot tdir (EL:V* -1.0 u)))
         (setq reason (cond ((<= len (EL:Get 'eps_touch params)) 'DIRECT_CONTACT)
            ((> len (EL:Get 'Dmax params)) 'OUT_OF_RANGE) ((or (<= ga 0.0) (<= gb 0.0)) 'BACKWARD)
            ((or (> ea (EL:GapEpsilon)) (> eb (EL:GapEpsilon))) 'LATERAL_REJECTED)
            ((or (> (EL:Norm (EL:V+ tdir u)) 1.0e-10)
                 (> (abs (caddr tdir)) 1.0e-10) (> (abs (caddr u)) 1.0e-10)) 'DIRECTION_REJECTED)
            ((setq blockers (EL:GapBlocked a b snapshot params)) 'BLOCKED_BY_DEVICE_OR_PATH)))))
  (list (cons 'target (EL:Get 'key b)) (cons 'accepted (not reason)) (cons 'reason reason)
        (cons 'distance len) (cons 'perp-a ea) (cons 'perp-b eb) (cons 'direction-dot c) (cons 'blockers blockers)))
(defun EL:CandidateLess (a b)
  (if (= (EL:Get 'distance a) (EL:Get 'distance b))
    (< (EL:Signature (EL:Get 'target a)) (EL:Signature (EL:Get 'target b)))
    (< (EL:Get 'distance a) (EL:Get 'distance b))))
(defun EL:FindGapCandidates (snapshot cfg / rows a b accepted rejected rec tree limit *EL:GapPathIndex* *EL:GapIndexReady*)
  ;; Complete forward corridor query; never stop at the first/nearest candidate.
  (setq tree (EL:SpatialTree (vl-remove-if-not 'EL:GapEligible (EL:Get 'ends snapshot)) 0)
        *EL:GapPathIndex* (EL:GapPathIndex snapshot) *EL:GapIndexReady* T
        limit (EL:Get 'Dmax (EL:Get 'params cfg)))
  (foreach a (EL:Get 'ends snapshot)
    (setq accepted nil rejected nil)
    (if (EL:GapEligible a)
      (foreach b (EL:SpatialRayQuery tree (EL:Get 'point a) (EL:Get 'direction a) limit)
        (if (not (equal (EL:Get 'key a) (EL:Get 'key b)))
          (progn
            (setq rec (EL:ValidateGapPair a b snapshot cfg))
            (if (EL:Get 'accepted rec) (setq accepted (cons rec accepted)) (setq rejected (cons rec rejected)))))))
    (setq rows (cons (list (cons 'key (EL:Get 'key a)) (cons 'candidates (vl-sort accepted 'EL:CandidateLess))
      (cons 'rejected (vl-sort rejected '(lambda (a b) (< (EL:Signature (EL:Get 'target a)) (EL:Signature (EL:Get 'target b))))))) rows)))
  (reverse rows))
(defun EL:By (key value records / result rec)
  (foreach rec records (if (equal (EL:Get key rec) value) (setq result rec))) result)
(princ)
