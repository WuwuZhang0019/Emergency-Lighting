;; Date: 2026-10-09. Fixed dynamic templates; legacy template schema is retained.
(defun EL:FixedTemplate (template)
  (and (EL:TemplateValid template)
    (equal (EL:Get 'name (EL:Get 'panel template)) "dfgjhdrtyjtfgj4SADFG3")
    (equal (EL:Get 'name (EL:Get 'circuit template)) "fghjftyuk")))
(defun EL:FixedText (/ style data height)
  (setq style (getvar "TEXTSTYLE") data (tblsearch "STYLE" style)
        height (if (and data (> (cdr (assoc 40 data)) 0.0)) (cdr (assoc 40 data)) (getvar "TEXTSIZE")))
  (if (and data (> height 0.0))
    (list '(offset 10636.0 -438.0 0.0) '(type . "TEXT") (cons 'style style)
      (cons 'height height) '(width . 0.0) '(align . 0) '(rotation . 0.0) '(factor . 1.0) '(oblique . 0.0))))
(defun EL:TemplateValueText (value)
  (if (equal (type value) 'STR) value (rtos value 2 6)))
(defun EL:TemplateValuesValid (values)
  (and (listp values) (>= (length (EL:Unique values)) 3)
    (vl-every '(lambda (value) (or (and (equal (type value) 'STR) (/= value "")) (EL:Number value))) values)))
(defun EL:TemplateKey (value / i ch textdata)
  (if (equal (type value) 'STR)
    (progn
      (setq i 1 textdata "")
      (while (<= i (strlen value))
        (setq ch (substr value i 1) i (1+ i))
        (if (not (member ch '(" " "\t" "\r" "\n"))) (setq textdata (strcat textdata ch))))
      (strcase textdata))))
(defun EL:TemplateMatches (value option kind)
  (or (equal (EL:TemplateKey value) (EL:TemplateKey (EL:OptionLabel option)))
    ;; Only the fixed circuit template calls this with this business kind.
    (and (equal kind "回路类型") (equal option 'ground) (equal value "埋地"))))
(defun EL:TemplateMatchingValues (values option kind)
  (EL:Unique (vl-remove-if-not '(lambda (v) (EL:TemplateMatches v option kind)) values)))
(defun EL:TemplateChoose (title labels / i label index done)
  (princ (strcat "\n" title)) (setq i 0)
  (foreach label labels (setq i (1+ i)) (princ (strcat "\n  " (itoa i) ". " label)))
  (while (not done)
    (setq index (getint (if (= (length labels) 1)
      "\n仅剩上述状态，但含义仍需核对。输入 1 确认对应（回车取消本次模板设置）："
      (strcat "\n请输入选项前的数字 1-" (itoa (length labels)) "（回车取消本次模板设置）："))))
    (cond
      ((not index) (princ "\n已取消本次模板设置，原模板保持不变。") (setq done T))
      ((and (> index 0) (<= index (length labels))) (setq done T))
      (T (princ "\n数字超出范围，请按上面的编号重新选择。")))) index)
(defun EL:TemplatePropertyText (prop / textdata value)
  (setq textdata (strcat (vla-get-PropertyName prop) "（可选状态："))
  (foreach value (EL:AllowedValues prop) (setq textdata (strcat textdata (EL:TemplateValueText value) "；")))
  (strcat textdata "）"))
(defun EL:TemplateProperty (props options kind / eligible exact prop values choices index)
  (foreach prop props
    (if (and (= (vla-get-ReadOnly prop) :vlax-false)
        (EL:TemplateValuesValid (setq values (EL:AllowedValues prop))))
      (progn
        (setq eligible (cons prop eligible))
        (if (vl-every '(lambda (o) (= (length (EL:TemplateMatchingValues values o kind)) 1)) options)
          (setq exact (cons prop exact))))))
  (setq choices (reverse (if exact exact eligible)))
  (cond
    ((not choices) (princ (strcat "\n这个图块没有找到可修改且至少有三种状态的选项，无法设置" kind "。")) nil)
    ((= (length choices) 1) (car choices))
    (T (setq index (EL:TemplateChoose (strcat "这个图块有多个选项。哪一项控制" kind "？")
        (mapcar 'EL:TemplatePropertyText choices)))
      (if index (nth (1- index) choices)))))
(defun EL:TemplateStates (values options annotation kind / remaining reserved used option other label available matches index value states contour cancelled)
  ;; Reserve exact names before manual choices so they cannot be assigned twice.
  (setq remaining options contour (EL:BoundsSegments '((-100.0 -100.0 0.0) (100.0 100.0 0.0))))
  (while (and remaining (not cancelled))
    (setq option (car remaining) remaining (cdr remaining) label (EL:OptionLabel option) value nil)
    (setq matches (EL:TemplateMatchingValues values option kind))
    (if (= (length matches) 1) (setq value (car matches))
      (progn
        (setq reserved nil)
        (foreach other options
          (if (not (equal other option))
            (setq reserved (append reserved (EL:TemplateMatchingValues values other kind)))))
        (setq available (EL:Unique (vl-remove-if '(lambda (v) (or (member v used) (member v reserved))) values)))
        (setq index (EL:TemplateChoose (strcat kind "“" label "”对应下面哪种状态？已分配的状态不再列出。")
          (mapcar 'EL:TemplateValueText available)))
        (if index (setq value (nth (1- index) available)) (setq cancelled T))))
    (if (not cancelled)
      (progn
        (setq used (cons value used))
        (princ (strcat "\n已对应：" kind " " label " = 图块状态“" (EL:TemplateValueText value) "”"))
        ;; Preview bounds only; the source block is never modified during capture.
        (setq states (cons (list (cons 'option option) (cons 'value value)
          (cons 'connection (if annotation '(0.0 0.0 0.0) '(6427.0 -5500.0 0.0)))
          (cons 'contour contour) (cons 'text annotation)) states)))))
  (if (not cancelled) (reverse states)))
(defun EL:FixedCapture (name options annotation / pick e obj prop states kind)
  (setq kind (if annotation "回路类型" "箱体容量")
    pick (EL:PickEntity (strcat "\n拾取" (if annotation "回路" "箱体") "动态块样本（" name "）：")))
  (cond
    ((not pick) (princ "\n已取消样本拾取，原模板保持不变。") nil)
    ((not (and (equal (cdr (assoc 0 (entget (car pick)))) "INSERT") (equal (EL:EffectiveName (car pick)) name)))
      (princ (strcat "\n样本不匹配，请选择指定的" (if annotation "回路" "箱体") "图块：" name)) nil)
    (T
      (setq e (car pick) obj (vlax-ename->vla-object e))
      (if (/= (vla-get-IsDynamicBlock obj) :vlax-true)
        (progn (princ "\n所选图块不是动态块，无法设置显示状态。") nil)
        (if (setq prop (EL:TemplateProperty (vlax-invoke obj 'GetDynamicBlockProperties) options kind))
          (progn
            (princ (strcat "\n使用“" (vla-get-PropertyName prop) "”设置" kind "。名称一致的状态自动对应。"))
            (if (setq states (EL:TemplateStates (EL:AllowedValues prop) options annotation kind))
              (list (cons 'name name) (cons 'property (vla-get-PropertyName prop))
                (cons 'source-handle (cdr (assoc 5 (entget e))))
                (cons 'definition (EL:Signature (EL:DefinitionData name nil))) (cons 'states states)))))))))
(defun EL:FixedOutputs (circuits / out c)
  (foreach c circuits
    (setq out (cons (list (cons 'circuit-id (EL:Get 'id c)) (cons 'label (EL:Get 'id c))
      (cons 'mode (if (EL:Get 'is-ground c) 'ground 'normal))) out)))
  (append (reverse out) '(((label . "reserve-1") (mode . reserve)) ((label . "reserve-2") (mode . reserve)))))
(defun EL:FixedPlan (result template capacity origin rotation scale / plan rows row i c spec position)
  (if (and (EL:FixedTemplate template) (EL:Get 'circuits result))
    (progn
      (setq plan (EL:BuildGenerationPlan result template capacity (EL:FixedOutputs (EL:Get 'circuits result)) origin rotation scale) i 0)
      (foreach row (EL:Get 'rows plan)
        (setq c (EL:By 'id (EL:Get 'circuit-id row) (EL:Get 'circuits result))
              position (EL:LocalPoint (list 6427.0 (- -5500.0 (* 1200.0 i)) 0.0) origin rotation scale)
              spec (EL:Put 'offset '(10636.0 -438.0 0.0) (EL:Get 'annotation row))
              row (EL:Put 'position position (EL:Put 'annotation spec row))
              row (EL:Put 'text-position (if c (EL:LocalPoint '(10636.0 -438.0 0.0) position rotation scale)) row)
              row (EL:Put 'text (if c (strcat (itoa (EL:Get 'watts c)) "W")) row)
              row (EL:Put 'circuit-uid (if c (EL:Get 'circuit-uid c) (EL:Get 'label row)) row)
              rows (cons row rows) i (1+ i)))
      (if plan (EL:Put 'rows (reverse rows) plan)))))
(defun EL:CaptureFixedTemplate (cfg / annotation panel circuit template pick data height)
  (if (setq annotation (EL:FixedText))
    (progn
      (princ "\n设置系统图模板：依次选择箱体和回路样本，名称一致的状态自动对应。单位固定 mm。")
      (setq pick (EL:PickEntity "\n可拾取 TEXT 外观样本，Enter 使用当前文字样式："))
      (if pick
        (progn
          (setq data (entget (car pick)))
          (if (equal (cdr (assoc 0 data)) "TEXT")
            (progn
              (setq height (cdr (assoc 40 (tblsearch "STYLE" (cdr (assoc 7 data))))))
              (setq annotation (EL:Put 'style (cdr (assoc 7 data))
                (EL:Put 'height (if (> height 0.0) height (cdr (assoc 40 data)))
                  (EL:Put 'factor (cdr (assoc 41 data)) annotation)))))
            (setq annotation nil))))
      (if annotation (setq panel (EL:FixedCapture "dfgjhdrtyjtfgj4SADFG3" '(cap300 cap600 cap1000) nil)))
      (if panel (setq circuit (EL:FixedCapture "fghjftyuk" '(normal ground reserve) annotation)))
      (setq template (list (cons 'panel panel) (cons 'circuit circuit) '(step 0.0 -1200.0 0.0)
        '(actual-format . "{回路功率W}W") '(reserve-format . "预留") '(layer . "EL-SYSTEM")))
      (cond
        ((not (and panel circuit)) (princ "\n本次模板设置未完成，原模板保持不变。") nil)
        ((not (EL:TemplateRuntimeValid template cfg))
          (princ "\n模板校验未通过，未保存。请核对样本状态、文字样式及输出图层是否可用。") nil)
        (T template)))))
(defun EL:TemplateReady (template cfg / checked)
  (if (EL:FixedTemplate template)
    (progn (setq checked (vl-catch-all-apply 'EL:TemplateRuntimeValid (list template cfg)))
      (and (not (vl-catch-all-error-p checked)) checked))))
(defun c:ELTEMPLATE (/ *error* cfg template)
  (defun *error* (msg) (EL:ClearPickHighlights) (if msg (princ msg)) (princ))
  (if (and (setq cfg (EL:LoadConfig)) (setq template (EL:CaptureFixedTemplate cfg)))
    (if (EL:SaveConfig (EL:Put 'template template cfg))
          (princ "\n模板设置已保存：箱体容量和回路类型已对应。生成时请核对实际图形。")
      (princ "\n模板配置写入失败，未完成保存；请检查配置目录是否可写。")))
  (EL:ClearPickHighlights) (princ))
