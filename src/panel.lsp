;; Date: 2026-10-09. Native slide capture happens only outside modal dialogs.
(defun EL:ThumbSlideCommand (path)
  (command-s "_.MSLIDE" path))
(defun EL:ThumbCapture (block / path checked zoomed filedia echo screen)
  (setq path (vl-filename-mktemp "el-device-" nil ".sld")
    filedia (getvar "FILEDIA") echo (getvar "CMDECHO") screen (getvar "SCREENSIZE"))
  ;; Register immediately so error handlers can remove even partial files.
  (setq *EL:ThumbSlides* (cons path *EL:ThumbSlides*))
  (setq checked (vl-catch-all-apply 'EL:SimpleZoom (list (car (EL:Get 'bounds block)) (cadr (EL:Get 'bounds block)))))
  (if (not (vl-catch-all-error-p checked))
    (progn
      (setq zoomed T)
      (setvar "FILEDIA" 0) (setvar "CMDECHO" 0)
      (setq checked (vl-catch-all-apply 'EL:ThumbSlideCommand (list path)))))
  (setvar "FILEDIA" filedia) (setvar "CMDECHO" echo)
  (if zoomed (vl-catch-all-apply 'vla-ZoomPrevious (list (vlax-get-acad-object))))
  (if (and (not (vl-catch-all-error-p checked)) (findfile path)) (list path screen)))
(defun EL:ThumbCleanup (/ path)
  (foreach path *EL:ThumbSlides* (vl-catch-all-apply 'vl-file-delete (list path)))
  (setq *EL:ThumbSlides* nil))
(defun EL:ThumbPrepare (result / ids circuit row block geometry)
  (EL:ThumbCleanup)
  (EL:ClearGapPreview) (EL:ClearPickHighlights)
  (foreach circuit (EL:Get 'circuits result) (setq ids (append ids (EL:Get 'devices circuit))))
  (foreach row (EL:SimpleRows (vl-remove-if-not '(lambda (b) (member (EL:Get 'id b) ids))
      (EL:Get 'blocks (EL:Get 'snapshot result))) nil)
    (setq block (EL:By 'id (car (EL:Get 'ids row)) (EL:Get 'blocks (EL:Get 'snapshot result)))
      geometry (vl-catch-all-apply 'EL:ThumbCapture (list block)))
    (if (vl-catch-all-error-p geometry) (setq geometry nil))
    (setq *EL:ThumbCache* (cons (cons (EL:Get 'name row) geometry) *EL:ThumbCache*))))
(defun EL:ThumbDraw (key geometry / w h screen scale sw sh)
  (setq w (dimx_tile key) h (dimy_tile key))
  (start_image key) (fill_image 0 0 w h 0)
  (if (and geometry (findfile (car geometry)))
    (progn
      (setq screen (cadr geometry) scale (min (/ (float w) (car screen)) (/ (float h) (cadr screen)))
        sw (max 1 (fix (* scale (car screen)))) sh (max 1 (fix (* scale (cadr screen)))))
      (vl-catch-all-apply 'slide_image (list (fix (/ (- w sw) 2)) (fix (/ (- h sh) 2)) sw sh (car geometry)))))
  (end_image))
;; Date: 2026-10-10. Main table shows images only; legacy review keeps captions.
(defun EL:ThumbFill () (EL:ThumbFillRows T))
(defun EL:ThumbFillRows (captions / i row key geometry)
  (setq i 0)
  (repeat 4
    (setq key (itoa i) row (nth (+ *EL:ThumbPage* i) *EL:ThumbRows*) geometry nil)
    (if row (setq geometry (cdr (assoc (EL:Get 'name row) *EL:ThumbCache*))))
    (EL:ThumbDraw (strcat "f_image" key) geometry)
    (if captions (progn
    (set_tile (strcat "f_count" key) (if row (strcat "数量：" (itoa (EL:Get 'count row))) ""))
    (set_tile (strcat "f_hint" key) (cond ((not row) "") ((not (car geometry)) "预览失败，点击在图面查看")
      (T "图面实景，点击放大")))))
    (setq i (1+ i)))
  (set_tile "f_page" (strcat (itoa (1+ (fix (/ *EL:ThumbPage* 4)))) " / "
    (itoa (max 1 (fix (/ (+ (length *EL:ThumbRows*) 3) 4))))))
  (mode_tile "f_prev" (if (> *EL:ThumbPage* 0) 0 1))
  (mode_tile "f_next" (if (< (+ *EL:ThumbPage* 4) (length *EL:ThumbRows*)) 0 1)))
(defun EL:ThumbPage (delta)
  (setq *EL:ThumbPage* (max 0 (min (+ *EL:ThumbPage* delta)
    (* 4 (fix (/ (max 0 (1- (length *EL:ThumbRows*))) 4))))))
  (EL:ThumbFill))
(defun EL:ThumbActions (/ i key)
  (setq i 0)
  (repeat 4
    (setq key (itoa i))
    (action_tile (strcat "f_image" key) (strcat "(EL:ThumbRequest " key ")"))
    (setq i (1+ i)))
  (action_tile "f_prev" "(EL:ThumbPage -4)")
  (action_tile "f_next" "(EL:ThumbPage 4)"))
;; Date: 2026-10-09. Draft-only paged circuit table with real per-row toggles.
(defun EL:ThumbRequest (index)
  (if (setq *EL:ThumbLocate* (nth (+ *EL:ThumbPage* index) *EL:ThumbRows*))
    (if (or (not *EL:PanelDraft*) (EL:PanelStore)) (done_dialog 6))))
(defun EL:ThumbLocateWait ()
  (EL:SimpleLocate (list (cons 'devices (EL:Get 'blocks *EL:ExitSnapshot*))) *EL:ThumbLocate*)
  (getstring "\n按 Enter 返回功率面板："))
(defun EL:ThumbLocatePreview (/ checked)
  (setq checked (vl-catch-all-apply 'EL:ThumbLocateWait nil))
  (EL:ClearGapPreview) (EL:ClearPickHighlights)
  (if (vl-catch-all-error-p checked) (princ "\n已停止设备预览，返回面板，功率保留。")))
(defun EL:CircuitSnapshot (snapshot panel / blocks b)
  (foreach b (EL:Get 'blocks snapshot)
    (setq blocks (cons (EL:Put 'identity (list (EL:Get 'name b) nil "block-name-v1")
      (EL:Put 'role (if (equal (EL:Get 'id b) panel) 'panel 'device) b)) blocks)))
  (EL:Put 'signature (EL:LogCall "SNAPSHOT_SIGNATURE" nil 'EL:Signature (list snapshot)) (EL:Put 'blocks (reverse blocks) snapshot)))
(defun EL:SplitNetwork (network cfg / snapshot panel edges seeds wire block i circuits result)
  (setq snapshot (EL:CircuitSnapshot (EL:Get 'snapshot network) (EL:Get 'panel network))
        panel (EL:Get 'panel network) block (EL:By 'id panel (EL:Get 'blocks snapshot)) i 0)
  (foreach wire (vl-sort (EL:Get 'wires snapshot) '(lambda (a b) (< (EL:Get 'id a) (EL:Get 'id b))))
    (if (EL:PathBlockHit wire block cfg)
      (progn (setq i (1+ i))
        (setq seeds (cons (list (cons 'id (strcat "R" (itoa i))) (cons 'wire (EL:Get 'id wire))
          (cons 'key (list (EL:Get 'id wire) 'outlet))) seeds)))))
  (setq edges (vl-remove-if '(lambda (e) (member panel e)) (EL:Get 'edges network)))
  (foreach wire (reverse seeds)
    (setq circuits (cons (EL:TraceCircuit wire snapshot edges (EL:Get 'gap-issues network)) circuits)))
  (list (cons 'panel panel) (cons 'drawing (EL:Get 'drawing snapshot)) (cons 'snapshot snapshot)
    (cons 'rules (EL:RecognitionRules cfg)) (cons 'circuits (reverse circuits))
    (cons 'complete (and circuits (not (EL:Get 'issues snapshot))
      (vl-every '(lambda (c) (EL:Get 'complete c)) circuits))) (cons 'engine 'fixed)))
(defun EL:NamePowerRecords (result powers / records b w)
  (foreach b (EL:Get 'blocks (EL:Get 'snapshot result))
    (setq w (EL:Get (strcase (EL:Get 'name b)) powers))
    (if (numberp w)
      (setq records (cons (list (cons 'identity (EL:Get 'identity b)) '(category . other)
        (cons 'display (EL:Get 'name b)) (cons 'watts w) '(zero-confirmed . T)) records)))) records)
(defun EL:SelectFixedExits (result excluded / circuits keys)
  (setq keys (mapcar '(lambda (c) (EL:Get 'key (EL:Get 'seed c))) (EL:Get 'circuits result))
    circuits (vl-remove-if '(lambda (c) (member (EL:Get 'key (EL:Get 'seed c)) excluded)) (EL:Get 'circuits result)))
  (EL:Put 'candidate-keys keys (EL:Put 'excluded-seeds excluded (EL:Put 'circuits circuits
    (EL:Put 'complete (and circuits (not (EL:Get 'issues (EL:Get 'snapshot result)))
      (vl-every '(lambda (c) (EL:Get 'complete c)) circuits)) result)))))
(defun EL:FixedExitDevices (/ indices ids i c rows row)
  ;; Show recognition already completed before exit confirmation. Counts are
  ;; unique block instances even when conflicting candidates share devices.
  (setq indices (read (strcat "(" *EL:FixedExitSelection* ")")))
  (foreach i indices
    (setq c (nth i (EL:Get 'circuits *EL:FixedExitResult*)) ids (append (EL:Get 'devices c) ids)))
  (setq ids (EL:Unique ids) rows (EL:SimpleRows
    (vl-remove-if-not '(lambda (b) (member (EL:Get 'id b) ids)) (EL:Get 'blocks *EL:ExitSnapshot*)) nil))
  (setq *EL:ThumbRows* rows *EL:ThumbPage* 0)
  (EL:ThumbFill)
  (set_tile "f_status" (cond
    ((not indices) "尚未选择出线，请选择实际回路。")
    ((not ids) "所选出线未识别到设备，请核对连接。")
    (T (strcat "所选出线已识别 " (itoa (length ids)) " 个设备，右侧填写功率。")))))
(defun EL:FixedExitHighlight (result value / snapshot indices index circuit wires devices id wire block bounds lo hi seg pad)
  ;; Date: 2026-10-09. Preview the traced circuit, not only its outlet seed.
  (EL:ClearGapPreview) (EL:ClearPickHighlights)
  (setq snapshot (EL:Get 'snapshot result) indices (read (strcat "(" value ")")))
  (foreach index indices
    (setq circuit (nth index (EL:Get 'circuits result))
      wires (append (EL:Get 'wires circuit) wires) devices (append (EL:Get 'devices circuit) devices)))
  (setq wires (EL:Unique wires) devices (EL:Unique devices))
  (foreach id (append wires devices)
    (setq wire (EL:By 'id id (EL:Get 'wires snapshot)) block (EL:By 'id id (EL:Get 'blocks snapshot))
      bounds (if wire (EL:SegmentBounds (EL:Get 'segments wire)) (EL:Get 'bounds block)))
    (if bounds (setq lo (if lo (mapcar 'min lo (car bounds)) (car bounds))
      hi (if hi (mapcar 'max hi (cadr bounds)) (cadr bounds)))))
  ;; Zoom first: a later zoom would erase the transient overlay.
  (if lo (vl-catch-all-apply 'EL:SimpleZoom (list lo hi)))
  (setq pad (/ (getvar "VIEWSIZE") 150.0))
  (foreach id wires
    (EL:LocateID id)
    (foreach seg (EL:Get 'segments (EL:By 'id id (EL:Get 'wires snapshot)))
      (EL:DrawTransient (car seg) (cadr seg) 2)))
  (foreach id devices
    (EL:LocateID id)
    (setq bounds (EL:Get 'bounds (EL:By 'id id (EL:Get 'blocks snapshot))))
    (if bounds
      (foreach seg (EL:BoundsSegments (EL:ExpandedBlockBounds bounds pad))
        (EL:DrawTransient (car seg) (cadr seg) 4))))
  (princ (if indices (strcat "\n黄色：所选回路导线 " (itoa (length wires))
    " 条；青色框：已识别设备 " (itoa (length devices)) " 个。按当前识别范围显示，待核对回路可能不完整。")
    "\n未选择出线，没有可预览的回路。")))
;; Date: 2026-10-10. Independent display copies preserve source/block colors.
(defun EL:CircuitColor (index)
  (nth (fix (rem index 24)) '(1 3 5 6 2 4 30 140 210 80 10 170 40 150 220 90 20 180 50 160 230 100 60 190)))
(defun EL:ColorPreviewCleanup (/ item checked pending)
  (foreach item *EL:ColorPreviewCopies*
    (setq checked (vl-catch-all-apply 'vla-Delete (list item)))
    (if (vl-catch-all-error-p checked) (setq pending (cons item pending))))
  (setq *EL:ColorPreviewCopies* pending pending nil)
  (foreach item *EL:ColorPreviewSources*
    (setq checked (vl-catch-all-apply 'vla-put-Visible (list (car item) (cadr item))))
    (if (vl-catch-all-error-p checked) (setq pending (cons item pending))))
  (setq *EL:ColorPreviewSources* pending)
  (redraw)
  (not (or *EL:ColorPreviewCopies* *EL:ColorPreviewSources*)))
(defun EL:ColorPreviewShape (object color depth / children child)
  (EL:Require (< depth 32) "设备嵌套过深，已停止着色预览。")
  (vla-put-Layer object "0")
  (vla-put-Visible object :vlax-true)
  (if (equal (vla-get-ObjectName object) "AcDbBlockReference")
    (progn
      (setq children (vlax-safearray->list (vlax-variant-value (vla-Explode object))))
      ;; Register every child before touching any of them, including on failure.
      (setq *EL:ColorPreviewCopies* (append children *EL:ColorPreviewCopies*))
      (EL:Require children "设备图块无法展开显示，已停止着色预览。")
      (foreach child children (EL:ColorPreviewShape child color (1+ depth)))
      (vla-Delete object)
      (setq *EL:ColorPreviewCopies* (vl-remove object *EL:ColorPreviewCopies*)))
    (vla-put-Color object color)))
(defun EL:ColorPreviewEntity (id color / entity object copy)
  (EL:Require (setq entity (handent id)) "回路对象已删除，请重新统计。")
  (setq object (vlax-ename->vla-object entity) copy (vla-Copy object))
  (setq *EL:ColorPreviewCopies* (cons copy *EL:ColorPreviewCopies*))
  (EL:ColorPreviewShape copy color 0)
  (setq *EL:ColorPreviewSources* (cons (list object (vla-get-Visible object)) *EL:ColorPreviewSources*))
  (vla-put-Visible object :vlax-false))
(defun EL:AllCircuitColorWait (result / circuit index ids id seen snapshot wire block bounds lo hi)
  (EL:Require (EL:ColorPreviewCleanup) "上次预览尚未清理完成，请运行 ELCOLORRESET。")
  (EL:ClearGapPreview) (EL:ClearPickHighlights)
  ;; Shared objects have no unambiguous circuit color: reject before any writes.
  (EL:Require (<= (length (EL:Get 'circuits result)) 24) "当前分色支持最多 24 条回路。")
  (foreach circuit (EL:Get 'circuits result)
    (setq ids (EL:Unique (append (EL:Get 'wires circuit) (EL:Get 'devices circuit))))
    (foreach id ids
      (EL:Require (not (member id seen)) "发现多回路共用对象，请先核对连接。")
      (setq seen (cons id seen))))
  (setq snapshot (EL:Get 'snapshot result))
  (foreach id seen
    (setq wire (EL:By 'id id (EL:Get 'wires snapshot)) block (EL:By 'id id (EL:Get 'blocks snapshot))
      bounds (if wire (EL:SegmentBounds (EL:Get 'segments wire)) (EL:Get 'bounds block)))
    (if bounds (setq lo (if lo (mapcar 'min lo (car bounds)) (car bounds))
      hi (if hi (mapcar 'max hi (cadr bounds)) (cadr bounds)))))
  (if lo (EL:SimpleZoom lo hi))
  (setq index 0)
  (foreach circuit (EL:Get 'circuits result)
    (foreach id (EL:Unique (append (EL:Get 'wires circuit) (EL:Get 'devices circuit)))
      (EL:ColorPreviewEntity id (EL:CircuitColor index)))
    (princ (strcat "\n回路 " (itoa (1+ index)) "：颜色 " (itoa (EL:CircuitColor index))))
    (setq index (1+ index)))
  (redraw)
  (getstring "\n同回路导线和设备同色；按 Enter 或 Esc 恢复原图并返回面板："))
(defun EL:AllCircuitColorPreview (result / checked document clean ended)
  ;; One undo group prevents stepping through a half-restored preview.
  (setq document (vla-get-ActiveDocument (vlax-get-acad-object)))
  (vla-StartUndoMark document)
  (setq checked (vl-catch-all-apply 'EL:AllCircuitColorWait (list result)))
  (setq clean (EL:ColorPreviewCleanup)
    ended (vl-catch-all-apply 'vla-EndUndoMark (list document)))
  (if (not clean)
    (EL:Require nil "预览清理未完成，请运行 ELCOLORRESET 重试，清理前不要保存图纸。"))
  (if (vl-catch-all-error-p ended) (EL:Require nil "预览撤销组未能结束，请检查 CAD 命令状态。"))
  (if (vl-catch-all-error-p checked)
    (princ (strcat "\n已结束回路分色预览：" (vl-catch-all-error-message checked)))))
(defun c:ELCOLORRESET ()
  (princ (if (EL:ColorPreviewCleanup) "\n回路分色预览已清理。" "\n仍有对象未能恢复，请检查图层锁定状态后重试。")) (princ))
(defun EL:FixedExitPreviewWait (result value)
  (EL:FixedExitHighlight result value)
  (getstring "\n按 Enter 返回出线核对："))
(defun EL:FixedExitPreview (result value / checked)
  ;; ESC must clear both transient paths and entity highlights before unwinding.
  (setq checked (vl-catch-all-apply 'EL:FixedExitPreviewWait (list result value)))
  (EL:ClearGapPreview) (EL:ClearPickHighlights)
  (if (vl-catch-all-error-p checked)
    (EL:Require nil (strcat "回路预览已停止：" (vl-catch-all-error-message checked)))))
(defun EL:ReviewFixedExits (result record / dialog status c i selected excluded keys *EL:ExitRows* *EL:ExitSnapshot* *EL:FixedExitSelection* *EL:FixedExitResult* *EL:ThumbRows* *EL:ThumbPage* *EL:ThumbCache* *EL:ThumbLocate* *EL:PanelDraft*)
  (setq keys (EL:Get 'candidate-keys result))
  (if (equal keys (EL:Get 'candidate-keys record)) (EL:SelectFixedExits result (EL:Get 'excluded-seeds record))
    (progn
      (setq dialog (load_dialog (strcat *EL:Root* "ui/power.dcl")) *EL:DialogID* dialog status 2
        *EL:ExitRows* (mapcar '(lambda (c) (EL:Get 'seed c)) (EL:Get 'circuits result))
        *EL:ExitSnapshot* (EL:Get 'snapshot result) *EL:FixedExitResult* result i 0 *EL:FixedExitSelection* "")
      (foreach c *EL:ExitRows*
        (if (not (member (EL:Get 'key c) (EL:Get 'excluded-seeds record)))
          (setq *EL:FixedExitSelection* (strcat *EL:FixedExitSelection* (itoa i) " ")))
        (setq i (1+ i)))
      (EL:ThumbPrepare result)
      (while (and (> dialog 0) (= status 2))
        (if (new_dialog "el_fixed_exits" dialog)
          (progn
            (start_list "f_exits")
            (foreach c (EL:Get 'circuits result)
              (add_list (strcat (EL:Get 'id c) " / 导线 " (EL:Get 'wire (EL:Get 'seed c))
                " / 已识别设备 " (itoa (length (EL:Get 'devices c))) " 个"
                (if (EL:Get 'complete c) "" " / 连接待核对")))) (end_list)
            (set_tile "f_exits" *EL:FixedExitSelection*)
            (EL:FixedExitDevices) (EL:ThumbActions)
            (action_tile "f_exits" "(setq *EL:FixedExitSelection* $value) (EL:FixedExitDevices)")
            (action_tile "f_preview" "(done_dialog 2)")
            (action_tile "accept" "(done_dialog 1)") (action_tile "cancel" "(done_dialog 0)")
            (setq status (start_dialog))
            (if (= status 6) (progn (EL:ThumbLocatePreview) (setq status 2))
              (if (= status 2) (EL:FixedExitPreview result *EL:FixedExitSelection*))))
          (setq status 0)))
      (EL:ThumbCleanup)
      (if (> dialog 0) (unload_dialog dialog)) (setq *EL:DialogID* nil)
      (if (= status 1)
        (progn
          (setq selected (mapcar '(lambda (index) (EL:Get 'key (nth index *EL:ExitRows*)))
            (read (strcat "(" *EL:FixedExitSelection* ")"))))
          (setq excluded (vl-remove-if '(lambda (key) (member key selected)) keys))
          (EL:SelectFixedExits result excluded))))))
(defun EL:PanelCompute (result powers cfg)
  (EL:BoxStatistics result (EL:Put 'powers (EL:NamePowerRecords result powers) cfg) nil nil))
(defun EL:MatchCircuits (circuits saved prefix / out old c key seen next removed added)
  (setq next 1)
  (foreach old saved (if (numberp (EL:Get 'output-order old)) (setq next (max next (1+ (EL:Get 'output-order old))))))
  (foreach c circuits
    (setq key (EL:Get 'key (EL:Get 'seed c)) old (EL:By 'seed-key key saved))
    (if (or (not key) (member key seen)) (setq key nil))
    (if key
      (progn
        (setq seen (cons key seen))
        (if (not old)
          (progn
            (while (EL:By 'circuit-uid (strcat prefix "/" (EL:Signature key) "/" (itoa next)) saved) (setq next (1+ next)))
            (setq old (list (cons 'circuit-uid (strcat prefix "/" (EL:Signature key) "/" (itoa next)))
              (cons 'output-order next) '(is-ground) '(ground-source . default))
              next (1+ next) added T)))
        (foreach key '(circuit-uid output-order is-ground ground-source ground-rule ground-evidence)
          (setq c (EL:Put key (EL:Get key old) c)))
        (setq c (EL:Put 'seed-key (EL:Get 'key (EL:Get 'seed c)) c) out (cons c out)))
      (setq out (cons (EL:Put 'identity-error T c) out))))
  (setq removed (vl-remove-if '(lambda (r) (member (EL:Get 'seed-key r) seen)) saved))
  (list (cons 'circuits (vl-sort out '(lambda (a b) (< (cond ((EL:Get 'output-order a)) (T 0))
    (cond ((EL:Get 'output-order b)) (T 0)))))) (cons 'removed removed) (cons 'added added)
    (cons 'ambiguous (or removed (vl-some '(lambda (c) (EL:Get 'identity-error c)) out)))))
(defun EL:GroundSuggestion (circuit names version blocks / hits id b)
  ;; No configured names => no inference. Explicit manual yes AND no win.
  (if (equal (EL:Get 'ground-source circuit) 'manual) circuit
    (progn
      (if (and names (EL:Get 'complete circuit))
        (foreach id (EL:Get 'devices circuit)
          (setq b (EL:By 'id id blocks))
          (if (member (EL:Get 'name b) names) (setq hits (cons id hits)))))
      (EL:Put 'is-ground (if hits T nil) (EL:Put 'ground-source (if names 'auto-rule 'default)
        (EL:Put 'ground-rule version (EL:Put 'ground-evidence hits circuit)))))))
(defun EL:PanelDevices (/ circuit)
  (setq circuit (nth *EL:PanelIndex* (EL:Get 'circuits *EL:PanelDraft*)))
  (EL:SimpleRows (vl-remove-if-not '(lambda (b) (member (EL:Get 'id b) (EL:Get 'devices circuit)))
    (EL:Get 'blocks (EL:Get 'snapshot *EL:PanelDraft*))) *EL:PanelPowers*))
;; Date: 2026-10-10. Status: implemented; per-name block table edits.
(defun EL:PanelBlockRows (/ ids c)
  (foreach c (EL:Get 'circuits *EL:PanelDraft*) (setq ids (append ids (EL:Get 'devices c))))
  (EL:SimpleRows (vl-remove-if-not '(lambda (b) (member (EL:Get 'id b) ids))
    (EL:Get 'blocks (EL:Get 'snapshot *EL:PanelDraft*))) *EL:PanelPowers*))
(defun EL:PanelBlockFill (/ i row key)
  (setq *EL:ThumbRows* (EL:PanelBlockRows))
  (EL:ThumbFillRows nil)
  (setq i 0)
  (repeat 4
    (setq key (itoa i) row (nth (+ *EL:ThumbPage* i) *EL:ThumbRows*))
    (set_tile (strcat "b_watts" key) (if (numberp (EL:Get 'watts row)) (itoa (EL:Get 'watts row)) ""))
    (set_tile (strcat "b_ground" key) (if (EL:Get (EL:Get 'key row) (EL:Get 'block-ground *EL:PanelDraft*)) "1" "0"))
    (mode_tile (strcat "b_watts" key) (if row 0 1))
    (mode_tile (strcat "b_ground" key) (if row 0 1))
    (mode_tile (strcat "f_image" key) (if row 0 1))
    (setq i (1+ i))))
(defun EL:PanelBlockGroundApply (/ cs c id block hits settings)
  (setq settings (EL:Get 'block-ground *EL:PanelDraft*))
  (foreach c (EL:Get 'circuits *EL:PanelDraft*)
    (setq hits nil)
    (foreach id (EL:Get 'devices c)
      (setq block (EL:By 'id id (EL:Get 'blocks (EL:Get 'snapshot *EL:PanelDraft*))))
      (if (EL:Get (strcase (EL:Get 'name block)) settings) (setq hits (cons id hits))))
    (setq cs (cons (EL:Put 'ground-evidence hits (EL:Put 'ground-rule 'block-table
      (EL:Put 'ground-source 'manual (EL:Put 'is-ground (if hits T nil) c)))) cs)))
  (setq *EL:PanelDraft* (EL:Put 'circuits (reverse cs) *EL:PanelDraft*)))
(defun EL:PanelStore (/ rows row value watts i bad pending)
  (setq rows (EL:PanelBlockRows) i 0 pending *EL:PanelPowers*)
  (repeat 4
    (setq row (nth (+ *EL:ThumbPage* i) rows))
    (if row
      (progn
        (setq value (get_tile (strcat "b_watts" (itoa i))) watts (EL:ParseWatts value))
        (if (or (equal value "") (numberp watts))
          (setq pending (EL:Put (EL:Get 'key row) watts pending))
          (if (not bad) (setq bad (strcat "b_watts" (itoa i)))))))
    (setq i (1+ i)))
  (if bad
    (progn (set_tile "p_error" "单个功率请输入非负整数 W；请修正后再切换。") (mode_tile bad 2) nil)
    (progn
      (setq *EL:PanelPowers* pending
        *EL:PanelDraft* (EL:PanelCompute *EL:PanelDraft* pending *EL:PanelConfig*)) T)))
(defun EL:PanelBlockGround (index value / row)
  (setq row (nth (+ *EL:ThumbPage* index) (EL:PanelBlockRows)))
  (if row
    (if (EL:PanelStore)
      (progn
        (setq *EL:PanelDraft* (EL:Put 'block-ground
          (EL:Put (EL:Get 'key row) (equal value "1") (EL:Get 'block-ground *EL:PanelDraft*)) *EL:PanelDraft*))
        (EL:PanelBlockGroundApply) (EL:PanelFill))
      (set_tile (strcat "b_ground" (itoa index))
        (if (EL:Get (EL:Get 'key row) (EL:Get 'block-ground *EL:PanelDraft*)) "1" "0")))))
(defun EL:PanelBlockPage (delta)
  (if (EL:PanelStore)
    (progn
      (setq *EL:ThumbPage* (max 0 (min (+ *EL:ThumbPage* delta)
        (* 4 (fix (/ (max 0 (1- (length (EL:PanelBlockRows)))) 4))))))
      (EL:PanelBlockFill))))
(defun EL:CapacityDefault (capacity)
  ;; Date: 2026-10-09. Use 0.3kW immediately; retain a valid saved choice.
  (if (member capacity '(cap300 cap600 cap1000)) capacity 'cap300))
(defun EL:SelectionsReady (result capacity)
  (and (member capacity '(cap300 cap600 cap1000))
    (vl-every '(lambda (c) (equal (EL:Get 'ground-source c) 'manual)) (EL:Get 'circuits result))))
(defun EL:PanelStoreSelections ()
  (if (EL:PanelStore)
    (progn
      (setq *EL:PanelDraft* (EL:Put 'circuits
        (mapcar '(lambda (c) (EL:Put 'ground-source 'manual c)) (EL:Get 'circuits *EL:PanelDraft*)) *EL:PanelDraft*))
      T)))
(defun EL:PanelGenerate ()
  (if (EL:PanelStoreSelections)
    (cond
      ((not (EL:Get 'circuits *EL:PanelDraft*)) (set_tile "p_error" "请至少保留一条实际出线。"))
      ((> (length (EL:Get 'circuits *EL:PanelDraft*)) 8) (set_tile "p_error" "本图块最多容纳8条实际回路，请拆箱后统计；不会截断回路。"))
      ((not (EL:Get 'can-generate *EL:PanelDraft*)) (set_tile "p_error" "识别或功率未通过，不能生成；可保存草稿。"))
      ((not (EL:SelectionsReady *EL:PanelDraft* *EL:PanelCapacity*))
        (set_tile "p_error" "请先选择箱体容量。"))
      (*EL:PanelTemplateReady* (done_dialog 2))
      (T (done_dialog 4)))))
(defun EL:PanelFill (/ cs i c key)
  (setq cs (EL:Get 'circuits *EL:PanelDraft*) i 0)
  (repeat 8
    (setq c (nth (+ *EL:PanelPage* i) cs) key (itoa i))
    (set_tile (strcat "p_row" key)
      ;; Date: 2026-10-10. Display output numbering and watts only.
      (if c (strcat "ZE" (itoa (1+ (+ *EL:PanelPage* i))) " | " (itoa (EL:Get 'watts c)) "W")
        (if (< (+ *EL:PanelPage* i) (EL:FixedOutputCount (length cs)))
          (strcat "预留" (itoa (1+ (- (+ *EL:PanelPage* i) (length cs))))) "")))
    (setq i (1+ i)))
  (EL:PanelBlockFill)
  (set_tile "p_error" (cond
    ((>= *EL:PanelIndex* (length cs)) "预留回路无需设置；右侧图块表仍显示本箱全部设备。")
    ((and (not (assoc 'block-ground *EL:PanelDraft*)) (vl-some '(lambda (c) (EL:Get 'is-ground c)) cs))
      "沿用旧回路地面设置；修改图块地面勾选后按图块统一重算。")
    (T "图块表显示本箱全部设备；含地面图块的回路自动设为地面。")))
  (set_tile "p_total" (strcat (EL:PanelKnownTotal) "；实际回路 " (itoa (length cs)) "；输出 " (itoa (EL:FixedOutputCount (length cs)))
    "；已完整核对回路 " (itoa (EL:Get 'box-watts *EL:PanelDraft*)) " W"))
  (set_tile "p_capacity" (cond ((equal *EL:PanelCapacity* 'cap600) "p_600")
    ((equal *EL:PanelCapacity* 'cap1000) "p_1000") (T "p_300")))
  (set_tile "p_capacity_status" "默认 0.3kW；可按需要调整为 0.6kW 或 1kW。")
  (set_tile "p_template_status" (if *EL:PanelTemplateReady* "模板已验证，生成时自动切换状态。"
    "模板未设置或已变化：点击生成时设置；不影响统计和保存草稿。")))
(defun EL:PanelPowerChanged (/ saved)
  (if (EL:PanelStore)
    (progn
      (EL:PanelFill)
      (setq saved (vl-catch-all-apply 'EL:RememberPanelPowers (list *EL:PanelDraft* *EL:PanelPowers*)))
      (set_tile "p_error" (if (and (not (vl-catch-all-error-p saved)) saved)
        "功率已记住；回路草稿请点保存。" "功率未写入文件，请点保存重试；当前窗口草稿仍保留。")))))
(defun EL:PanelKnownTotal (/ ids circuit rows row total missing overflow watts)
  (foreach circuit (EL:Get 'circuits *EL:PanelDraft*)
    (setq ids (append ids (EL:Get 'devices circuit))))
  (setq ids (EL:Unique ids) total 0 missing 0)
  (setq rows (EL:SimpleRows (vl-remove-if-not '(lambda (b) (member (EL:Get 'id b) ids))
    (EL:Get 'blocks (EL:Get 'snapshot *EL:PanelDraft*))) *EL:PanelPowers*))
  (foreach row rows
    (setq watts (EL:Get 'watts row))
    (if (numberp watts)
      (if (> watts (/ (- 2147483647 total) (EL:Get 'count row))) (setq overflow T)
        (setq total (+ total (* watts (EL:Get 'count row)))))
      (setq missing (+ missing (EL:Get 'count row)))))
  (strcat "已识别设备合计：" (if overflow "超出整数范围" (strcat (itoa total) " W"))
    (if (> missing 0) (strcat "；尚有 " (itoa missing) " 个设备未填功率") "")
    (if (EL:Get 'complete *EL:PanelDraft*) "" "；连接仍待核对")))
(defun EL:PanelGround (index value / cs c)
  (if (EL:PanelStore)
    (progn
      (setq cs (EL:Get 'circuits *EL:PanelDraft*) c (nth index cs))
      (if c (setq *EL:PanelDraft* (EL:Put 'circuits
        (subst (EL:Put 'ground-source 'manual (EL:Put 'is-ground (equal value "1") c)) c cs) *EL:PanelDraft*)))
      (setq *EL:PanelIndex* index *EL:PanelDevice* 0) (EL:PanelFill))
    (set_tile (strcat "p_ground" (itoa (- index *EL:PanelPage*)))
      (if (EL:Get 'is-ground (nth index (EL:Get 'circuits *EL:PanelDraft*))) "1" "0"))))
(defun EL:PanelPage (delta)
  (if (EL:PanelStore)
    (progn (setq *EL:PanelPage* (max 0 (min (+ *EL:PanelPage* delta)
      (* 8 (fix (/ (1- (EL:FixedOutputCount (length (EL:Get 'circuits *EL:PanelDraft*)))) 8)))))) (EL:PanelFill))))
(defun EL:PanelCapacity (value)
  (if (EL:PanelStore)
    (progn
      (setq *EL:PanelCapacity* (cond ((equal value "p_600") 'cap600) ((equal value "p_1000") 'cap1000) (T 'cap300))
        *EL:PanelDraft* (EL:Put 'capacity-source 'manual *EL:PanelDraft*))
      (EL:PanelFill))
    (set_tile "p_capacity" (cond ((equal *EL:PanelCapacity* 'cap600) "p_600")
      ((equal *EL:PanelCapacity* 'cap1000) "p_1000") (T "p_300")))))
(defun EL:PanelAccept ()
  (if (EL:PanelStoreSelections)
    (if (EL:Get 'circuits *EL:PanelDraft*) (done_dialog 1)
      (set_tile "p_error" "请至少保留一条实际出线。"))))
;; Date: 2026-10-10. Saved records stay in this drawing; selection is read-only.
(defun EL:HistoryState (record)
  (cond ((equal (EL:Get 'status record) 'stale) "待更新")
    ((EL:Get 'panel-output-handle record) "已生成") (T "草稿")))
(defun EL:HistorySelect (value / record panel)
  (setq *EL:HistoryIndex* (atoi value) record (nth *EL:HistoryIndex* *EL:HistoryRecords*)
    panel (EL:Get 'source-panel-handle record))
  (set_tile "h_detail" (if record (strcat "箱体标识：" panel " / " (EL:HistoryState record)) "本图暂无保存记录"))
  (mode_tile "h_open" (if (and record (equal (EL:Get 'engine record) 'fixed)
    (handent panel) (not (equal panel (EL:Get 'panel *EL:PanelDraft*)))) 0 1)))
(defun EL:HistoryFill (/ record index selected panel)
  (setq *EL:HistoryRecords* (EL:Get 'diagrams (EL:StoreRead)) index 0 selected 0)
  (start_list "h_records")
  (foreach record *EL:HistoryRecords*
    (setq panel (EL:Get 'source-panel-handle record))
    (if (equal panel (EL:Get 'panel *EL:PanelDraft*)) (setq selected index))
    (add_list (strcat (if (equal panel (EL:Get 'panel *EL:PanelDraft*)) "[当前] " "")
      "配电箱 " panel " | "
      (itoa (length (cond ((EL:Get 'draft-circuits record)) (T (EL:ActualRows record)))))
      " 回路 | " (EL:HistoryState record)))
    (setq index (1+ index)))
  (end_list)
  (set_tile "h_records" (itoa selected))
  (EL:HistorySelect (itoa selected)))
(defun EL:HistoryOpen (/ record panel cfg result)
  ;; Called only after done_dialog: recognition and DWG transactions need CAD context.
  (setq record (nth *EL:HistoryIndex* *EL:HistoryRecords*) panel (EL:Get 'source-panel-handle record)
    cfg (EL:Get 'config record))
  (EL:Require (and record (equal (EL:Get 'engine record) 'fixed) (handent panel))
    "来源配电箱不存在或记录类型不支持，未切换。")
  (setq result (EL:RecognizeFixed cfg panel))
  (EL:Require (EL:Get 'circuits result) "目标配电箱未识别到有效回路，未切换。")
  (EL:Require (EL:FreshResult *EL:PanelDraft* *EL:PanelConfig*)
    "当前平面已变化，请先重新统计；未切换。")
  (EL:Require (EL:RememberPanelPowers *EL:PanelDraft* *EL:PanelPowers*)
    "当前功率缓存写入失败，请检查目录权限；未切换。")
  (EL:Require (EL:SaveDraft (EL:Put 'can-generate nil *EL:PanelDraft*)
    *EL:PanelConfig* *EL:PanelPowers* *EL:PanelCapacity*) "当前草稿保存失败，未切换。")
  (princ "\n当前草稿已保存到本图；系统图需生成或更新，关闭前请保存 DWG。")
  (list (cons 'switch-result result) (cons 'switch-config cfg)))
;; Date: 2026-10-10. All picked circuits enter the panel without exit selection.
(defun EL:PanelDialog (result cfg powers capacity / dialog status i key row captured switched
    *EL:HistoryRecords* *EL:HistoryIndex*
    *EL:PanelDraft* *EL:PanelPowers* *EL:PanelCapacity* *EL:PanelConfig*
    *EL:PanelIndex* *EL:PanelPage* *EL:PanelDevice* *EL:PanelTemplateReady*
    *EL:FixedExitResult* *EL:FixedExitSelection* *EL:ExitSnapshot* *EL:ThumbRows* *EL:ThumbPage* *EL:ThumbCache* *EL:ThumbLocate*)
  (setq *EL:FixedExitResult* result *EL:ExitSnapshot* (EL:Get 'snapshot result)
    *EL:FixedExitSelection* "" *EL:ThumbPage* 0 i 0)
  (foreach row (EL:Get 'circuits result)
    (setq *EL:FixedExitSelection* (strcat *EL:FixedExitSelection* (itoa i) " "))
    (setq i (1+ i)))
  (setq *EL:PanelDraft* (EL:PanelCompute (EL:SelectFixedExits result nil) powers cfg) *EL:PanelPowers* powers
    *EL:PanelCapacity* (EL:CapacityDefault capacity) *EL:PanelConfig* cfg *EL:PanelIndex* 0 *EL:PanelPage* 0 *EL:PanelDevice* 0
    *EL:PanelTemplateReady* (EL:TemplateReady (EL:Get 'template cfg) cfg)
    dialog (load_dialog (strcat *EL:Root* "ui/power.dcl")) *EL:DialogID* dialog status 3)
  (if (not (EL:Get 'capacity-source *EL:PanelDraft*))
    (setq *EL:PanelDraft* (EL:Put 'capacity-source 'default *EL:PanelDraft*)))
  (if (assoc 'block-ground *EL:PanelDraft*) (EL:PanelBlockGroundApply))
  (EL:ThumbPrepare result)
  (while (and (> dialog 0) (= status 3))
    (if (new_dialog "el_panel" dialog)
      (progn
        (EL:LogCall "PANEL_FILL" (list (cons 'panel (EL:Get 'panel result))
          (cons 'circuits (length (EL:Get 'circuits *EL:PanelDraft*)))) 'EL:PanelFill nil) (setq i 0)
        (EL:HistoryFill)
        (action_tile "h_records" "(EL:HistorySelect $value)")
        (action_tile "h_open" "(if (EL:PanelStore) (done_dialog 8))")
        (EL:ThumbActions)
        (action_tile "f_prev" "(EL:PanelBlockPage -4)")
        (action_tile "f_next" "(EL:PanelBlockPage 4)")
        (repeat 4
          (setq key (itoa i))
          (action_tile (strcat "b_watts" key) "(EL:PanelPowerChanged)")
          (action_tile (strcat "b_ground" key) (strcat "(EL:PanelBlockGround " key " $value)"))
          (setq i (1+ i)))
        (setq i 0)
        (action_tile "f_preview" "(if (EL:PanelStore) (done_dialog 5))")
        (action_tile "p_capacity" "(EL:PanelCapacity $value)")
        (action_tile "accept" "(EL:PanelAccept)")
        (action_tile "p_generate" "(EL:PanelGenerate)")
        (action_tile "cancel" "(done_dialog 0)")
        (setq status (start_dialog))
        (if (= status 8)
          (progn
            (setq switched (vl-catch-all-apply 'EL:HistoryOpen nil))
            (if (vl-catch-all-error-p switched)
              (progn (alert (strcat "打开记录未完成：" (vl-catch-all-error-message switched)))
                (setq switched nil status 7)))))
        (if (= status 6) (progn (EL:ThumbLocatePreview) (setq status 7)))
        (if (= status 4)
          (progn
            (princ "\n正在自动查找系统图块并读取状态；缺少图块时会提示拷入。")
            (setq captured (vl-catch-all-apply 'EL:CaptureFixedTemplate (list *EL:PanelConfig*)))
            (EL:ClearPickHighlights)
            (if (and (not (vl-catch-all-error-p captured)) captured)
              (setq *EL:PanelConfig* (EL:Put 'template captured *EL:PanelConfig*)
                *EL:PanelTemplateReady* T status 2)
              (progn (princ "\n模板设置未完成，返回统计面板；当前功率和选择已保留。") (setq status 4)))))
        (if (= status 3)
          (progn
            (setq row (nth *EL:PanelDevice* (EL:PanelDevices)))
            (if row (EL:SimpleLocate (list (cons 'devices (EL:Get 'blocks (EL:Get 'snapshot result)))) row))
            (getstring "\n按 Enter 返回主面板：") (EL:ClearGapPreview)))
        (if (= status 5)
          (progn (EL:AllCircuitColorPreview *EL:PanelDraft*) (setq status 3)))
        (if (member status '(4 7)) (setq status 3)))
      (setq status 0)))
  (EL:ThumbCleanup)
  (if (> dialog 0) (unload_dialog dialog)) (setq *EL:DialogID* nil)
  (if switched switched
    (if (member status '(1 2)) (list (cons 'result *EL:PanelDraft*) (cons 'powers *EL:PanelPowers*)
      (cons 'config *EL:PanelConfig*) (cons 'capacity *EL:PanelCapacity*) (cons 'generate (= status 2))))))
